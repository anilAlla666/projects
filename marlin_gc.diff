+/* Strided device-sample content fingerprint of a weight tensor. elem_bytes = 2
+ * (fp16/bf16). Samples a small in-bounds head chunk via a synchronous DtoH and
+ * folds in (K,N,total) — enough to distinguish two different models occupying
+ * the same reused address. (A same-address, same-shape, byte-identical-head
+ * collision across distinct trained weights is astronomically unlikely.)
+ * Returns 0 on any failure → callers treat 0 as "unknown" → no eviction
+ * (fail-safe: a failed sample never triggers a spurious re-quant). */
+uint64_t weight_fingerprint(const void *w, int K, int N, int elem_bytes) {
+    if (!w || K <= 0 || N <= 0 || !g_api.rt_memcpy) return 0;
+    size_t total = (size_t)K * (size_t)N * (size_t)elem_bytes;
+    if (total == 0) return 0;
+    const size_t CH = 256;
+    size_t n = (total < CH) ? total : CH;
+    unsigned char buf[CH];
+    if (g_api.rt_memcpy(buf, w, n, /*cudaMemcpyDeviceToHost*/ 2) != 0) return 0;
+    uint64_t h = 1469598103934665603ULL;            /* FNV-1a basis */
+    for (size_t i = 0; i < n; ++i) { h ^= buf[i]; h *= 1099511628211ULL; }
+    h ^= (uint64_t)(unsigned)K; h *= 1099511628211ULL;
+    h ^= (uint64_t)(unsigned)N; h *= 1099511628211ULL;
+    h ^= (uint64_t)total;       h *= 1099511628211ULL;
+    return h ? h : 1ULL;                            /* reserve 0 = "unknown" */
