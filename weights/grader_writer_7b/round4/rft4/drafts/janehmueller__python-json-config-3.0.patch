@@ -0,0 +1,18 @@
+from unittest import TestCase
+import pickle
+from python_json_config.config_node import ConfigNode
+
+
+class ConfigNodeTest(TestCase):
+    def setUp(self):
+        self.config_dict = {
+            'key1': 1,
+            'key2': {
+                'key3': 3,
+                'key4': {'key5': 5}
+            }
+        }
+
+    def test_pickle(self):
+        config_node = ConfigNode(self.config_dict)
+        pickled = pickle.dumps(config_node)
+        unpickled = pickle.loads(pickled)
+        self.assertEqual(unpickled, config_node)
