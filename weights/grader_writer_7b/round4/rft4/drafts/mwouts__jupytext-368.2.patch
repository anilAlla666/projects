+import pytest
+import jupytext
+from jupytext.compare import compare
+
+
+@pytest.mark.parametrize("nbfile", ["test.ipynb"])
+def test_write_python_markdown(tmpdir, nbfile):
+    nb = jupytext.read(nbfile)
+    jupytext.write(nb, str(tmpdir.join('test.md')))
+    md = str(tmpdir.join('test.md')).replace('\\', '/')
+    py = str(tmpdir.join('test.py')).replace('\\', '/')
+    compare(jupytext.read(md), jupytext.read(py))
+    compare(jupytext.read(py), jupytext.read(md))
