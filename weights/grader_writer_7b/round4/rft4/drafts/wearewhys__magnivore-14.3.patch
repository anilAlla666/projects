--- /dev/null
+++ b/tests/test_Lexicon_grader.py
@@ -0,0 +1,26 @@
+import unittest
+from magnivore import Lexicon
+
+
+class TestLexicon(unittest.TestCase):
+    def setUp(self):
+        self.tracker = Lexicon.Tracker()
+
+    def tearDown(self):
+        del self.tracker
+
+    def test_factor_rounding(self):
+        self.assertEqual(Lexicon.factor(
+            {'from': 'value', 'factor': 10, 'round': True},
+            {'value': 5}
+        ), 50)
+        self.assertEqual(Lexicon.factor(
+            {'from': 'value', 'factor': 10, 'round': False},
+            {'value': 5.5}
+        ), 55)
+        self.assertEqual(Lexicon.factor(
+            {'from': 'value', 'factor': 10, 'round': 'up'},
+            {'value': 5.1}
+        ), 60)
+        self.assertEqual(Lexicon.factor(
+            {'from': 'value', 'factor': 10, 'round': 'down'},
+            {'value': 5.5}
+        ), 50)
