+def test_fetchall():
+    td = cursor.Cursor(mock.MagicMock())
+    td._executed = "42"
+    td._rows = [["foo", 1], ["bar", 1], ["baz", 2]]
+    td._rownumber = 0
+    td._rowcount = len(td._rows)
+    assert td.fetchall() == [["foo", 1], ["bar", 1], ["baz", 2]]
+    assert td.fetchall() == []
