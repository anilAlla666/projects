--- /dev/null
+++ b/tests/cli/test_unpack_grader.py
@@ -0,0 +1,19 @@
+from __future__ import annotations
+import stat
+from wheel.cli.unpack import unpack
+
+
+def test_permissions(wheel_paths, tmp_path):
+    """
+    Make sure 'wheel unpack' preserves permissions.
+    This also verifies the integrity of our testing wheel files.
+    """
+    for wheel_path in wheel_paths:
+        unpack(wheel_path, str(tmp_path))
+
+        # check if all files have read permission
+        for root, _, files in os.walk(tmp_path):
+            for file in files:
+                mode = os.stat(os.path.join(root, file)).st_mode
+                assert (
+                    mode & stat.S_IRUSR != 0
+                ), f"{os.path.join(root, file)} has no read permission"
