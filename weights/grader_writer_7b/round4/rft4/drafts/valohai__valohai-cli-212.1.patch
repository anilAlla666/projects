+from click import UsageError
+from click.testing import CliRunner
+from tests.commands.run_test_utils import RunTestSetup
+from tests.commands.test_run_test_utils import _assert_executable
+from tests.fixture_data import (
+    EXECUTION_DATA,
+    INPUT_URL,
+    PROJECT_DATA,
+    RUN_CONFIGS,
+    RUN_PARAMS,
+    RUN_PARAMETER_FILE_CONTENTS,
+    RUN_PARAMETER_FILE_PATH,
+    RUN_PARAMETERS,
+)
+from valohai_cli.commands.execution.run import run
+from valohai_cli.ctx import get_project
+from valohai_cli.models import Execution
+
+
+def test_step_run_success(runner, logged_in_and_linked):
+    setup = RunTestSetup(adhoc=False)
+    setup.values.update(RUN_PARAMETERS)
+    setup.args.extend(['--env-variable-name=value'])
+    setup.args.extend([RUN_PARAMETER_FILE_PATH])
+    setup.args.extend([f"--env-variable-name={value}" for value in RUN_ENV_VARIABLE_VALUES])
+    setup.args.extend([f"--input-url={INPUT_URL}"])
+    setup.args.extend(["--download-directory=/tmp", "--watch"])
+    setup.args.extend([f"--runtime-config-{k}={v}" for k, v in RUN_CONFIGS.items()])
+    with setup.run_api_mock:
+        result = runner.invoke(run, setup.args)
+        assert result.exit_code == 0
+        exec_id = EXECUTION_DATA["counter"]
+        assert f"Execution #{exec_id} started." in result.output
+        assert f"Started at {datetime.datetime.utcnow().isoformat(timespec='seconds')}Z" in result.output
+        execution = Execution.from_model(EXECUTION_DATA)
+        _assert_executable(execution, setup)
+
+
+def test_step_run_failure(runner, logged_in_and_linked):
+    setup = RunTestSetup(adhoc=False)
+    setup.values.update(RUN_PARAMETERS)
+    setup.args.extend(['--env-variable-name=value'])
+    setup.args.extend([RUN_PARAMETER_FILE_PATH])
+    setup.args.extend([f"--env-variable-name={value}" for value in RUN_ENV_VARIABLE_VALUES])
+    setup.args.extend([f"--input-url={INPUT_URL}"])
+    setup.args.extend(["--download-directory=/tmp", "--watch"])
+    setup.args.extend([f"--runtime-config-{k}={v}" for k, v in RUN_CONFIGS.items()])
+    setup.args.extend(['--invalid-parameter'])
+    with setup.run_api_mock:
+        result = runner.invoke(run, setup.args)
+        assert result.exit_code != 0
+        assert 'Failed to validate input URL' in result.output
+        assert 'Invalid parameter: invalid-parameter' in result.output
+
+
+RUN_ENV_VARIABLE_VALUES = [
+    'value',
+    'another-value',
+    'yet-another-value',
+    'last-value',
+]
