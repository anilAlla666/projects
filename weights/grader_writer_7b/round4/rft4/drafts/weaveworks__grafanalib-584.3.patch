+"""Tests for Grafanalib."""
+
+
+import grafanalib.core as G
+from grafanalib import _gen
+import sys
+
+
+if sys.version_info[0] < 3:
+    from io import BytesIO as StringIO
+else:
+    from io import StringIO
+
+
+def test_use_new_alerts_true():
+    dashboard = G.Dashboard(useNewAlerts=True)
+    assert dashboard.to_json_data()['useNewAlerts'] is True
+
+
+def test_use_new_alerts_false():
+    dashboard = G.Dashboard(useNewAlerts=False)
+    assert dashboard.to_json_data()['useNewAlerts'] is False
