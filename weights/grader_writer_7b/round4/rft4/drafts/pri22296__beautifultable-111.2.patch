+import unittest
+import sys
+from beautifultable import BeautifulTable
+
+
+class TestAppend(unittest.TestCase):
+    def test_append_columns(self):
+        tbl = BeautifulTable()
+        tbl.columns.append(["a", "b", "c"], header="header")
+        tbl.columns.append(["d", "e", "f"], header="header")
+        tbl.columns.append(["g", "h", "i"], header="header")
+        self.assertEqual(tbl.rows[0][0], "header")
+        self.assertEqual(tbl.rows[1][0], "a")
+        self.assertEqual(tbl.rows[2][0], "d")
+        self.assertEqual(tbl.rows[3][0], "g")
+
+    def test_append_rows(self):
+        tbl = BeautifulTable()
+        tbl.rows.append(["a", "b", "c"])
+        tbl.rows.append(["d", "e", "f"])
+        tbl.rows.append(["g", "h", "i"])
+        self.assertEqual(tbl.columns.header[0], "")
