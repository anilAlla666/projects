+from tests.dialects.test_dialect import Validator
+
+
+class TestRedshift(Validator):
+    dialect = "redshift"
+
+    def test_str_to_base(self):
+        self.validate_identity("SELECT STRTOBASE('123', 16)")
+        self.validate_identity("SELECT STRTOBASE('abc', 16)")
+        self.validate_identity("SELECT STRTOBASE('xyz', 32)")
+        self.validate_identity("SELECT STRTOBASE('123', 16) AS abc")
+        self.validate_identity("SELECT STRTOBASE('abc', 16) AS abc")
+        self.validate_identity("SELECT STRTOBASE('xyz', 32) AS abc")
