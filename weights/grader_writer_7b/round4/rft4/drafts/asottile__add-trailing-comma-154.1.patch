--- /dev/null
+++ b/tests/features/test_literals_test_grader.py
@@ -0,0 +1,21 @@
+import pytest
+from add_trailing_comma._main import _fix_src
+
+
+@pytest.mark.parametrize(
+    ('src', 'expected'),
+    (
+        (
+            'x = (\n'
+            '    object\n'
+            '),\n'
+            'object',
+
+            'x = (\n'
+            '    object,\n'
+            ')\n'
+            ',\n'
+            'object',
+        ),
+    ),
+)
+def test_fixes_tuple_literal_with_trailing_comma(src, expected):
+    assert _fix_src(src, min_version=(2, 7)) == expected
