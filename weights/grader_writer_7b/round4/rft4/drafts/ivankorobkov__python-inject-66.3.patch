+from random import random
+import asyncio
+from unittest import TestCase
+from inject import Injector, InjectorException
+
+
+class TestAsyncFunction(TestCase):
+    def test_async_function__is_coroutine_function(self):
+        async def func():
+            pass
+
+        assert asyncio.iscoroutinefunction(func)
+
+    def test_async_function__after_wrapping_with_param(self):
+        @asyncio.coroutine
+        def func():
+            pass
+
+        inject.params(func, "value")
+        assert asyncio.iscoroutinefunction(func)
+
+    def test_async_function__after_wrapping_with_attr(self):
+        class MyClass(object):
+            value = 123
+
+        assert asyncio.iscoroutinefunction(MyClass.value)
