+
+class ProxyTest(unittest.TestCase):
+    def setUp(self):
+        os.environ.pop("http_proxy", None)
+        os.environ.pop("HTTP_PROXY", None)
+        os.environ.pop("https_proxy", None)
+        os.environ.pop("HTTPS_PROXY", None)
+        os.environ.pop("all_proxy", None)
+        os.environ.pop("ALL_PROXY", None)
+        os.environ.pop("no_proxy", None)
+        os.environ.pop("NO_PROXY", None)
+
+    def tearDown(self):
+        os.environ.pop("http_proxy", None)
+        os.environ.pop("HTTP_PROXY", None)
+        os.environ.pop("https_proxy", None)
+        os.environ.pop("HTTPS_PROXY", None)
+        os.environ.pop("all_proxy", None)
+        os.environ.pop("ALL_PROXY", None)
+        os.environ.pop("no_proxy", None)
+        os.environ.pop("NO_PROXY", None)
+
+    def test_get_proxy_info_with_http_only_proxy(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = "localhost"
+        self.assertEqual(get_proxy_info("localhost", True), (None, 0, None))
+        self.assertEqual(get_proxy_info("otherhost", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_https_only_proxy(self):
+        os.environ["https_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = "localhost"
+        self.assertEqual(get_proxy_info("localhost", True), ("localhost", 3128, None))
+        self.assertEqual(get_proxy_info("otherhost", True), (None, 0, None))
+
+    def test_get_proxy_info_with_all_proxy(self):
+        os.environ["all_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = "localhost"
+        self.assertEqual(get_proxy_info("localhost", True), ("localhost", 3128, None))
+        self.assertEqual(get_proxy_info("otherhost", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_http_and_https_proxies(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["https_proxy"] = "http://localhost2:3128/"
+        os.environ["no_proxy"] = "localhost"
+        self.assertEqual(get_proxy_info("localhost", True), ("localhost2", 3128, None))
+        self.assertEqual(get_proxy_info("otherhost", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_http_and_https_proxies_without_no_proxy(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["https_proxy"] = "http://localhost2:3128/"
+        self.assertEqual(get_proxy_info("localhost", True), ("localhost2", 3128, None))
+        self.assertEqual(get_proxy_info("otherhost", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_uppercase_env_vars(self):
+        os.environ["HTTP_PROXY"] = "http://localhost:3128/"
+        os.environ["HTTPS_PROXY"] = "http://localhost2:3128/"
+        os.environ["NO_PROXY"] = "localhost"
+        self.assertEqual(get_proxy_info("localhost", True), ("localhost2", 3128, None))
+        self.assertEqual(get_proxy_info("otherhost", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_empty_environment_variables(self):
+        self.assertEqual(get_proxy_info("localhost", True), (None, 0, None))
+
+    def test_get_proxy_info_with_invalid_environment_variables(self):
+        os.environ["http_proxy"] = "invalid://localhost:3128/"
+        self.assertEqual(get_proxy_info("localhost", True), (None, 0, None))
+
+    def test_get_proxy_info_with_multiple_no_proxy_hosts(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = "localhost,google.com"
+        self.assertEqual(get_proxy_info("localhost", True), (None, 0, None))
+        self.assertEqual(get_proxy_info("google.com", True), (None, 0, None))
+        self.assertEqual(get_proxy_info("otherhost", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_wildcard_no_proxy_host(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = "*"
+        self.assertEqual(get_proxy_info("localhost", True), (None, 0, None))
+        self.assertEqual(get_proxy_info("otherhost", True), (None, 0, None))
+
+    def test_get_proxy_info_with_ipv6_no_proxy_host(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = "[::1]"
+        self.assertEqual(get_proxy_info("[::1]", True), (None, 0, None))
+        self.assertEqual(get_proxy_info("[::2]", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_ipv4_no_proxy_host(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = "127.0.0.1"
+        self.assertEqual(get_proxy_info("127.0.0.1", True), (None, 0, None))
+        self.assertEqual(get_proxy_info("127.0.0.2", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_cidr_no_proxy_host(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = "127.0.0.0/8"
+        self.assertEqual(get_proxy_info("127.0.0.1", True), (None, 0, None))
+        self.assertEqual(get_proxy_info("127.0.0.2", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_ipv6_cidr_no_proxy_host(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = "::1/128"
+        self.assertEqual(get_proxy_info("[::1]", True), (None, 0, None))
+        self.assertEqual(get_proxy_info("[::2]", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_ipv4_cidr_no_proxy_host(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = "127.0.0.0/24"
+        self.assertEqual(get_proxy_info("127.0.0.1", True), (None, 0, None))
+        self.assertEqual(get_proxy_info("127.0.0.2", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_dotless_domain_no_proxy_host(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = ".example.com"
+        self.assertEqual(get_proxy_info("www.example.com", True), (None, 0, None))
+        self.assertEqual(get_proxy_info("otherhost", True), ("localhost", 3128, None))
+
+    def test_get_proxy_info_with_domain_no_proxy_host(self):
+        os.environ["http_proxy"] = "http://localhost:3128/"
+        os.environ["no_proxy"] = "example.com"
+        self.assertEqual(get_proxy_info("www.example.com", True), (None, 0, None))
+        self.assertEqual(get_proxy_info("otherhost", True), ("localhost", 3128, None))
