+import datetime as dt
+import pytest
+from marshmallow import fields, Schema
+from tests.base import assert_datetime_equal, UTC
+
+
+def test_from_iso_datetime_no_timezone_suffix():
+    # Issue 1249: Ensure parsing ISO8601 datetimes works even when no timezone suffix is present.
+    d = dt.datetime.now(tz=UTC)
+    formatted = d.isoformat()[:-1]
+    result = utils.from_iso(formatted)
+    assert type(result) == dt.datetime
+    assert_datetime_equal(result, d.replace(tzinfo=None))
+
+
+def test_from_iso_datetime_with_Z_suffix():
+    d = dt.datetime.now(tz=UTC)
+    formatted = d.isoformat()
+    result = utils.from_iso(formatted)
+    assert type(result) == dt.datetime
+    assert_datetime_equal(result, d)
