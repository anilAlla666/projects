+"""
+A pytest module to test generating minimal polynomials.
+
+Sage:
+    PARAMS = [(2,1), (2,2), (2,3), (2,4), (3,1), (3,2), (3,3), (3,4), (5,1), (5,2), (5,3)]
+    for p, m in PARAMS:
+        print(f"MINIMAL_POLYS_{p}_{m} = [")
+        F.<x> = GF(p**m)
+        for i in range(0, F.order()):
+            e = F(i) if m == 1 else F.fetch_int(i)
+            c = e.minpoly().coefficients(sparse=False)[::-1]
+            print(f"    ({i}, {c}),",)
+        print("]\n")
+"""
+
+
+import pytest
+import numpy as np
+import galois
+
+
+PARAMS = [(2,1), (2,2), (2,3), (2,4), (3,1), (3,2), (3,3), (3,4), (5,1), (5,2), (5,3)]
+
+
+MINIMAL_POLYS_2_1 = [
+    (0, [1, 0]),
+    (1, [1, 1]),
+]
+
+
+MINIMAL_POLYS_2_2 = [
+    (0, [1, 0]),
+    (1, [1, 1]),
+    (2, [1, 1, 1]),
+    (3, [1, 1, 1]),
+]
+
+
+def test_minimal_poly_duplicates():
+    with pytest.raises(ValueError):
+        galois.Poly.Degrees([1, 1, 1])
+    with pytest.raises(ValueError):
+        galois.Poly.Degrees([1, 2, 2, 2])
+    with pytest.raises(ValueError):
+        galois.Poly.Degrees([1, 2, 2, 3, 3])
