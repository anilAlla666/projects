+from boltons.funcutils import (copy_function,
+                               total_ordering,
+                               InstancePartial,
+                               CachedInstancePartial)
+
+
+class Greeter(object):
+    def __init__(self, greeting):
+        self.greeting = greeting
+
+    def greet(self, excitement='.'):
+        return self.greeting.capitalize() + excitement
+
+    partial_greet = InstancePartial(greet, excitement='!')
+    cached_partial_greet = CachedInstancePartial(greet, excitement='...')
+
+    def native_greet(self):
+        return self.greet(';')
+
+
+class SubGreeter(Greeter):
+    pass
+
+
+def test_annotation_support():
+    from typing import Optional
+
+    def wrapper(func):
+        @wraps(func)
+        def wrapper(*args, **kwargs):
+            func(*args, **kwargs)
+        return wrapper
+
+    @wrapper
+    def foo(x: Optional[int]) -> Optional[int]:
+        return x
+
+    assert foo.__annotations__ == {'x': Optional[int],
+                                   'return': Optional[int]}
+
+    # ensure the inner function has annotations too
+    assert foo.__wrapped__.__annotations__ == {'x': Optional[int],
+                                              'return': Optional[int]}
