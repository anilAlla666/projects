--- /dev/null
+++ b/tests/middleware/test_cors_grader.py
@@ -0,0 +1,22 @@
+from starlette.applications import Starlette
+from starlette.middleware.cors import CORSMiddleware
+from starlette.responses import PlainTextResponse
+from starlette.testclient import TestClient
+
+
+def test_cors_validates_regex_pattern():
+    app = Starlette()
+
+    app.add_middleware(CORSMiddleware, allow_origins_regex=r"^https:\/\/.*\.example\.org$")
+
+    @app.route("/")
+    def homepage(request):
+        return PlainTextResponse("Homepage", status_code=200)
+
+    client = TestClient(app)
+
+    response = client.options("/?test=1", headers={"Origin": "https://sub.example.org"})
+    assert response.status_code == 200
+    response = client.options("/?test=1", headers={"Origin": "https://not-example.org"})
+    assert response.status_code == 400
