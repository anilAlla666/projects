+from unittest import TestCase
+from electionguard.words import get_word, get_index_from_word, WordError
+
+
+class TestWord(TestCase):
+    def test_get_word_when_out_of_range_raises_exception(self):
+        # Arrange
+        INDEX_BELOW_MIN = -1
+        INDEX_ABOVE_MAX = 4096
+
+        # Act & Assert
+        with self.assertRaises(WordError):
+            get_word(INDEX_BELOW_MIN)
+        with self.assertRaises(WordError):
+            get_word(INDEX_ABOVE_MAX)
+
+    def test_get_index_from_word_when_word_not_found_raises_exception(self):
+        # Arrange
+        WORD_NOT_IN_LIST = "not found"
+
+        # Act & Assert
+        with self.assertRaises(WordError):
+            get_index_from_word(WORD_NOT_IN_LIST)
+
+    def test_get_word_and_get_index_from_word_work_correctly_with_in_list_word(self):
+        # Arrange
+        INDEX_MIN = 0
+        INDEX_RANDOM_1 = 100
+        INDEX_RANDOM_2 = 1000
+        INDEX_MAX = 4095
+
+        WORD_MIN = "aardvark"
+        WORD_RANDOM_1 = "alfalfa"
+        WORD_RANDOM_2 = "column"
+        WORD_MAX = "prospect"
+
+        # Act
+        word_min = get_word(INDEX_MIN)
+        word_random_1 = get_word(INDEX_RANDOM_1)
+        word_random_2 = get_word(INDEX_RANDOM_2)
+        word_max = get_word(INDEX_MAX)
+        reverse_find_of_index_random_1 = get_index_from_word(word_random_1)
