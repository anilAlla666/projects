+import re
+import pytest
+import rdflib
+
+
+TRIPLE = (
+    rdflib.URIRef("http://example.com/s"),
+    rdflib.RDFS.label,
+    rdflib.Literal("example 1"),
+)
+
+
+def test_no_unnamed_prefix():
+    ds = rdflib.Dataset()
+    ds.add((rdflib.BNode(), rdflib.RDF.type, rdflib.DCTerms.Title))
+    ds.serialize(encoding=None)
+
+    serialized = ds.serialize(encoding=None)
+    assert 'rdf:"' in serialized
+    assert "urn:x-rdflib:" not in serialized
+    assert '<http://purl.org/dc/terms/>' in serialized
