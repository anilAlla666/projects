+            isort.file(temp_file.name, settings=[temp_config1.name])
+            isort.file(temp_file.name, settings=[temp_config2.name])
+            config = Config(settings=[temp_config1.name])
+            assert config.profile == "black"
+            config = Config(settings=[temp_config2.name])
+            assert config.profile == "django"
+
+
+def test_settings_are_cached_for_different_working_dirs() -> None:
+    with NamedTemporaryFile(mode="w+") as temp_config1, NamedTemporaryFile(mode="w+") as temp_config2:
+        temp_config1.write("[settings]\nprofile = black\n")
+        temp_config2.write("[settings]\nprofile = django\n")
+        temp_config1.flush()
+        temp_config2.flush()
+        with NamedTemporaryFile() as temp_file:
+            isort.file(temp_file.name, settings=[temp_config1.name])
+            isort.file(temp_file.name, settings=[temp_config2.name])
+            config = Config(settings=[temp_config1.name])
+            assert config.profile == "black"
+            config = Config(settings=[temp_config2.name])
+            assert config.profile == "django"
+
+
+def test_settings_are_cached_for_editorconfig() -> None:
+    with NamedTemporaryFile(mode="w+") as temp_config:
+        temp_config.write("root=true\n[*]\nindent_style = tab\n")
+        temp_config.flush()
+        with NamedTemporaryFile() as temp_file:
+            isort.file(temp_file.name, settings=[temp_config.name])
+            config = Config(settings=[temp_config.name])
+            assert config.indent_style == "tab"
