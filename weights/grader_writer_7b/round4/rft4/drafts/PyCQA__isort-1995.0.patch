+"""Tests all major functionality of the isort library
+
+Should be ran using py.test by simply running py.test in the isort project directory
+"""
+
+
+import os
+import os.path
+import subprocess
+import sys
+from io import StringIO
+from pathlib import Path
+from tempfile import NamedTemporaryFile
+from typing import TYPE_CHECKING, Any, Dict, Iterator, List, Set, Tuple
+import py
+import pytest
+import isort
+from isort import api, files, sections
+from isort.exceptions import ExistingSyntaxErrors, FileSkipped, MissingSection
+from isort.settings import Config
+from isort.utils import exists_case_sensitive
+from .utils import UnreadableStream, as_stream
+
+
+if TYPE_CHECKING:
+    WrapModes: Any
+else:
+    from isort.wrap_modes import WrapModes
+
+
+TEST_DEFAULT_CONFIG = """
+[*.{py,pyi}]
+max_line_length = 120
+indent_style = space
+indent_size = 4
+known_first_party = isort
+known_third_party = kate
+known_something_else = something_entirely_different
+sections = FUTURE, STDLIB, THIRDPARTY, FIRSTPARTY, LOCALFOLDER, SOMETHING_ELSE
+ignore_frosted_errors = E103
+skip = build,.tox,venv
+"""
+
+
+@pytest.fixture(scope="function")
+def default_config():
+    with NamedTemporaryFile(mode="w+", suffix=".cfg") as temp_config:
+        temp_config.write(TEST_DEFAULT_CONFIG)
+        temp_config.flush()
+        yield Config(settings_path=temp_config.name)
+
+
+@pytest.mark.parametrize("filename", ("pyproject.toml", "setup.cfg", ".isort.cfg"))
+def test_settings_are_cached(filename: str) -> None:
+    with NamedTemporaryFile(mode="w+") as temp_config:
+        temp_config.write("[settings]\nprofile = black\n")
+        temp_config.flush()
+        with NamedTemporaryFile() as temp_file:
+            isort.file(temp_file.name, settings=[temp_config.name])
+            config = Config(settings=[temp_config.name])
+            assert config.profile == "black"
+            config = Config(settings=[temp_config.name])
+            assert config.profile == "black"
+
+
+def test_settings_are_cached_for_multiple_files() -> None:
+    with NamedTemporaryFile() as temp_file1, NamedTemporaryFile() as temp_file2, NamedTemporaryFile() as temp_file3:
+        with NamedTemporaryFile(mode="w+") as temp_config:
+            temp_config.write("[settings]\nprofile = black\n")
+            temp_config.flush()
+            isort.file(temp_file1.name, settings=[temp_config.name])
+            isort.file(temp_file2.name, settings=[temp_config.name])
+            isort.file(temp_file3.name, settings=[temp_config.name])
+            config = Config(settings=[temp_config.name])
+            assert config.profile == "black"
+            config = Config(settings=[temp_config.name])
+            assert config.profile == "black"
+
+
+@pytest.mark.parametrize("filename", ("pyproject.toml", "setup.cfg", ".isort.cfg"))
+def test_settings_are_not_cached_when_modified(filename: str) -> None:
+    with NamedTemporaryFile(mode="w+") as temp_config:
+        temp_config.write("[settings]\nprofile = black\n")
+        temp_config.flush()
+        with NamedTemporaryFile() as temp_file:
+            isort.file(temp_file.name, settings=[temp_config.name])
+            config = Config(settings=[temp_config.name])
+            assert config.profile == "black"
+            temp_config.seek(0)
+            temp_config.truncate(0)
+            temp_config.write("[settings]\nprofile = django\n")
+            temp_config.flush()
+            config = Config(settings=[temp_config.name])
+            assert config.profile == "django"
+
+
+def test_settings_are_cached_with_different_settings_paths() -> None:
+    with NamedTemporaryFile(mode="w+") as temp_config1, NamedTemporaryFile(mode="w+") as temp_config2:
+        temp_config1.write("[settings]\nprofile = black\n")
+        temp_config2.write("[settings]\nprofile = django\n")
+        temp_config1.flush()
+        temp_config2.flush()
+        with NamedTemporaryFile() as temp_file:
+            isort.file(temp_file.name, settings=[temp_config1.name])
+            isort.file(temp_file.name, settings=[temp_config2.name])
+            config = Config(settings=[temp_config1.name])
+            assert config.profile == "black"
+            config = Config(settings=[temp_config2.name])
+            assert config.profile == "django"
+
+
+@pytest.mark.skipif(sys.version_info.minor <= 6, reason="requires python 7")
+def test_settings_are_cached_for_multiple_python_versions() -> None:
+    with NamedTemporaryFile(mode="w+") as temp_config1, NamedTemporaryFile(mode="w+") as temp_config2:
+        temp_config1.write("[settings]\nprofile = black\n")
+        temp_config2.write("[settings]\nprofile = django\n")
+        temp_config1.flush()
+        temp_config2.flush()
