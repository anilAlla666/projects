+
+
+MAPPER = URIMapper.from_mappings(
+    (REMOTE_BASE_IRI, ensure_suffix(LOCAL_BASE_DIR.as_uri(), "/"))
+)
+
+
+VALID_TYPES = {
+    RDFT.TestTrigEval,
+    RDFT.TestTrigPositiveSyntax,
+    RDFT.TestTrigNegativeSyntax,
+    RDFT.TestTrigNegativeEval,
+}
+
+
+def check_entry(entry: ManifestEntry) -> None:
+    assert entry.action is not None
+    assert entry.type in VALID_TYPES
+
+
+@pytest.fixture(name="graph_helper")
+def fixture_graph_helper() -> GraphHelper:
+    return GraphHelper(MAPPER)
+
+
+@pytest.fixture(name="bnode_handling")
+def fixture_bnode_handling() -> BNodeHandling:
+    return BNodeHandling()
+
+
+@pytest.fixture(name="expected_result")
+def fixture_expected_result(
+    entry: ManifestEntry, graph_helper: GraphHelper
+) -> Optional[Dataset]:
+    result = None
+    if entry.result is not None:
+        expected_file_path = entry.result["result"]["value"]
+        expected_data = graph_helper.read(expected_file_path)
+        expected_data.encoding = ENCODING
+        result = expected_data.graph
+    return result
+
+
+@pytest.fixture(name="action")
+def fixture_action(entry: ManifestEntry) -> Dataset:
+    action = Dataset()
+    if entry.action is not None:
+        action_str = entry.action["content"]
+        action_str = action_str.replace("\\n", "\n")
+        action_str = action_str.replace("\\\"", '"')
+        action_str = action_str.replace("\\t", "\t")
+        action_str = action_str.replace("\\\\", "\\")
+        action.parse(action_str, format="trig")
+    return action
+
+
+def check_result(
+    action: Dataset,
+    result: Dataset,
+    bnode_handling: BNodeHandling,
+    expected_result: Optional[Dataset],
+    manifest_entry: ManifestEntry,
+) -> None:
+    # check if the results are the same
+    # ignore any blank nodes in the result
+    if expected_result is not None:
+        result = bnode_handling.clean(result)
+        expected_result = bnode_handling.clean(expected_result)
+        assert result == expected_result, (
+            f"Result differs from expected for {manifest_entry.title}"
+            f"\nExpected:\n{expected_result}\nGot:\n{result}"
+        )
+    # check that all triples are present in the result
+    if action is not None:
+        for triple in action:
+            assert triple in result, (
+                f"Not all triples were found in the result for {manifest_entry.title}. "
+                f"The missing triple is: {triple}"
+            )
+
+
+@pytest.fixture(name="check_func")
+def fixture_check_func(
+    bnode_handling: BNodeHandling,
+    expected_result: Optional[Dataset],
+    action: Dataset,
+) -> callable:
+    def _check_result(result: Dataset) -> None:
+        check_result(
+            action=action,
+            result=result,
+            bnode_handling=bnode_handling,
+            expected_result=expected_result,
+            manifest_entry=manifest_entry,
+        )
+
+    return _check_result
+
