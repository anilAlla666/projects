+from __future__ import unicode_literals
+import pytest
+import datetime
+import time
+from emails.utils import (
+    parse_name_and_email,
+    encode_header,
+    decode_header,
+    sanitize_address,
+    fetch_url,
+    MessageID,
+    format_date_header,
+    parse_name_and_email_list,
+    sanitize_email
+)
+from emails.exc import HTTPLoaderError
+
+
+def test_sanitize_address():
+    assert sanitize_address('a <b>') == 'a <b>'
+    assert sanitize_address('a@b.d') == 'a@b.d'
+    assert sanitize_address('x y <a@b.d>') == 'x y <a@b.d>'
+    assert sanitize_address('♤ <a@b.d>') == '=?utf-8?q?=E2=9C=A4?= <a@b.d>'
+    assert sanitize_address('a@♤.d') == 'a@xn--f6h.d'
+
+
+def test_sanitize_email():
+    assert sanitize_email('a@♤.d') == 'a@xn--f6h.d'
+
+
+def test_sanitize_address_encoding():
+    assert sanitize_address('a@xn--f6h.d', force_ascii=True) == 'a@xn--f6h.d'
+    assert sanitize_address('a@xn--f6h.d', force_ascii=False) == 'a@xn--f6h.d'
