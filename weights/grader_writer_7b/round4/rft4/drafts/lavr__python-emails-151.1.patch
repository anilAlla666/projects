+from __future__ import unicode_literals
+import socket
+import pytest
+import emails
+from emails.backend.smtp import SMTPBackend
+from emails.testsuite.smtp_servers import get_servers
+
+
+SAMPLE_MESSAGE = {'html': '<p>Test from python-emails',
+                  'text': 'Test from python-emails',
+                  'mail_from': 's@lavr.me',
+                  'mail_to': 'sergei-nko@yandex.ru'}
+
+
+def test_send_with_utf8_local_part():
+    server = SMTPBackend(host='localhost', port=1025, tls=True)
+    response = server.sendmail(
+        to_addrs='annaïs@example.com', 
+        from_addr='annaïs@example.com',
+        msg=emails.html(subject='test', **SAMPLE_MESSAGE)
+    )
+    server.close()
+    assert response.status_code == 250
+    assert response.message.startswith(b'250 OK')
+
+
+def test_send_with_invalid_domain():
+    server = SMTPBackend(host='localhost', port=1025, tls=True)
+    response = server.sendmail(
+        to_addrs='annaïs@invalid.com', 
+        from_addr='annaïs@invalid.com',
+        msg=emails.html(subject='test', **SAMPLE_MESSAGE)
+    )
+    server.close()
+    assert response.status_code == 554
