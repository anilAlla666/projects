--- /dev/null
+++ b/tests/test_helpers_grader.py
@@ -0,0 +1,34 @@
+from collections import defaultdict
+from pyrsistent import freeze
+
+
+def test_freeze_defaultdict():
+    dd = defaultdict(list)
+    dd['key'].append('value')
+    res = freeze(dd)
+
+    assert type(res) is defaultdict
+    assert type(next(iter(res.values()))) is list
+    assert res == dd
+
+
+def test_freeze_nested_defaultdict():
+    dd = defaultdict(lambda: defaultdict(int))
+    dd['a']['x'] += 1
+    dd['a']['y'] += 2
+    dd['b']['z'] += 3
+    res = freeze(dd)
+
+    assert type(res) is defaultdict
+    assert type(next(iter(res.values()))) is defaultdict
+    assert res == dd
+
+
+def test_freeze_defaultdict_of_sets():
+    dd = defaultdict(set)
+    dd['a'].add('value')
+    res = freeze(dd)
+
+    assert type(res) is defaultdict
+    assert type(next(iter(res.values()))) is set
+    assert res == dd
