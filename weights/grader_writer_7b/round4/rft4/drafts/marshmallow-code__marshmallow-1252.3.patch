+import datetime as dt
+from collections import namedtuple
+from functools import partial
+from copy import copy, deepcopy
+import pytest
+from marshmallow import utils
+from tests.base import (
+    assert_datetime_equal,
+    central,
+    assert_time_equal,
+    assert_date_equal,
+)
+
+
+def test_from_iso_datetime_with_z():
+    d = dt.datetime.now(tz=central)
+    formatted = d.isoformat() + 'Z'
+    result = utils.from_iso(formatted)
+    assert type(result) == dt.datetime
+    assert_datetime_equal(result, d)
+
+
+@pytest.fixture(scope='module')
+def now_millisec():
+    return dt.datetime.now(tz=dt.timezone.utc).replace(microsecond=123456)
