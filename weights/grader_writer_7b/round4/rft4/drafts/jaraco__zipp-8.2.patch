+def add_dirs(zipfile):
+    """
+    Given a writable zipfile, inject directory entries for
+    any directories implied by the presence of children.
+    """
+    names = zipfile.namelist()
+    for name in names:
+        dirname = posixpath.dirname(name)
+        if dirname and dirname not in names:
+            zipfile.writestr(dirname + "/", b"")
+
+
+@contextlib.contextmanager
+def make_zipfile(filename, content=None):
+    """
+    Create a zip file with a single file named 'a', yielding its path.
+    If 'content' is provided, use it as the contents of 'a'.
+    """
+    if content is None:
+        content = b"content of a"
+    with tempfile.NamedTemporaryFile(mode="", delete=False) as strm:
+        with zipfile.ZipFile(strm, "w") as zipf:
+            zipf.writestr("a", content)
+        yield strm.name
+    os.unlink(strm.name)
+
