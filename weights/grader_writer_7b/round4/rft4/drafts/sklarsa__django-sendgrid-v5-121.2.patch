+def get_attachment_payload(filename, content_type=None):
+    with open(f"./test/{filename}", "rb") as attachment:
+        part = MIMEImage(attachment.read())
+        part.add_header(
+            "Content-Disposition",
+            f'attachment; filename="{filename}"',
+            Content_Type=content_type,
+        )
+        encoded_string = base64.b64encode(part.get_payload()).decode()
+        payload = {
+            "content": encoded_string,
+            "type": part.get_content_type(),
+            "disposition": "attachment",
+            "filename": filename,
+        }
+        return payload
