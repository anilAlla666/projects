--- /dev/null
+++ b/tests/test_multistrategy_dispatch_grader.py
@@ -0,0 +1,42 @@
+from typing import Optional
+from cattr.multistrategy_dispatch import MultiStrategyDispatch
+
+
+class Foo(object):
+    pass
+
+
+def _fallback():
+    pass
+
+
+def _foo_func():
+    pass
+
+
+def _foo_cls():
+    pass
+
+
+def _other_foo_func():
+    pass
+
+
+def _other_foo_cls():
+    pass
+
+
+def test_multistrategy_dispatch_subclass_catches_base():
+    dispatch = MultiStrategyDispatch(_fallback)
+    dispatch.register_func_list(
+        [
+            (lambda cls: issubclass(cls, Foo), _other_foo_func),
+            (lambda cls: True, _foo_func),
+        ]
+    )
+    dispatch.register_cls_list(
+        [
+            (Foo, _other_foo_cls),
+            (object, _foo_cls),
+        ]
+    )
+    assert dispatch.dispatch(Foo) == _other_foo_func
