--- /dev/null
+++ b/tests/test_util_ast_grader.py
@@ -0,0 +1,60 @@
+import ast
+from typing import Callable, cast
+import pytest
+from func_adl.util_ast import (
+    _realign_indent,
+    as_ast,
+    function_call,
+    lambda_args,
+    lambda_body_replace,
+    lambda_build,
+    lambda_call,
+    lambda_is_identity,
+    lambda_is_true,
+    lambda_test,
+    lambda_unwrap,
+    parse_as_ast,
+    rewrite_func_as_lambda,
+    scan_for_metadata,
+)
+
+
+def test_parse_closure():
+    "Test that we get a valid closure"
+    found = []
+
+    def func_bottom(x: Callable):
+        found.append(parse_as_ast(x))
+
+    def func_top(x: Callable):
+        func_bottom(x)
+
+    func_top(lambda x: x + 1)
+
+    assert len(found) == 1
+    l1 = found[0]
+    assert isinstance(l1.body, ast.BinOp)
+    assert isinstance(l1.body.op, ast.Add)
+
+
+def test_parse_closure_global():
+    "Test that we get a valid closure"
+    found = []
+
+    def func_bottom(x: Callable):
+        found.append(parse_as_ast(x))
+
+    def func_top(x: Callable):
+        func_bottom(x)
+
+    def foo(x: int):
+        return x + 1
+
+    func_top(foo)
+
+    assert len(found) == 1
+    l1 = found[0]
+    assert isinstance(l1.body, ast.BinOp)
+    assert isinstance(l1.body.op, ast.Add)
+
+
+def test_realign_indent_2lines_uneven():
+    assert _realign_indent("    test()\n        dude()") == "test()\n    dude()"
