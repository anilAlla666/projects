+"""Tests the python routines within L027."""
+
+
+import sqlfluff
+
+
+def test__rules__std_L027_multiple_subquery_tables():
+    """Ensure multiple tables in a sub-query don't raise false positive errors (#2405)."""
+    sql = """
+        SELECT
+            account.id AS account_id,
+            account.isdeleted AS is_deleted
+        FROM salesforce_sd.account
+        INNER JOIN salesforce_sd."user" ON salesforce_sd."user".id = account.ownerid
+        WHERE EXISTS (
+            SELECT 1
+            FROM salesforce_sd.user AS user
+            INNER JOIN salesforce_sd.mapping AS mapping ON (
+                mapping.other_fk = user.id_pk
+            )
+            WHERE mapping.kind = account.kind
+        );
+    """
+    result = sqlfluff.lint(sql)
+    assert "L027" not in [r["code"] for r in result], "L027 should not be raised."
+
+
+def test__rules__std_L027_cross_joined_tables():
+    """Ensure cross-joined tables don't raise false positive errors (#2405)."""
+    sql = """
+        SELECT
+            account.id AS account_id,
+            account.isdeleted AS is_deleted
+        FROM salesforce_sd.account
+        CROSS JOIN salesforce_sd."user"
+        WHERE EXISTS (
+            SELECT 1
+            FROM salesforce_sd.user AS user
+            INNER JOIN salesforce_sd.mapping AS mapping ON (
+                mapping.other_fk = user.id_pk
+            )
+            WHERE mapping.kind = account.kind
+        );
+    """
+    result = sqlfluff.lint(sql)
+    assert "L027" not in [r["code"] for r in result], "L027 should not be raised."
