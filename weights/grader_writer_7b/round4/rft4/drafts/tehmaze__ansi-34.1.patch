--- /dev/null
+++ b/tests/test_ansi_colour_rgb_grader.py
@@ -0,0 +1,11 @@
+import pytest
+from ansi.colour.rgb import rgb256
+
+
+def test_rgb256():
+    """Test RGB256"""
+    assert rgb256(0, 0, 0) == '\x1b[38;5;16m'
+    assert rgb256(255, 255, 255) == '\x1b[38;5;231m'
+    assert rgb256(0, 0, 0, bg=True) == '\x1b[48;5;16m'
+    assert rgb256(255, 255, 255, bg=True) == '\x1b[48;5;231m'
+    assert rgb256(255, 0, 0) == '\x1b[38;5;196m'
