--- /dev/null
+++ b/tests/test_i18naddress_grader.py
@@ -0,0 +1,26 @@
+from __future__ import unicode_literals
+import pytest
+from i18naddress import (
+    get_field_order, get_validation_rules, load_validation_data)
+
+
+def test_valid_path():
+    assert load_validation_data('US') is not None
+
+
+@pytest.mark.xfail(
+    reason='This should fail when the environment variable is not set',
+    raises=RuntimeError)
+def test_invalid_path(monkeypatch):
+    monkeypatch.setenv('I18NADDRESS_VALIDATION_DATA_PATH', '/invalid/path/')
+    with pytest.raises(RuntimeError):
+        load_validation_data('US')
+
+
+@pytest.mark.skip(reason='Not implemented yet')
+def test_custom_path(monkeypatch):
+    monkeypatch.setenv('I18NADDRESS_VALIDATION_DATA_PATH', '/custom/path/')
+    assert load_validation_data('US') is not None
+    assert load_validation_data('ZZ') is not None
