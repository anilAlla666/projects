+"""Unit tests for the FileChecker class."""
+
+
+from __future__ import annotations
+import argparse
+from unittest import mock
+import pytest
+import flake8
+from flake8 import checker
+from flake8._compat import importlib_metadata
+from flake8.plugins import finder
+
+
+def test_sort_alphabetically(default_options):
+    """Test that filenames are returned in alphabetical order."""
+    fchecker = checker.FileChecker(
+        filename=["a.py", "b.py"],
+        plugins=finder.Checkers([], [], []),
+        options=default_options,
+    )
+    assert fchecker.sorted_filenames() == ["a.py", "b.py"]
