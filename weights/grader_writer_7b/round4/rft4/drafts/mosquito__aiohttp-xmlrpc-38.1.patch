--- /dev/null
+++ b/tests/test_handler_grader.py
@@ -0,0 +1,85 @@
+import asyncio
+import datetime
+import pytest
+from aiohttp import web
+from aiohttp_xmlrpc import handler
+from aiohttp_xmlrpc.exceptions import ApplicationError
+from lxml import etree
+from lxml.builder import E
+
+
+pytest_plugins = (
+    "aiohttp.pytest_plugin",
+    "aiohttp_xmlrpc.pytest_plugin",
+)
+
+
+class XMLRPCMain(handler.XMLRPCView):
+    def rpc_test(self):
+        return None
+
+    def rpc_args(self, *args):
+        return len(args)
+
+    def rpc_kwargs(self, **kwargs):
+        return len(kwargs)
+
+    def rpc_args_kwargs(self, *args, **kwargs):
+        return len(args) + len(kwargs)
+
+    def rpc_exception(self):
+        raise Exception("YEEEEEE!!!")
+
+    def rpc_strings(self, s1, s2):
+        return s1 == s2
+
+    def rpc_datetime(self, test_datetime_1, test_datetime_2):
+        return test_datetime_1, test_datetime_2
+
+    def rpc_future(self):
+        return 42
+
+
+async def create_app():
+    app = web.Application()
+    app.router.add_route("*", "/", XMLRPCMain)
+    return app
+
+
+@pytest.fixture
+def client(aiohttp_client):
+    return aiohttp_client(create_app())
+
+
+async def test_11_list_of_structs(test_client):
+    # Test for bug #30: Structs should be parsed into dicts.
+    request = E.methodCall(
+        E.methodName("listOfStructs"),
+        E.params(
+            E.param(
+                E.value(
+                    E.array(
+                        E.data(
+                            E.struct(
+                                E.member(
+                                    E.name("field1"),
+                                    E.value(E.string("value1")),
+                                ),
+                                E.member(
+                                    E.name("field2"),
+                                    E.value(E.string("value2")),
+                                ),
+                            ),
+                            E.struct(),
+                        ),
+                    ),
+                ),
+            ),
+        ),
+    )
+    client = await test_client(create_app)
+
+    async with client.post(
+        "/",
+        data=etree.tostring(request, xml_declaration=True, pretty_print=True),
+        headers={"Content-Type": "text/xml"},
+    ) as resp:
+        assert resp.status == 200
+
+        root = etree.fromstring((await resp.read()))
+    assert len(root.xpath("//value/struct")) == 2
