+"""Identity dispositor tests."""
+
+
+import json
+import unittest
+from ocfl.inventory_validator import InventoryValidator
+
+
+class TLogger():
+    """Simplified logger to replace ValidationLogger."""
+
+    def __init__(self):
+        """Initialize."""
+        self.clear()
+
+    def error(self, code, **args):  # pylint: disable=unused-argument
+        """Add error code, discard args."""
+        self.errors.append(code)
+
+    def warning(self, code, **args):  # pylint: disable=unused-argument
+        """Add warn code, discard args."""
+        self.warns.append(code)
+
+    def clear(self):
+        """Clear records."""
+        self.errors = []
+        self.warns = []
+
+
+class TestAll(unittest.TestCase):
+    """TestAll class to run tests."""
+
+    def test_check_id(self):
+        """Test check_id method."""
+        log = TLogger()
+        iv = InventoryValidator(log=log)
+        # Bad cases
+        self.assertFalse(iv.check_id(None))
+        self.assertEqual(log.errors, ['E037a'])
+        log.clear()
+        self.assertFalse(iv.check_id(""))
+        self.assertEqual(log.errors, ['E037a'])
+        log.clear()
+        self.assertFalse(iv.check_id("foo"))
+        self.assertEqual(log.errors, ['E037a'])
+        log.clear()
+        self.assertFalse(iv.check_id("ARK:/12345/abc"))
+        self.assertEqual(log.errors, ['E037a'])
+        log.clear()
+        self.assertFalse(iv.check_id("ark:/12345/abc"))
+        self.assertEqual(log.errors, ['E037a'])
+        log.clear()
+        self.assertFalse(iv.check_id("ark:/12345/abc"))
+        self.assertEqual(log.errors, ['E037a'])
+        log.clear()
+        self.assertFalse(iv.check_id("ark:/12345/abc"))
+        self.assertEqual(log.errors, ['E037a'])
+        log.clear()
+        self.assertFalse(iv.check_id("ark:/12345/abc"))
+        self.assertEqual(log.errors, ['E037a'])
+        # Good cases
+        log.clear()
+        self.assertTrue(iv.check_id("ark:/12345/abc"))
+        self.assertEqual(log.errors, [])
+        log.clear()
+        self.assertTrue(iv.check_id("ark:/12345/abc"))
+        self.assertEqual(log.errors, [])
+
+
+if __name__ == '__main__':
+    unittest.main()
