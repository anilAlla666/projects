--- /dev/null
+++ b/tests/test_url_grader.py
@@ -0,0 +1,36 @@
+from __future__ import absolute_import
+import os
+import unittest
+from w3lib.url import (is_url, safe_url_string, safe_download_url,
+    url_query_parameter, add_or_replace_parameter, url_query_cleaner,
+    file_uri_to_path, parse_data_uri, path_to_file_uri, any_to_uri,
+    urljoin_rfc, canonicalize_url, parse_url)
+from six.moves.urllib.parse import urlparse
+
+
+class TestUrlQueryCleaner(unittest.TestCase):
+    def test_issue_101(self):
+        """Test for https://github.com/scrapy/w3lib/issues/101"""
+
+        # no parameters
+        self.assertEqual(
+            url_query_cleaner('http://domain.tld/', remove=True),
+            'http://domain.tld/'
+        )
+        self.assertEqual(
+            url_query_cleaner('http://domain.tld/', remove=True, unique=False),
+            'http://domain.tld/'
+        )
+
+        # empty parameter
+        self.assertEqual(
+            url_query_cleaner('http://domain.tld/?a=', remove=True),
+            'http://domain.tld/'
+        )
+        self.assertEqual(
+            url_query_cleaner('http://domain.tld/?a=', remove=True, unique=False),
+            'http://domain.tld/'
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
