--- /dev/null
+++ b/tests/test_flake8_gl_codeclimate_grader.py
@@ -0,0 +1,26 @@
+from flake8_gl_codeclimate import GlCodeClimateFormatter
+
+
+def test_format():
+    formatter = GlCodeClimateFormatter()
+
+    issues = [
+        {
+            "code": "WPS123",
+            "filename": "/home/runner/work/awelzel-flake8-gl-codeclimate/awelzel-flake8-gl-codeclimate/tests/data/wps123.py",
+            "line_number": 1,
+            "text": "Found a bug.",
+        },
+    ]
+
+    expected = '[\n\t{\n\t\t"type": "issue",\n\t\t"check_name": "Bug Risk",\n\t\t"description": "Found a bug. [WPS123]",\n\t\t"categories": [\n\t\t\t"bug-risk"\n\t\t],\n\t\t"location": {\n\t\t\t"path": "tests/data/wps123.py",\n\t\t\t"lines": {\n\t\t\t\t"begin": 1,\n\t\t\t\t"end": 1\n\t\t\t}\n\t\t},\n\t\t"fingerprint": "wps123_testsdatawps123py1",\n\t\t"severity": "major"\n\t}\n]'
+
+    assert (
+        formatter.format(issues)
+        == expected
+    )
