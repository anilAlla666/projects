+"""Tests for latexify.codegen.expression_codegen."""
+
+
+from __future__ import annotations
+import ast
+import pytest
+from latexify import ast_utils, exceptions, test_utils
+from latexify.codegen import expression_codegen
+
+
+@pytest.mark.parametrize(
+    "expr,latex",
+    [
+        ("np.exp(x)", r"\exp \mathopen{}\left( x \mathclose{}\right)"),
+        ("np.log(x)", r"\log \mathopen{}\left( x \mathclose{}\right)"),
+        ("np.sqrt(x)", r"\sqrt{x}"),
+        ("np.arccos(x)", r"\arccos \mathopen{}\left( x \mathclose{}\right)"),
+        ("np.sinh(x)", r"\sinh \mathopen{}\left( x \mathclose{}\right)"),
+        ("np.tanh(x)", r"\tanh \mathopen{}\left( x \mathclose{}\right)"),
+        ("np.log(x**2)", r"\log \mathopen{}\left( x^{2} \mathclose{}\right)"),
+        (
+            "np.log(np.sqrt(x))",
+            r"\log \mathopen{}\left( \sqrt{x} \mathclose{}\right)",
+        ),
+        (
+            "np.log(x/y)",
+            r"\log \mathopen{}\left( \frac{x}{y} \mathclose{}\right)",
+        ),
+        (
+            "np.log(x+y)",
+            r"\log \mathopen{}\left( x + y \mathclose{}\right)",
+        ),
+        (
+            "np.log((x/y)*z)",
+            r"\log \mathopen{}\left( \frac{x}{y} z \mathclose{}\right)",
+        ),
+    ],
+)
+def test_visit_call(expr: str, latex: str) -> None:
+    node = ast_utils.parse_expr(expr)
+    assert isinstance(node, ast.Call)
+    assert expression_codegen.ExpressionCodegen().visit(node) == latex
