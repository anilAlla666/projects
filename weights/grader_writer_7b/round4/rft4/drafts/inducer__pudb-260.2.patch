--- /dev/null
+++ b/tests/test_ui_tools_grader.py
@@ -0,0 +1,15 @@
+import pytest
+from pudb.ui_tools import make_canvas
+
+
+def test_make_canvas():
+    txt = ['foo', 'bar']
+    attr = [[('black', 1)], [('black', 1)]]
+    res = make_canvas(txt, attr, 1)
+    assert len(res.text[0]) == 1
+    assert len(res.attr[0]) == 1
+    assert len(res.cs[0]) == 1
+
+
+if __name__ == "__main__":
+    pytest.main()
