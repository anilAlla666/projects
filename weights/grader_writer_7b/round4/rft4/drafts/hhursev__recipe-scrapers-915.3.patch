+import unittest
+from recipe_scrapers._utils import get_minutes
+
+
+class TestUtils(unittest.TestCase):
+    def test_get_minutes_handles_pá_pum(self):
+        text = "Pá-Pum"
+        self.assertIsNone(get_minutes(text))
+
+    iso8601_fixtures = {
+        "PT1H": 60,
+        "PT20M": 20,
+        "PT2H10M": 130,
+        "PT0H9M30S": 10,
+    }
+
+    def test_get_minutes_handles_iso8601(self):
+        for text, expected_minutes in self.iso8601_fixtures.items():
+            with self.subTest(text=text):
+                self.assertEqual(expected_minutes, get_minutes(text))
