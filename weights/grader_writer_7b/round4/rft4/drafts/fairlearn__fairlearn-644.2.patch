+
+def test_get_labels_for_confusion_matrix_single_value_array_regression():
+    # https://github.com/fairlearn/fairlearn/issues/577
+    # This was an attempt to break the method when passed a single value array.
+    # It failed.
+    y_true = np.array([1.0])
