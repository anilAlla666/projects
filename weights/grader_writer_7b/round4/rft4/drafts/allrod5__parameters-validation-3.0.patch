--- /dev/null
+++ b/test/test_validate_parameters_decorator_grader.py
@@ -0,0 +1,137 @@
+import pytest
+from pytest import fixture
+from parameters_validation import validate_parameters, non_blank, non_empty, \
+    no_whitespaces
+
+
+@validate_parameters
+def no_validations_function(a: str, b, *, c: dict, d):
+    pass
+
+
+@validate_parameters
+def positional_args_validations_function(a: non_blank(str), b, *, c: dict, d):
+    pass
+
+
+@validate_parameters
+def keyword_args_validations_function(a: str, b, *, c: non_empty(dict), d):
+    pass
+
+
+@validate_parameters
+def args_validations_function(a: non_blank(str), b, *, c: non_empty(dict), d):
+    pass
+
+
+@validate_parameters
+def multiple_validations_function(a: no_whitespaces(non_empty(str))):
+    pass
+
+
+class DecoratedMethods:
+    @validate_parameters
+    def no_validations_method(self, a: str, b, *, c: dict, d):
+        pass
+
+    @staticmethod
+    @validate_parameters
+    def no_validations_staticmethod(a: str, b, *, c: dict, d):
+        pass
+
+    @validate_parameters
+    def positional_args_validations_method(self, a: non_blank(str), b, *, c: dict, d):
+        pass
+
+    @staticmethod
+    @validate_parameters
+    def positional_args_validations_staticmethod(a: non_blank(str), b, *, c: dict, d):
+        pass
+
+    @validate_parameters
+    def keyword_args_validations_method(self, a: str, b, *, c: non_empty(dict), d):
+        pass
+
+    @staticmethod
+    @validate_parameters
+    def keyword_args_validations_staticmethod(a: str, b, *, c: non_empty(dict), d):
+        pass
+
+    @validate_parameters
+    def args_validations_method(self, a: non_blank(str), b, *, c: non_empty(dict), d):
+        pass
+
+    @staticmethod
+    @validate_parameters
+    def args_validations_staticmethod(a: non_blank(str), b, *, c: non_empty(dict), d):
+        pass
+
+    @validate_parameters
+    def multiple_validations_method(self, a: no_whitespaces(non_empty(str))):
+        pass
+
+    @staticmethod
+    @validate_parameters
+    def multiple_validations_staticmethod(a: no_whitespaces(non_empty(str))):
+        pass
+
+
+class TestValidateParametersDecoratorSuccess:
+    @fixture(autouse=True)
+    def _decorated_methods_fixture(self):
+        self.decorate_methods_instance = DecoratedMethods()
+
+    def test_no_validations_function_call(self):
+        assert no_validations_function("a", "b", c={"key": "value"}, d="d")
+
+    def test_positional_args_validations_function_call(self):
+        assert positional_args_validations_function("a", "b", c={"key": "value"}, d="d")
+
+    def test_keyword_args_validations_function_call(self):
+        assert keyword_args_validations_function("a", "b", c={"key": "value"}, d="d")
+
+    def test_args_validations_function_call(self):
+        assert args_validations_function("a", "b", c={"key": "value"}, d="d")
+        assert args_validations_function("_", "b", c={"key": "value"}, d="d")
+        assert args_validations_function("a", "b", c={1: 1}, d="d")
+
+    def test_multiple_validations_function_call(self):
+        assert multiple_validations_function("a")
+
+    def test_no_validations_method_call(self):
+        self.decorate_methods_instance.no_validations_method("a", "b", c={"key": "value"}, d="d")
+
+    def test_no_validations_staticmethod_call(self):
+        DecoratedMethods.no_validations_staticmethod("a", "b", c={"key": "value"}, d="d")
+
+    def test_positional_args_validations_method_call(self):
+        self.decorate_methods_instance.positional_args_validations_method("a", "b", c={"key": "value"}, d="d")
+
+    def test_positional_args_validations_staticmethod_call(self):
+        DecoratedMethods.positional_args_validations_staticmethod("a", "b", c={"key": "value"}, d="d")
+
+    def test_keyword_args_validations_method_call(self):
+        self.decorate_methods_instance.keyword_args_validations_method("a", "b", c={"key": "value"}, d="d")
+
+    def test_keyword_args_validations_staticmethod_call(self):
+        DecoratedMethods.keyword_args_validations_staticmethod("a", "b", c={"key": "value"}, d="d")
+
+    def test_args_validations_method_call(self):
+        self.decorate_methods_instance.args_validations_method("a", "b", c={"key": "value"}, d="d")
+        self.decorate_methods_instance.args_validations_method("_", "b", c={"key": "value"}, d="d")
+        self.decorate_methods_instance.args_validations_method("a", "b", c={1: 1}, d="d")
+
+    def test_args_validations_staticmethod_call(self):
+        DecoratedMethods.args_validations_staticmethod("a", "b", c={"key": "value"}, d="d")
+        DecoratedMethods.args_validations_staticmethod("_", "b", c={"key": "value"}, d="d")
+        DecoratedMethods.args_validations_staticmethod("a", "b", c={1: 1}, d="d")
+
+    def test_multiple_validations_method_call(self):
+        self.decorate_methods_instance.multiple_validations_method("a")
+
+    def test_multiple_validations_staticmethod_call(self):
+        DecoratedMethods.multiple_validations_staticmethod("a")
