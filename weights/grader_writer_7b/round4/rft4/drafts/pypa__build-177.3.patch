+from __future__ import unicode_literals
+import copy
+import os
+import sys
+import typing
+import pep517.wrappers
+import pytest
+import build
+
+
+if sys.version_info >= (3, 8):  # pragma: no cover
+    import email
+    from importlib import metadata as importlib_metadata
+
+    email_message_from_string = email.message_from_string
+else:  # pragma: no cover
+    import importlib_metadata
+
+    email_message_from_string = importlib_metadata._compat.email_message_from_string
+
+
+if sys.version_info >= (3,):  # pragma: no cover
+    build_open_owner = 'builtins'
+else:  # pragma: no cover
+    build_open_owner = 'build'
+    FileNotFoundError = IOError
+    PermissionError = OSError
+
+
+DUMMY_METADATA = """
+Version: 1.0.0
+Provides-Extra: some_extra
+""".strip()
+
+
+DEFAULT_BACKEND = {
+    'build-backend': 'setuptools.build_meta:__legacy__',
+    'requires': ['setuptools', 'wheel'],
+}
+
+
+@pytest.fixture
+def test_missing_build_backend():
+    path = os.path.join(os.path.dirname(__file__), 'projects', 'missing-build-backend')
+    return path
+
+
+def test_missing_build_backend_raises_exception(test_missing_build_backend):
+    with pytest.raises(build.BuildException):
+        build.ProjectBuilder(test_missing_build_backend)
+
+
+def test_missing_build_backend_adds_default(test_missing_build_backend):
+    builder = build.ProjectBuilder(test_missing_build_backend)
+    assert builder._build_system == DEFAULT_BACKEND
