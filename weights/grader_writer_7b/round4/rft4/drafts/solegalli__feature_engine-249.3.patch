@@ -0,0 +1,131 @@
+import pandas as pd
+import pytest
+from feature_engine.creation import MathematicalCombination
+
+
+def test_ignore_null_values_false():
+    df = pd.DataFrame({"A": [1, 2, 3], "B": [4, 5, 6]})
+
+    X = MathematicalCombination(
+        variables_to_combine=["A", "B"],
+        math_operations=["sum"],
+        ignore_null=False,
+    ).fit_transform(df)
+
+    expected_df = pd.DataFrame(
+        {"A": [1, 2, 3], "B": [4, 5, 6], "sum_A-B": [5, 7, 9]}
+    )
+
+    assert X.equals(expected_df)
+
+
+def test_ignore_null_values_true():
+    df = pd.DataFrame(
+        {"A": [1, 2, 3], "B": [None, 5, 6], "C": [None, None, None]}
+    )
+
+    X = MathematicalCombination(
+        variables_to_combine=["A", "B", "C"],
+        math_operations=["sum"],
+        ignore_null=True,
+    ).fit_transform(df)
+
+    expected_df = pd.DataFrame(
+        {
+            "A": [1, 2, 3],
+            "B": [None, 5, 6],
+            "C": [None, None, None],
+            "sum_A-B-C": [None, 7.0, 9.0],
+        }
+    )
+
+    assert X.equals(expected_df)
+
+
+def test_ignore_null_values_true_and_nan_in_result():
+    df = pd.DataFrame({"A": [1, 2, 3], "B": [None, 5, 6]})
+
+    X = MathematicalCombination(
+        variables_to_combine=["A", "B"],
+        math_operations=["sum"],
+        ignore_null=True,
+    ).fit_transform(df)
+
+    expected_df = pd.DataFrame(
+        {"A": [1, 2, 3], "B": [None, 5, 6], "sum_A-B": [None, 7.0, 9.0]}
+    )
+
+    assert X.equals(expected_df)
+
+
+@pytest.mark.parametrize("ignore_null", [True, False])
+def test_raise_value_error_for_non_numerical_columns(ignore_null):
+    df = pd.DataFrame(
+        {
+            "A": [1, 2, 3],
+            "B": [None, 5, 6],
+            "C": ["a", "b", "c"],
+            "D": [1, 2, 3],
+        }
+    )
+
+    transformer = MathematicalCombination(
+        variables_to_combine=["A", "B", "C", "D"],
+        math_operations=["sum"],
+        ignore_null=ignore_null,
+    )
+
+    with pytest.raises(ValueError):
+        transformer.fit_transform(df)
+
+
+def test_ignore_null_values_with_new_vars_names():
+    df = pd.DataFrame({"A": [1, 2, 3], "B": [None, 5, 6], "C": [None, None, None]})
+
+    X = MathematicalCombination(
+        variables_to_combine=["A", "B", "C"],
+        math_operations=["sum"],
+        new_variables_names=["var_sum_AB_C"],
+        ignore_null=True,
+    ).fit_transform(df)
+
+    expected_df = pd.DataFrame(
+        {
+            "A": [1, 2, 3],
+            "B": [None, 5, 6],
+            "C": [None, None, None],
+            "var_sum_AB_C": [None, 7.0, 9.0],
+        }
+    )
+
+    assert X.equals(expected_df)
+
+
+def test_raise_value_error_when_new_var_name_not_entered():
+    df = pd.DataFrame({"A": [1, 2, 3], "B": [None, 5, 6], "C": [None, None, None]})
+
+    with pytest.raises(ValueError):
+        MathematicalCombination(
+            variables_to_combine=["A", "B", "C"],
+            math_operations=["sum"],
+            new_variables_names=["var_sum_AB_C"],
+            ignore_null=True,
+        ).fit_transform(df)
+
+
+def test_ignore_null_values_with_new_vars_names_and_nan_in_result():
+    df = pd.DataFrame({"A": [1, 2, 3], "B": [None, 5, 6]})
+
+    X = MathematicalCombination(
+        variables_to_combine=["A", "B"],
+        math_operations=["sum"],
+        new_variables_names=["var_sum_AB"],
+        ignore_null=True,
+    ).fit_transform(df)
+
+    expected_df = pd.DataFrame(
+        {"A": [1, 2, 3], "B": [None, 5, 6], "var_sum_AB": [None, 7.0, 9.0]}
+    )
+
+    assert X.equals(expected_df)
