--- /dev/null
+++ b/tests/test_show_versions_grader.py
@@ -0,0 +1,24 @@
+import skhep
+
+
+def test_show_versions(capsys):
+    skhep.show_versions()
+    captured = capsys.readouterr()
+
+    assert "Python" in captured.out
+    assert "machine" in captured.out
+    assert "executable" in captured.out
+    assert "scipy" in captured.out
+    assert "setuptools" in captured.out
+    assert "skhep" in captured.out
+    assert "hist" in captured.out
+    assert "decaylanguage" in captured.out
+    assert "hepunits" in captured.out
+    assert "hepstats" in captured.out
+    assert "histoprint" in captured.out
+    assert "iminuit" in captured.out
+    assert "pandas" in captured.out
+    assert "boost_histogram" in captured.out
+    assert "mplhep" in captured.out
+    assert "particle" in captured.out
+    assert "pylhe" in captured.out
+    assert "resample" in captured.out
+    assert "uproot" in captured.out
+    assert "vector" in captured.out
