+"""The Test file for The New Parser (MatchResult Classes)."""
+
+
+import pytest
+from sqlfluff.parser.match import MatchResult
+from sqlfluff.parser import RawSegment, FilePositionMarker
+
+
+@pytest.fixture(scope="module")
+def raw_seg():
+    """Construct a raw segment as a fixture."""
+    fp = FilePositionMarker.from_fresh().advance_by('abc')
+    return RawSegment('foobar', fp)
+
+
+input_funcs = [
+    lambda x: (x,),               # tuple
+    lambda x: [x],                      # list
+    lambda x: x,                        # segment
+    lambda x: (elem for elem in [x])    # generator
+]
+
+
+def test__parser__match_concat_with_empty():
+    """Test concatenation with empty."""
+    m1 = MatchResult.from_matched([])
+    m2 = MatchResult.from_matched(['foo'])
+    m3 = m1 + m2
+    assert len(m3) == 1
+    assert m3.raws() == ['foo']
+
+
+def test__parser__match_concat_with_mixed():
+    """Test concatenation with mixed results."""
+    m1 = MatchResult.from_matched(['foo'])
+    m2 = MatchResult.from_unmatched('bar')
+    m3 = m1 + m2
+    assert len(m3) == 2
+    assert m3.raws() == ['foo', 'bar']
+
+
+def test__parser__match_concat_with_unmatched():
+    """Test concatenation with unmatched."""
+    m1 = MatchResult.from_matched(['foo'])
+    m2 = MatchResult.from_unmatched('bar')
+    m3 = m1 + m2
+    assert len(m3) == 2
+    assert m3.raws() == ['foo', 'bar']
+
+
+def test__parser__match_concat_with_unmatched_and_matched():
+    """Test concatenation with unmatched and matched."""
+    m1 = MatchResult.from_matched(['foo'])
+    m2 = MatchResult.from_unmatched('bar')
+    m3 = MatchResult.from_matched(['baz'])
+    m4 = m1 + m2 + m3
+    assert len(m4) == 3
+    assert m4.raws() == ['foo', 'bar', 'baz']
