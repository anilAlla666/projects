@@ -0,0 +1,37 @@
+import pytest
+import numpydoc.validate
+import numpydoc.tests
+
+
+validate_one = numpydoc.validate.validate
+
+
+class TestValidateGoodDocstrings:
+    """
+    Class containing docstrings that are valid.
+    """
+
+    def _import_path(self, klass=None, func=None):
+        return "numpydoc.tests.test_validate.TestValidateGoodDocstrings." + (
+            "" if func is None else func + (
+                "" if klass is None else "(" + klass + ")"
+            )
+        )
+
+    @pytest.mark.parametrize(
+        "klass, func, msgs",
+        [
+            ("BadGenericDocStrings", "plot", tuple()),
+            ("BadGenericDocStrings", "one_liner", tuple()),
+            ("GoodDocStrings", "one_liner", tuple()),
+            ("GoodDocStrings", "plot", tuple()),
+        ],
+    )
+    def test_good_docstrings(self, klass, func, msgs):
+        result = validate_one(self._import_path(klass=klass, func=func))
+        for msg in msgs:
+            assert msg in " ".join(err[1] for err in result["errors"])
+
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main()
