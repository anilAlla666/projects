+import unittest
+from mtgjson5.classes import MtgjsonCardObject
+
+
+class TestMtgjsonCard(unittest.TestCase):
+    def test_sorting(self):
+        """
+        Tests that sorting is done properly
+        :return: nothing
+        """
+        # Arrange
+        cards = [
+            MtgjsonCardObject(number="1"),
+            MtgjsonCardObject(number="10"),
+            MtgjsonCardObject(number="0"),
+        ]
+
+        # Assert
+        self.assertEqual(cards[0].number, "0")
