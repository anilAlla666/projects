+import numpy as np
+import pytest
+import pyvista as pv
+
+
+@pytest.fixture
+def tiny_rectilinear():
+    xrng = np.linspace(0, 3, 4)
+    yrng = np.linspace(0, 3, 5)
+    zrng = np.linspace(0, 3, 6)
+    return pv.RectilinearGrid(xrng, yrng, zrng)
+
+
+def test_to_tetrahedral_pass_cell_data(tiny_rectilinear):
+    data = np.empty(tiny_rectilinear.n_cells, dtype=float)
+    data[:] = np.random.random(data.size)
+    tiny_rectilinear['data'] = data
+    tet_grid = tiny_rectilinear.to_tetrahedra(pass_cell_data=True)
+    assert np.allclose(tet_grid["data"], data[tet_grid.cell_data.active_scalars])
+
+
+def test_to_tetrahedral_pass_cell_data_false(tiny_rectilinear):
+    data = np.empty(tiny_rectilinear.n_cells, dtype=float)
+    data[:] = np.random.random(data.size)
+    tiny_rectilinear['data'] = data
+    tet_grid = tiny_rectilinear.to_tetrahedra(pass_cell_data=False)
+    assert not hasattr(tet_grid, "data")
+
+
+def test_to_tetrahedral_pass_cell_data_invalid(tiny_rectilinear):
+    with pytest.raises(ValueError, match='pass_cell_data'):
+        tiny_rectilinear.to_tetrahedra(pass_cell_data="invalid")
