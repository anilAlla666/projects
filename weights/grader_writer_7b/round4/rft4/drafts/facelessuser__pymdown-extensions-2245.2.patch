@@ -0,0 +1,11 @@
+import unittest
+from markdown.extensions.keys import KeysPattern
+
+
+class TestKeys(unittest.TestCase):
+    def test_escaped_url(self):
+        p = KeysPattern(
+            '(.*?)',
+            {'separator': '', 'strict': True, 'class': '', 'camel_case': False},
+            {}
+        )
+        assert p.handleMatch(p.re.match('http://example.com/++'), '') == ('http://example.com/++', 0, 20)
