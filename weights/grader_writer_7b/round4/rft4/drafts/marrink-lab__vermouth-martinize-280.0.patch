--- /dev/null
+++ b/tests/test_canonicalize_modifications_grader.py
@@ -0,0 +1,58 @@
+import pytest
+from vermouth.molecule import Molecule
+from vermouth.processors.canonicalize_modifications import (
+    allowed_ptms, canonicalize_modifications, identify_ptms,
+)
+
+
+def test_identify_ptms_no_match():
+    """Test that we raise an error when no matches are found."""
+    ptms = [
+        {'name': 'A', 'graph': Molecule()},
+        {'name': 'B', 'graph': Molecule()},
+    ]
+    res = Molecule()
+    res.add_node({'atomname': 'O'})
+    res.add_node({'atomname': 'H'})
+    res.add_node({'atomname': 'C'})
+
+    with pytest.raises(ValueError, match=r"No valid modification"):
+        identify_ptms(res, ptms, [('A', {0: 0}), ('B', {1: 1})])
+
+
+def test_allowed_ptms_all_unrecognized():
+    """Test that allowed_ptms returns an empty list when there are no recognized
+    PTMs."""
+    molecule = Molecule()
+    molecule.add_node({
+        'atomname': 'O',
+        'resname': 'XXX',
+        'resid': '1',
+    })
+    assert allowed_ptms(molecule, [], []) == []
+
+
+def test_allowed_ptms_some_recognized():
+    """Test that allowed_ptms works as expected when some of the PTMs are
+    recognized."""
+    molecule = Molecule()
+    molecule.add_node({
+        'atomname': 'O',
+        'resname': 'XXX',
+        'resid': '1',
+    })
+    molecule.add_node({
+        'atomname': 'H',
+        'resname': 'XXX',
+        'resid': '1',
+    })
+    molecule.add_node({
+        'atomname': 'C',
+        'resname': 'XXX',
+        'resid': '1',
+    })
+    ptm = {
+        'name': 'test',
+        'graph': Molecule(),
+    }
+    assert allowed_ptms(molecule, [], [ptm]) == [[ptm]]
