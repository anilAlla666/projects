+    assert_date_equal,
+)
+
+
+def test_from_iso_datetime_with_Z():
+    # see https://github.com/marshmallow-code/marshmallow/issues/1262
+    d = dt.datetime.now(central)
+    formatted = d.isoformat() + 'Z'
+    result = from_iso(formatted)
+    assert type(result) == dt.datetime
+    assert_datetime_equal(result, d)
+    if utils.dateutil_available:
+        # Note a naive datetime
