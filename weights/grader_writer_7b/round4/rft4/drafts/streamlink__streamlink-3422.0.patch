+import datetime
+import os.path
+import tempfile
+import unittest
+from shutil import rmtree
+from unittest.mock import patch
+import streamlink.cache
+
+
+class TestCache(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp("streamlink-test")
+
+        streamlink.cache.cache_dir = self.tmp_dir
+        self.cache = streamlink.cache.Cache("cache.json")
+
+    def tearDown(self):
+        rmtree(self.tmp_dir)
+
+    @patch('time.time', return_value=1613888944.9266083)
+    def test_expired_at_before(self, mock_time):
+        self.cache.set("value", 10, expires_at=datetime.datetime.fromtimestamp(mock_time - 20))
+        self.assertEqual(None, self.cache.get("value"))
+
+    @patch('time.time', return_value=1613888944.9266083)
+    def test_expired_at_after(self, mock_time):
+        self.cache.set("value", 10, expires_at=datetime.datetime.fromtimestamp(mock_time + 20))
+        self.assertEqual(10, self.cache.get("value"))
