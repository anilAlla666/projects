+from __future__ import absolute_import, division, print_function
+import sys
+import six
+import pytest
+from . import var_view
+
+
+def test_make_canvas_unicode():
+    u = u'你好，世界！'
+    if sys.version_info[0] == 2:
+        u = unicode(u)
+    var_view.make_canvas([u], [([(u'attr', 5)], 5)])
+
+
+def test_make_canvas_bytes():
+    b = b'\x00\xfe\xff'
+    var_view.make_canvas([b], [([(u'attr', 5)], 5)])
