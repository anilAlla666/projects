+"""
+Test the ``text_to_num`` library.
+"""
+
+
+from unittest import TestCase
+from text_to_num import alpha2digit, text2num
+
+
+class TestTextToNumZH(TestCase):
+    def test_alpha2digit(self):
+        source = "前三个位置是最好的。"
+        expected = "前3个位置是最好的。"
+        self.assertEqual(alpha2digit(source, "zh"), expected)
+
+        source = "另一个例子。"
+        expected = "另一个例子。"
+        self.assertEqual(alpha2digit(source, "zh"), expected)
+
+        source = "我的房子有五层楼和两万四千二百五十五间房间。"
+        expected = "我的房子有5层楼和24255间房间。"
+        self.assertEqual(alpha2digit(source, "zh"), expected)
+
+        source = "五十一亿五千七百八十三万一千二百二十二"
+        expected = "51_578_302"
+        self.assertEqual(alpha2digit(source, "zh"), expected)
+
+        source = "九十九"
+        expected = "99"
+        self.assertEqual(alpha2digit(source, "zh"), expected)
+
+        source = "八十六"
+        expected = "86"
+        self.assertEqual(alpha2digit(source, "zh"), expected)
+
+        source = "一百二十五"
+        expected = "125"
+        self.assertEqual(alpha2digit(source, "zh"), expected)
+
+        source = "零"
+        expected = "0"
+        self.assertEqual(alpha2digit(source, "zh"), expected)
