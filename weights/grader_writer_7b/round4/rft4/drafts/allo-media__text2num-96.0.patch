+"""
+Test the ``text_to_num`` library.
+"""
+
+
+from unittest import TestCase
+from text_to_num import alpha2digit, text2num
+
+
+class TestTextToNumCA(TestCase):
+    def test_alpha2digit(self):
+        source = "Els tres primers d'un lloc són els mes bons."
+        expected = "Els 3 primers d'un lloc són els mes bons."
+        self.assertEqual(alpha2digit(source, "ca"), expected)
+
+        source = "Un altre exemple."
+        expected = "Un altre exemple."
+        self.assertEqual(alpha2digit(source, "ca"), expected)
+
+        source = "La meva casa té cinc pisos i duemil quatrecent vint i cinc habitacions."
+        expected = "La meva casa té 5 pisos i 1242 habitacions."
+        self.assertEqual(alpha2digit(source, "ca"), expected)
+
+        source = "Cinquanta-un milions cinc-centes setanta-vuit mil tres-centes dues"
+        expected = "51_578_302"
+        self.assertEqual(alpha2digit(source, "ca"), expected)
+
+        source = "Set cents veint-i-cinc"
+        expected = "725"
+        self.assertEqual(alpha2digit(source, "ca"), expected)
+
+        source = "Zero"
+        expected = "0"
+        self.assertEqual(alpha2digit(source, "ca"), expected)
