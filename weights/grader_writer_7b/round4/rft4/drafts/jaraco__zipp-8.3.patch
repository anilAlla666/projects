+def add_dirs(zipfile):
+    """
+    Given a writable zipfile, inject directory entries for
+    any directories implied by the presence of children.
+    """
+    names = zipfile.namelist()
+    dirs = set(posixpath.dirname(name) for name in names)
+    for dir in dirs:
+        if dir and dir not in names:
+            zipfile.writestr(dir, b"")
+
+
+class TestPath(unittest.TestCase):
+    def setUp(self):
+        self.tempdirs = []
+
+    def tearDown(self):
+        for td in self.tempdirs:
+            shutil.rmtree(td)
+
+    def create_zipfile(self, *entries):
+        tfd, tmpname = tempfile.mkstemp(suffix=".zip")
+        try:
+            with io.open(tmpname, "w+b") as fp:
+                with zipfile.ZipFile(fp, "w") as zf:
+                    add_dirs(zf)
+                    for entry in entries:
+                        zf.writestr(entry[0], entry[1])
+        finally:
+            os.close(tfd)
+        return tmpname
