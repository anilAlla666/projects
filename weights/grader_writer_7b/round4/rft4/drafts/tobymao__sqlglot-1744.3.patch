+import datetime
+import math
+import unittest
+from sqlglot import alias, exp, parse_one
+
+
+class TestExpressions(unittest.TestCase):
+    maxDiff = None
+
+    def test_str_to_base(self):
+        self.assertEqual(
+            exp.StrToBase("ABC", 16).args["this"].sql(dialect="trino"),
+            "FROM_BASE('ABC', 16)",
+        )
+        self.assertEqual(
+            exp.StrToBase("ABC", 16).args["this"].sql(dialect="postgres"),
+            "TO_NUMBER('ABC', 16)",
+        )
+        self.assertEqual(
+            exp.StrToBase("ABC", 16).args["this"].sql(dialect="snowflake"),
+            "TO_BINARY('ABC', 16)",
+        )
+
+    def test_str_to_base_int(self):
+        self.assertEqual(
+            exp.StrToBaseInt("ABC", 16).args["this"].sql(dialect="trino"),
+            "CAST(FROM_BASE('ABC', 16) AS INT)",
+        )
+        self.assertEqual(
+            exp.StrToBaseInt("ABC", 16).args["this"].sql(dialect="postgres"),
+            "TO_INTEGER('ABC', 16)",
+        )
+        self.assertEqual(
+            exp.StrToBaseInt("ABC", 16).args["this"].sql(dialect="snowflake"),
+            "TO_NUMBER('ABC', 16)",
+        )
+
+    def test_str_to_base_bigint(self):
+        self.assertEqual(
+            exp.StrToBaseBigint("ABC", 16).args["this"].sql(dialect="trino"),
+            "CAST(FROM_BASE('ABC', 16) AS BIGINT)",
+        )
+        self.assertEqual(
+            exp.StrToBaseBigint("ABC", 16).args["this"].sql(dialect="postgres"),
+            "TO_BIGINT('ABC', 16)",
+        )
+        self.assertEqual(
+            exp.StrToBaseBigint("ABC", 16).args["this"].sql(dialect="snowflake"),
+            "TO_NUMBER('ABC', 16)",
+        )
+
+    def test_truncate_date(self):
+        self.assertEqual(
+            exp.TruncateDate(this=exp.identifier("a"), unit=exp.stringliteral("day")).sql(dialect="bigquery"),
+            "TRUNCATE_DATE(`a`, 'DAY')",
+        )
