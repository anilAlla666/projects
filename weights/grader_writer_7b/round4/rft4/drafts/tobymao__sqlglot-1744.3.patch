+from tests.dialects.test_dialect import Validator
+
+
+class TestRedshift(Validator):
+    dialect = "redshift"
+
+    def test_str_to_base(self):
+        self.validate_all(
+            "STR_TO_BASE('ABC', 16)",
+            write={
+                "redshift": "FROM_BASE('ABC', 16)",
+                "trino": "FROM_BASE('ABC', 16)",
+                "snowflake": "TO_BINARY('ABC', 16)",
+                "postgres": "TO_NUMBER('ABC', 16)",
+            },
+        )
+        self.validate_all(
+            "STR_TO_BASE_INT('ABC', 16)",
+            write={
+                "redshift": "CAST(FROM_BASE('ABC', 16) AS INT)",
+                "trino": "CAST(FROM_BASE('ABC', 16) AS INT)",
+                "snowflake": "TO_NUMBER('ABC', 16)",
+                "postgres": "TO_INTEGER('ABC', 16)",
+            },
+        )
