+import pytest
+import numpydoc.validate
+import numpydoc.tests
+
+
+validate_one = numpydoc.validate.validate
+
+
+class TestGoodDocStrings:
+    def test_integer_type(self):
+        """
+        Tests that integer types are correctly recognized
+
+        Parameters
+        ----------
+        int_val : int
+            A test integer
+        """
+        assert validate_one(numpydoc.tests.GoodDocStrings().test_integer_type)[
+            "errors"] == []
+
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main()
