+from importlib.metadata import EntryPoint
+import pytest
+from flask import Flask
+from flask_multipass import Multipass
+from flask_multipass.auth import AuthProvider
+from flask_multipass.core import _MultipassState
+from flask_multipass.exceptions import AuthenticationFailed
+from flask_multipass.identity import IdentityProvider
+from flask_multipass.util import (classproperty, get_state, resolve_provider_type, convert_provider_data, login_view,
+                                  get_canonical_provider_map, validate_provider_map, SupportsMeta, get_provider_base,
+                                  convert_app_data)
+
+
+def test_resolve_provider_type_with_ep_group(mocker):
+    ep_mock = mocker.patch('flask_multipass.util.importlib_entry_points')
+    ep_group_mock = mocker.patch('flask_multipass.util.importlib_metadata_entry_points')
+
+    base_class = AuthProvider
+    expected_type = 'foo'
+    ep_mock.return_value = []
+    ep_group_mock.return_value = []
+
+    assert resolve_provider_type(base_class, expected_type) is None
+
+    ep_mock.assert_called_once_with(name='auth_provider')
+    ep_group_mock.assert_called_once_with(group='flask_multipass.auth_provider', name=expected_type)
+
+
+def test_resolve_provider_type_no_ep_found(mocker):
+    ep_mock = mocker.patch('flask_multipass.util.importlib_entry_points')
+    ep_group_mock = mocker.patch('flask_multipass.util.importlib_metadata_entry_points')
+
+    base_class = AuthProvider
+    expected_type = 'foo'
+    ep_mock.return_value = []
+    ep_group_mock.return_value = []
+
+    assert resolve_provider_type(base_class, expected_type) is None
+
+    ep_mock.assert_called_once_with(name='auth_provider')
+    ep_group_mock.assert_called_once_with(group='flask_multipass.auth_provider', name=expected_type)
+
+
+def test_resolve_provider_type_with_ep(mocker):
+    ep_mock = mocker.patch('flask_multipass.util.importlib_entry_points')
+    ep_group_mock = mocker.patch('flask_multipass.util.importlib_metadata_entry_points')
+
+    base_class = AuthProvider
+    expected_type = 'foo'
+    ep_mock.return_value = [EntryPoint(name='foo', value='flask_multipass.foo')]
+    ep_group_mock.return_value = []
+
+    assert resolve_provider_type(base_class, expected_type) == 'foo'
+
+    ep_mock.assert_called_once_with(name='auth_provider')
+    ep_group_mock.assert_called_once_with(group='flask_multipass.auth_provider', name=expected_type)
+
+
+def test_resolve_provider_type_multiple_eps_found(mocker):
+    ep_mock = mocker.patch('flask_multipass.util.importlib_entry_points')
+    ep_group_mock = mocker.patch('flask_multipass.util.importlib_metadata_entry_points')
+
+    base_class = AuthProvider
+    expected_type = 'foo'
+    ep_mock.return_value = [EntryPoint(name='foo', value='flask_multipass.foo')]
+    ep_group_mock.return_value = [
+        EntryPoint(name='foo', value='flask_multipass.foo'),
+        EntryPoint(name='foo', value='flask_multipass.bar')
+    ]
+
+    with pytest.raises(ValueError):
+        resolve_provider_type(base_class, expected_type)
+
+    ep_mock.assert_called_once_with(name='auth_provider')
+    ep_group_mock.assert_called_once_with(group='flask_multipass.auth_provider', name=expected_type)
+
+
+@pytest.fixture
+def supports_base():
+    class Base(metaclass=SupportsMeta):
+        __support_attrs__ = {'has_foo': 'foo'}
+        has_foo = True
+
+        def foo(self):
+            pass
+
+    return Base
+
+
+def test_importlib_metadata_entrypoints_has_expected_signature(mocker):
+    mock_func = mocker.Mock()
+    mocker.patch('flask_multipass.util.importlib_metadata_entrypoints', mock_func)
+
+    resolve_provider_type(AuthProvider, 'foo')
+
+    mock_func.assert_called_once_with(group='flask_multipass.auth_provider', name='foo')
