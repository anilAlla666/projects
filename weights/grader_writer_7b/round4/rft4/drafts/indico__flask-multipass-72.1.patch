+from collections import OrderedDict
+from unittest.mock import MagicMock, call
+from urllib.parse import urlsplit
+import ldap
+import pytest
+from flask_multipass.exceptions import MultipassException
+from flask_multipass.providers.ldap.globals import current_ldap
+from flask_multipass.providers.ldap.util import LDAPContext, build_search_filter, find_one, ldap_context, to_unicode
+from flask_multipass.util import convert_app_data
+
+
+@pytest.mark.parametrize(('base_dn', 'search_filter', 'data', 'expected'), (
+    ('dc=example,dc=com', '(&(mail=alain.dissoir@mail.com)(objectCategory=user))',
+     {'dn': 'uid=alain,ou=people,dc=example,dc=com', 'mail': ['alain.dissoir@mail.com']},
+     ('uid=alain,ou=people,dc=example,dc=com', 'alain.dissoir@mail.com')),
+    ('dc=example,dc=com', '(&(mail=alain.dissoir@mail.com)(objectCategory=user))',
+     {'dn': 'uid=alain,ou=people,dc=example,dc=com', 'mail': ['alain.dissoir@mail.com', 'other@example.com']},
+     ('uid=alain,ou=people,dc=example,dc=com', 'alain.dissoir@mail.com')),
+    ('dc=example,dc=com', '(&(mail=alain.dissoir@mail.com)(objectCategory=user))',
+     {'dn': 'uid=alain,ou=people,dc=example,dc=com', 'mail': ['other@example.com', 'alain.dissoir@mail.com']},
+     ('uid=alain,ou=people,dc=example,dc=com', 'alain.dissoir@mail.com')),
+))
+def test_find_one(base_dn, search_filter, data, expected):
+    results = [OrderedDict(data)]
+    conn = MagicMock(search_s=magic_search(results), simple_bind_s=lambda *a: None)
+
+    with ldap_context({'uri': 'ldaps://localhost:636', 'bind_dn': '', 'bind_password': ''}) as ctx:
+        ctx.connection = conn
+        assert find_one(ctx, base_dn, search_filter) == expected
+
+    assert len(conn.simple_bind_s.call_args_list) == 1
+    assert len(conn.search_s.call_args_list) == 1
+
+
+def magic_search(results):
+    def wrapper(base_dn, scope, filterstr, attrlist=None, attrsonly=0, sizelimit=0, timelimit=0, count_limit=0,
+                    escape=True):
+        assert isinstance(base_dn, str)
+        assert scope in (ldap.SCOPE_BASE, ldap.SCOPE_ONELEVEL, ldap.SCOPE_SUBTREE)
+        assert isinstance(filterstr, str)
+        assert isinstance(attrlist, list)
+        assert isinstance(attrsonly, int)
+        assert isinstance(sizelimit, int)
+        assert isinstance(timelimit, int)
+        assert isinstance(count_limit, int)
+        assert isinstance(escape, bool)
+        return results
+
+    return wrapper
+
+
+def test_ldap_context_with_tls():
+    settings = {
+        'uri': 'ldaps://ldap.example.com:636',
+        'bind_dn': '',
+        'bind_password': ''
+    }
+
+    with ldap_context(settings) as ctx:
+        assert ctx.settings['uri'] == 'ldaps://ldap.example.com:636'
+        assert ctx.settings['verify_cert']
+        assert ctx.settings['cert_file'] is None
