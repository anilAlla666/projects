+from unittest import TestCase
+from electionguard.words import get_word, get_index_from_word
+
+
+class TestWord(TestCase):
+    def test_get_word_when_out_of_range(self):
+        # Arrange
+        INDEX_BELOW_MIN = -1
+        INDEX_ABOVE_MAX = 4096
+
+        # Act
+        word_min = get_word(INDEX_BELOW_MIN)
+        word_max = get_word(INDEX_ABOVE_MAX)
+
+        # Assert
+        self.assertIsNone(word_min)
+        self.assertIsNone(word_max)
+
+    def test_get_index_from_word_when_bad_input(self):
+        # Arrange
+        BAD_INPUT = "not a word"
+
+        # Act
+        index = get_index_from_word(BAD_INPUT)
+
+        # Assert
+        self.assertIsNone(index)
+
+    def test_get_word_when_null(self):
+        # Arrange
+        WORD_NONE = None
+
+        # Act
+        word = get_word(WORD_NONE)
+
+        # Assert
+        self.assertIsNone(word)
