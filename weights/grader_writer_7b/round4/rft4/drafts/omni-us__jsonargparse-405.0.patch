+def test_choice_validation_when_using_config_file(tmpdir, logger):
+    parser = ArgumentParser(logger=logger)
+    parser.add_argument("--int", type=int, choices=[1, 2])
+    parser.add_argument("--str", type=str, choices=["a", "b"])
+    parser.add_argument("--config", action=ActionConfigFile)
+    config_path = Path(tmpdir.join("config.yaml"))
+    config_path.write_text('{"int": "not_a_number", "str": "not_a_choice"}')
+    args = parser.parse_args([f"--config={config_path}"])
+    assert args.int == "not_a_number"
+    assert args.str == "not_a_choice"
+    logs = get_parse_args_stderr(parser, [f"--config={config_path}"], capture_stderr=True)
+    assert 'Parser key "int": Invalid choice for type int' in logs
+    assert 'Parser key "str": Invalid choice for type str' in logs
