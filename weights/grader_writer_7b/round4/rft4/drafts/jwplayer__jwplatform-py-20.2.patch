+import pytest
+from jwplatform.client import Client
+
+
+def test_client_defaults():
+    """Test default parameter handling when passing None as argument."""
+
+    client = Client('key', 'secret', host=None)
+
+    assert client._host == 'api.jwplatform.com'
+    assert client._port == 80
+    assert client._scheme == 'https'
