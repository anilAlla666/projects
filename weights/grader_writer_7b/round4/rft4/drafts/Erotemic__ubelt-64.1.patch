--- /dev/null
+++ b/tests/test_util_path_grader.py
@@ -0,0 +1,14 @@
+import pytest
+from ubelt import util_path
+
+
+def test_ensuredir_verbose():
+    import ubelt as ub
+    cache_dpath = ub.ensure_app_cache_dir('ubelt')
+    dpath = ub.join(cache_dpath, 'test_ensuredir_verbose')
+    if ub.exists(dpath):
+        ub.delete(dpath)
+    assert not ub.exists(dpath)
+    ub.ensuredir(dpath, verbose=2)
+    assert ub.exists(dpath)
+    ub.delete(dpath)
