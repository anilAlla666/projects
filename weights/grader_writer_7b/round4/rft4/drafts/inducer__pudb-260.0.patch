+import os
+from unittest.mock import patch
+
+
+try:
+    from StringIO import StringIO
+except ImportError:
+    from io import StringIO
+
+
+import pytest
+from urwid import Text, Columns, AttrMap
+from pudb.var_view import VarView
+from pudb.ui_tools import make_canvas
+
+
+def test_make_canvas_width():
+    """
+    Test make_canvas width handling.
+    """
+    # This will cause make_canvas to raise an exception if the bug is present
+    txt = ["你好"]
+    attr = [[('default', 2)]]
+    maxcol = 1
+
+    canvas = make_canvas(txt, attr, maxcol)
+
+    assert canvas.width(maxcol=maxcol) == 2
+    assert canvas.get_text() == [("你好", 2)]
+
+
+@pytest.fixture
+def varview(monkeypatch):
+    monkeypatch.setattr(os, 'get_terminal_size', lambda *x: (80, 24))
+    return VarView()
+
+
+def test_unicode(varview):
+    """Test that unicode values don't cause exceptions."""
+    varview.set_values([{"name": "foo", "value": u"\u00e4"}])
+    varview.body.show_top_idx(0)
+    varview.body.move_cursor_to(0)
+    varview.show_value(0)
