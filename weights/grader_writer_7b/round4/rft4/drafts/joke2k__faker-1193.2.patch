+class TestRuRU(unittest.TestCase):
+    """ Tests person in the ru_RU locale """
+
+    def setUp(self):
+        self.fake = Faker('ru_RU')
+        Faker.seed(0)
+
+    def test_language_name(self):
+        lang = self.fake.language_name()
+        assert lang in RuProvider.languages
