+@patch.object(Server, '_handle_exception')
+class TestHandleException(unittest.TestCase):
+    def setUp(self):
+        self.server = Server(None)
+        self.server.session = Mock()
+        self.server.session.host_name = 'example.com'
+
+    def test_handle_exception(self, mock_handle_exception):
+        exception = RuntimeError()
+        self.server.handle_exception(exception)
+        mock_handle_exception.assert_called_once_with(exception)
+
+    def test_handle_exception_raises_runtime_error(self, mock_handle_exception):
+        exception = RuntimeError()
+        mock_handle_exception.side_effect = exception
+        self.assertRaises(RuntimeError, self.server.handle_exception, exception)
+
+    def test_handle_exception_returns_none(self, mock_handle_exception):
+        mock_handle_exception.return_value = None
+        self.assertIsNone(self.server.handle_exception(Exception()))
+
+
+class SinkController(Controller):
+    def factory(self):
+        return Server(self.handler, enable_SMTPUTF8=True)
