+"""
+Test the base Ellipsoid class.
+"""
+
+
+import warnings
+import pytest
+import numpy as np
+import numpy.testing as npt
+from .. import Ellipsoid, ELLIPSOIDS
+from .utils import normal_gravity_surface
+
+
+ELLIPSOID_NAMES = [e.name for e in ELLIPSOIDS]
+
+
+def test_normal_gravity_negative_height():
+    """
+    Check if warning is issued when computing normal gravity on a point inside
+    the ellipsoid.
+    """
+    ellipsoid = Ellipsoid(
+        name="Ellipsoid_with_negative_height",
+        semimajor_axis=6378136.0,
+        semiminor_axis=6356752.3142,
+        geocentric_grav_const=3986004.418e8,
+        angular_velocity=7292115e-11,
+    )
+    with warnings.catch_warnings(record=True) as warn:
+        # Trigger a warning
+        ellipsoid.normal_gravity(latitude=45, height=-100)
+    assert len(warn) == 1
+    assert issubclass(warn[0].category, UserWarning)
+    assert "Normal gravity can't be computed" in str(warn[0].message)
+    # Check if warning is not triggered when computing normal gravity on the
+    # ellipsoid surface
+    ellipsoid.normal_gravity(latitude=45, height=0)
