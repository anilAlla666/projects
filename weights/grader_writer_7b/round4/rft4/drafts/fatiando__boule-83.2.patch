+"""
+Test the base Sphere class.
+"""
+
+
+import warnings
+import pytest
+import numpy as np
+import numpy.testing as npt
+from .. import Sphere
+
+
+@pytest.fixture
+def sphere():
+    "A spherical ellipsoid"
+    ellipsoid = Sphere(
+        name="unit_sphere",
+        radius=1.0,
+        geocentric_grav_const=2.0,
+        angular_velocity=1.3,
+    )
+    return ellipsoid
+
+
+def test_normal_gravity_negative_height():
+    """
+    Check if warning is issued when computing normal gravity on a point inside
+    the sphere.
+    """
+    sphere = Sphere(
+        name="Sphere_with_negative_height",
+        radius=6378136.0,
+        geocentric_grav_const=3986004.418e8,
+        angular_velocity=7292115e-11,
+    )
+    with warnings.catch_warnings(record=True) as warn:
+        # Trigger a warning
+        sphere.normal_gravity(latitude=45, height=-100)
+    assert len(warn) == 1
+    assert issubclass(warn[0].category, UserWarning)
+    assert "Normal gravity can't be computed" in str(warn[0].message)
+    # Check if warning is not triggered when computing normal gravity on the
+    # sphere surface
+    sphere.normal_gravity(latitude=45, height=0)
