--- /dev/null
+++ b/tests/test_core_grader.py
@@ -0,0 +1,26 @@
+from __future__ import absolute_import, unicode_literals
+
+
+import unittest
+import warnings
+from . import mock_settings
+
+
+try:
+    import psycopg2  # noqa
+except ImportError:
+    psycopg2 = None
+
+
+class TestCore(unittest.TestCase):
+    maxDiff = None
+
+    def setUp(self):
+        self.env = mock_settings.MockEnv()
+
+    def test_custom_db_scheme_is_not_overriden_by_engine(self):
+        with warnings.catch_warnings(record=True) as w:
+            config = self.env.db(
+                "DATABASE_URL", default="custom://localhost/dbname"
+            )
+        self.assertEqual(1, len(w))
+        self.assertIn("Engine not recognized", str(w[-1].message))
+        self.assertEqual(config["ENGINE"], "custom")
