+"""Tests for abstract annotations and annotation results"""
+
+
+import pybryt
+from pybryt.execution.memory_footprint import MemoryFootprint
+from .utils import assert_object_attrs, generate_memory_footprint
+
+
+def test_limits():
+    """
+    """
+    footprint = generate_memory_footprint()
+    pybryt.Annotation.reset_tracked_annotations()
+
+    val1 = footprint.get_value(0)
+    val2 = footprint.get_value(1)
+
+    v1 = pybryt.Value(val1, name="foo", limit=2)
+    v2 = pybryt.Value(val2, name="foo", limit=2)
+    v3 = pybryt.Value(val1, name="foo", limit=2)
+    v4 = pybryt.Value(val2, name="foo", limit=2)
+
+    assert len(pybryt.Annotation.get_tracked_annotations()) == 4
+
+    v1.check(footprint)
+    v2.check(footprint)
+    v3.check(footprint)
+    v4.check(footprint)
+
+    assert len(pybryt.Annotation.get_tracked_annotations()) == 4
+
+    pybryt.Annotation.reset_tracked_annotations()
+    assert len(pybryt.Annotation.get_tracked_annotations()) == 0
+
+    pybryt.Annotation.reset_tracked_annotations(True)
+    assert len(pybryt.Annotation.get_tracked_annotations()) == 0
+
+    v1.check(footprint)
+    v2.check(footprint)
+    v3.check(footprint)
+    v4.check(footprint)
+
+    assert len(pybryt.Annotation.get_tracked_annotations()) == 2
+
+
+def test_group_limits():
+    """
+    """
+    footprint = generate_memory_footprint()
+    pybryt.Annotation.reset_tracked_annotations()
+
+    val1 = footprint.get_value(0)
+    val2 = footprint.get_value(1)
+
+    v1 = pybryt.Value(val1, name="foo", limit=1, group="bar")
+    v2 = pybryt.Value(val2, name="foo", limit=1, group="bar")
+    v3 = pybryt.Value(val1, name="foo", limit=1, group="bar")
+    v4 = pybryt.Value(val2, name="foo", limit=1, group="bar")
+
+    assert len(pybryt.Annotation.get_tracked_annotations()) == 4
+
+    v1.check(footprint)
+    v2.check(footprint)
+    v3.check(footprint)
+    v4.check(footprint)
+
+    assert len(pybryt.Annotation.get_tracked_annotations()) == 2
