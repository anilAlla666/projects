--- /dev/null
+++ b/tests/test_transpilers_grader.py
@@ -0,0 +1,14 @@
+from scim2_filter_parser.transpilers.sql import Transpiler
+
+
+def test_namedtuple_is_returned():
+    transpiler = Transpiler(None)
+    _, params = transpiler.transpile('')
+    assert type(params) == dict
+
+
+def test_dict_has_expected_keys():
+    transpiler = Transpiler(None)
+    _, params = transpiler.transpile('')
+    assert list(params.keys()) == ['0', '1', '2']
