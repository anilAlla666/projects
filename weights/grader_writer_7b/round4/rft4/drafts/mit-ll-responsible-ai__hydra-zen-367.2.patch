+def test_partial_wrappers():
+    class A:
+        def __init__(self, a, b):
+            self.a = a
+            self.b = b
+
+    def wrapper(c):
+        return c + 1
+
+    def wrapper_b(d):
+        return d + 2
+
+    def func(*args, **kwargs):
+        return args, kwargs
+
+    build = builds(A, a=builds(wrapper, 1), b=builds(wrapper_b, 2))
+    build_partials = builds(func, builds(partial(wrapper, 1)), builds(partial(wrapper_b, 2)))
+
+    inst_build = instantiate(build)
+    inst_build_partials = instantiate(build_partials)
+
+    assert inst_build.a == 2 and inst_build.b == 4
+    assert inst_build_partials == ((1,), {"a": 2, "b": 4})
