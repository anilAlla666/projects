+import unittest
+from universe import components
+
+
+class SpeciesComponentTestCase(unittest.TestCase):
+    def test_singularity_name_collision(self):
+        data = {'singular_name': 'test', 'plural_name': 'tests', 'growth_rate': 5}
+        component = components.SpeciesComponent()
+        serialized = component.serialize(data)
+
+        self.assertEqual(serialized, {
+            'singular_name': 'test',
+            'plural_name': 'tests',
+            'growth_rate': 5})
