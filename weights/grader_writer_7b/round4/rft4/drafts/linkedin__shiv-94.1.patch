--- /dev/null
+++ b/test/test_bootstrap_grader.py
@@ -0,0 +1,70 @@
+import os
+import sys
+from contextlib import contextmanager
+from pathlib import Path
+from site import addsitedir
+from code import interact
+from uuid import uuid4
+from zipfile import ZipFile
+import pytest
+from unittest import mock
+from shiv.bootstrap import (
+    _first_sitedir_index,
+    _extend_python_path,
+    import_string,
+    current_zipfile,
+    cache_path,
+    extract_site_packages,
+)
+from shiv.bootstrap.environment import Environment
+from shiv.bootstrap.filelock import FileLock
+
+
+@contextmanager
+def env_var(key, value):
+    os.environ[key] = value
+    yield
+    del os.environ[key]
+
+
+class TestEnvironment:
+    def test_lock(self):
+        with FileLock("lockfile") as f:
+            assert f.is_locked
+
+        assert not f.is_locked
+
+    def test_cache_path(self):
+        root_dir = Path("/tmp/cache")
+        build_id = str(uuid4())
+
+        assert cache_path(root=root_dir, build_id=build_id) == root_dir / f"shiv_{build_id}"
+
+        root_dir = Path("/tmp/cache/")
+        build_id = str(uuid4())
+
+        assert cache_path(root=root_dir, build_id=build_id) == root_dir / f"shiv_{build_id}"
+
+        root_dir = "/tmp/cache"
+        build_id = str(uuid4())
+
+        assert cache_path(root=root_dir, build_id=build_id) == Path(f"/tmp/cache/shiv_{build_id}")
+
+    def test_extract_site_packages_no_root_dir(self, tmpdir):
+        """Ensure we don't blow up when the root dir doesn't exist"""
+        target_path = Path(tmpdir.mkdir("target"))
+        archive = ZipFile(Path(__file__).parent / "data/test.zip")
+        build_id = "abc123"
+
+        with mock.patch.object(FileLock, "__enter__"), \
+             mock.patch.object(FileLock, "__exit__"):
+
+            extract_site_packages(
+                archive=archive,
+                target_path=target_path,
+                compile_pyc=True,
+                compile_workers=0,
+                force=True,
+                root_dir=None,
+                build_id=build_id
+            )
