+import sys
+import warnings
+import numpy as np
+import pytest
+import pyvista
+from pyvista import examples
+from pyvista.core.pointset import PointSet
+from pyvista.utilities.misc import PyVistaDeprecationWarning
+
+
+pointsetmark = pytest.mark.skipif(
+    pyvista.vtk_version_info < (9, 1, 0), reason="Requires VTK>=9.1.0 for a concrete PointSet class"
+)
+
+
+datasets = [
+    pyvista.StructuredGrid(examples.hexbeamfile),
+    pyvista.UniformGrid(examples.hexbeamfile),
+    pyvista.RectilinearGrid(examples.hexbeamfile),
+]
+
+
+def test_PointSet_deep_copy(points):
+    """Test copying"""
+    other = points.deep_copy()
+    assert points is not other
+    assert points.points is not other.points
+    assert np.allclose(points.points, other.points)
+
+
+def test_PointSet_shallow_copy(points):
+    """Test copying"""
+    other = points.shallow_copy()
+    assert points is not other
+    assert points.points is other.points
+
+
+def test_PointSet_copy(points):
+    """Test copying"""
+    other = points.copy(deep=True)
+    assert points is not other
+    assert points.points is not other.points
+    assert np.allclose(points.points, other.points)
+
+
+def test_PointSet_copy_no_copy(points):
+    """Test copying"""
+    other = points.copy(deep=False)
+    assert points is not other
+    assert points.points is other.points
+
+
+def test_PointSet_copy_inplace(points):
+    """Test copying"""
+    other = points.copy()
+    assert points is not other
+    assert points.points is not other.points
+    assert np.allclose(points.points, other.points)
+
+
+def test_PointSet_repr(points):
+    """Test repr printing"""
+    assert '<pyvista.PointSet>' in points.__repr__()
+
+
+def test_PointSet_str(points):
+    """Test str printing"""
+    assert 'PointSet' in points.__str__()
+
+
+def test_PointSet_deep_copy_unexpected(points):
+    """Test copying unexpected types"""
+    points["data"] = [[0.0, 1.0]]
+    with pytest.raises(TypeError, match="unexpected"):
+        points.deep_copy()
+
+
+def test_PointSet_shallow_copy_unexpected(points):
+    """Test copying unexpected types"""
+    points["data"] = [[0.0, 1.0]]
+    with pytest.raises(TypeError, match="unexpected"):
+        points.shallow_copy()
+
+
+def test_PointSet_copy_unexpected(points):
+    """Test copying unexpected types"""
+    points["data"] = [[0.0, 1.0]]
+    with pytest.raises(TypeError, match="unexpected"):
+        points.copy(deep=True)
+
+
+def test_PointSet_copy_no_copy_unexpected(points):
+    """Test copying unexpected types"""
+    points["data"] = [[0.0, 1.0]]
+    with pytest.raises(TypeError, match="unexpected"):
+        points.copy(deep=False)
+
+
+def test_PointSet_copy_inplace_unexpected(points):
+    """Test copying unexpected types"""
+    points["data"] = [[0.0, 1.0]]
+    with pytest.raises(TypeError, match="unexpected"):
+        points.copy()
+
+
+def test_PointSet_clear(points):
+    """Test clearing point data"""
+    points["data"] = [[0.0, 1.0]]
+    points.clear()
+    assert "data" not in points.point_data
