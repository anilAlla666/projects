+import numpy as np
+import pytest
+import pyvista as pv
+
+
+@pytest.fixture
+def tiny_rectilinear():
+    xrng = np.linspace(0, 3, 4)
+    yrng = np.linspace(0, 3, 5)
+    zrng = np.linspace(0, 3, 6)
+    return pv.RectilinearGrid(xrng, yrng, zrng)
+
+
+def test_to_tetrahedral_pass_cell_data(tiny_rectilinear):
+    tiny_rectilinear['cell_data'] = np.arange(tiny_rectilinear.n_cells)
+    tet_grid = tiny_rectilinear.to_tetrahedra(pass_cell_data=True)
+    assert tet_grid.n_cells == tiny_rectilinear.n_cells * 5
+    assert 'cell_data' in tet_grid.cell_data
+    assert len(tet_grid.cell_data['cell_data']) == tet_grid.n_cells
+    assert np.allclose(np.unique(tet_grid.cell_data['cell_data']), np.arange(tiny_rectilinear.n_cells))
+
+
+def test_to_tetrahedral_pass_cell_id(tiny_rectilinear):
+    tet_grid = tiny_rectilinear.to_tetrahedra(pass_cell_ids=True)
+    assert tet_grid.n_cells == tiny_rectilinear.n_cells * 5
+    assert 'cell_ids' in tet_grid.cell_data
+    assert len(tet_grid.cell_data['cell_ids']) == tet_grid.n_cells
+    assert np.allclose(np.unique(tet_grid.cell_data['cell_ids']), np.arange(tiny_rectilinear.n_cells))
