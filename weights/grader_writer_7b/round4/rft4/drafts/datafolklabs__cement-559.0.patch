+import os
+from cement.core.foundation import TestApp
+from cement.ext.ext_configparser import ConfigParserConfigHandler
+
+
+def test_get_boolean():
+    with TestApp() as app:
+        app.config.set('testapp', 'validator_metrics', 'true')
+        assert app.config.getboolean('testapp', 'validator_metrics') == True
+
+        app.config.set('testapp', 'validator_metrics', 'false')
+        assert app.config.getboolean('testapp', 'validator_metrics') == False
+
+        app.config.set('testapp', 'validator_metrics', 'True')
+        assert app.config.getboolean('testapp', 'validator_metrics') == True
+
+        app.config.set('testapp', 'validator_metrics', 'False')
+        assert app.config.getboolean('testapp', 'validator_metrics') == False
+
+        app.config.set('testapp', 'validator_metrics', 'yes')
+        assert app.config.getboolean('testapp', 'validator_metrics') == True
+
+        app.config.set('testapp', 'validator_metrics', 'no')
+        assert app.config.getboolean('testapp', 'validator_metrics') == False
+
+        app.config.set('testapp', 'validator_metrics', '1')
+        assert app.config.getboolean('testapp', 'validator_metrics') == True
