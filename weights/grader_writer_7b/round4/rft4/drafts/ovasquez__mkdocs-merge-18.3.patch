+from pathlib import Path
+from mkdocsmerge.utils import (
+    copy_files, find_files_in_folder, get_relative_paths, read_file_content,
+    write_file_content, update_navs, merge_single_site, run_merge)
+
+
+def test_copy_files(tmpdir):
+    """Verifies copying files works correctly."""
+    root = tmpdir.mkdir("root")
+    subdir = root.mkdir("subdir")
+    subdir.join("file.txt").write("content")
+
+    assert len(find_files_in_folder(root)) == 0
+    copy_files(str(subdir), str(root))
+    assert len(find_files_in_folder(root)) == 1
+    assert read_file_content(Path(root) / "file.txt") == "content"
+
+
+def test_merge_single_site():
+    """Verifies merging of a single site's nav to the global nav's data with unification
+    of the sub-sites with the same site_name"""
+    site_name = 'Projects'
+    # Create original and expected data structures
+    global_nav = [{'Home': 'index.md'},
+                  {'About': 'menu/about.md'},
+                  {site_name: [
+                      {'First': 'projects/first.md'},
+                      {'Second': 'projects/second.md'}
+                  ]}]
+
+    site_nav = [{'Index': 'projects/index.md'}]
+
+    expected = [{'Home': 'index.md'},
+                {'About': 'menu/about.md'},
+                {site_name: [
+                    {'Index': 'projects/index.md'},
+                    {'First': 'projects/first.md'},
+                    {'Second': 'projects/second.md'},
+                ]}]
+
+    merge_single_site(global_nav, site_name, site_nav, True)
+    assert global_nav == expected
