--- /dev/null
+++ b/tests/test_executable_schema_validation_grader.py
@@ -0,0 +1,19 @@
+import pytest
+from ariadne import make_executable_schema
+
+
+def test_executable_schema_creation_errors_if_multiple_bindables_passed_as_list():
+    type_defs = """
+        type Query {
+            test: String!
+        }
+    """
+
+    query_type = type("QueryType", (object,), {"test": lambda *a: "Hello!"})
+
+    with pytest.raises(ValueError):
+        make_executable_schema(
+            type_defs,
+            [query_type],
+            # Should be *query_type
+        )
