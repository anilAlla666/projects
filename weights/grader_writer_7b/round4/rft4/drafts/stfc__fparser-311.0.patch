--- /dev/null
+++ b/src/fparser/two/tests/test_fortran2003_grader.py
@@ -0,0 +1,16 @@
+import pytest
+from fparser.two.Fortran2003 import Type_Declaration_Stmt, SymbolTable
+
+
+def test_no_current_scoping_region():
+    """
+    Tests that we can handle the case where there is no current scoping
+    region when attempting to add a symbol to the symbol table.
+
+    """
+    stmt = Type_Declaration_Stmt("INTEGER :: a")
+    SymbolTable.current_scope = None
+    # This should raise no errors even though there is no current
+    # scoping region.
+    stmt.walk(SymbolTable.add_to_table)
+    # And now set the current scope back so that we don't break things!
+    SymbolTable.current_scope = SymbolTable()
