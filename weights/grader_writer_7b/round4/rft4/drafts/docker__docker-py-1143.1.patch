+class ParseHostTest(base.BaseTestCase):
+    def test_ipv6_address(self):
+        for proto in ('tcp', 'udp'):
+            for url in (
+                '[::1]',
+                '[::1]:8080',
+                '[::1]:8080/path',
+                '[fe80::20c:29ff:fec9:c2db]:8080',
+                '[fe80::20c:29ff:fec9:c2db]:8080/path',
+            ):
+                self.assertEqual(
+                    '{0}://{1}:8080'.format(proto, url),
+                    parse_host('{0}://{1}'.format(proto, url)),
+                )
+        for proto in ('http', 'https'):
+            for url in (
+                '[::1]',
+                '[::1]/path',
+                '[fe80::20c:29ff:fec9:c2db]',
+                '[fe80::20c:29ff:fec9:c2db]/path',
+            ):
+                self.assertEqual(
+                    '{0}://{1}/path'.format(proto, url),
+                    parse_host('{0}://{1}'.format(proto, url)),
+                )
+        for proto in ('unix', 'npipe'):
+            for url in (
+                '[::1]',
+                '[::1]/path',
+                '[fe80::20c:29ff:fec9:c2db]',
+                '[fe80::20c:29ff:fec9:c2db]/path',
+            ):
+                self.assertEqual(
+                    '{0}://{1}'.format(proto, url),
+                    parse_host('{0}://{1}'.format(proto, url)),
+                )
+        for proto in ('tcp', 'udp', 'http', 'https', 'unix', 'npipe'):
+            self.assertEqual(
+                '{0}://[::1]'.format(proto),
+                parse_host('[::1]'),
+            )
+            self.assertEqual(
+                '{0}://[::1]/path'.format(proto),
+                parse_host('[::1]/path'),
+            )
+            self.assertEqual(
+                '{0}://[fe80::20c:29ff:fec9:c2db]'.format(proto),
+                parse_host('[fe80::20c:29ff:fec9:c2db]'),
+            )
+            self.assertEqual(
+                '{0}://[fe80::20c:29ff:fec9:c2db]/path'.format(proto),
+                parse_host('[fe80::20c:29ff:fec9:c2db]/path'),
+            )
+
+    def test_invalid_ipv6_address(self):
+        for proto in ('tcp', 'udp', 'http', 'https', 'unix', 'npipe'):
+            with self.assertRaises(DockerException):
+                parse_host('{0}://[{1}]'.format(proto, 'invalid::ipv6'))
+            with self.assertRaises(DockerException):
+                parse_host('{0}://[{1}]'.format(proto, 'invalid::ipv6/path'))
+
+    def test_invalid_tcp_ports(self):
+        with self.assertRaises(DockerException):
+            parse_host('tcp://:12345')
+        with self.assertRaises(DockerException):
+            parse_host('tcp://0.0.0.0:')
+        with self.assertRaises(DockerException):
+            parse_host('tcp://localhost:')
+        with self.assertRaises(DockerException):
+            parse_host('tcp://[::1]')
+        with self.assertRaises(DockerException):
+            parse_host('tcp://[::1]:')
+        with self.assertRaises(DockerException):
+            parse_host('tcp://[::1]:/')
+        with self.assertRaises(DockerException):
+            parse_host('tcp://[::1]:/path')
+        with self.assertRaises(DockerException):
+            parse_host('tcp://[::1]:invalidport')
+        with self.assertRaises(DockerException):
+            parse_host('tcp://[::1]:invalidport/path')
