+@pytest.mark.parametrize("file_name,expected",
+                         FILE_PATIENT_NAMES,
+                         ids=[fn[0] for fn in FILE_PATIENT_NAMES])
+def test_read_specific_char_set_from_file(file_name, expected):
+    """Test read SpecificCharacterSet from file."""
+    ds = dcmread(get_charset_files(file_name)[0], force=True)
+    charsets = ds.SpecificCharacterSet
+    assert isinstance(charsets, list)
+    assert expected == ds.PatientName
+
+
+class TestCharset:
+    """Run various tests related to charset handling."""
+
+    @staticmethod
+    def setup_class():
+        """Create temporary dicom files for use in tests"""
+        config.datetime_conversion = True
+        config.allow_DS_float = True
+        config.use_none_as_empty_text_VR_value = True
+
+    @staticmethod
+    def teardown_class():
+        """Remove the temp files"""
+        config.datetime_conversion = False
+        config.allow_DS_float = False
+        config.use_none_as_empty_text_VR_value = False
+
+    def test_convert_empty_char_set(self):
+        """Test conversion of empty char set."""
+        assert ["iso8859"] == pydicom.charset.convert_encodings("")
+
+    def test_convert_non_str_char_set(self):
+        """Test conversion of non-string char set."""
+        assert ["iso8859"] == pydicom.charset.convert_encodings(None)
+
+    def test_convert_list_of_strings_char_set(self):
+        """Test conversion of list of strings char set."""
+        assert ["iso8859"] == pydicom.charset.convert_encodings([])
+
+    def test_convert_single_str_char_set(self):
+        """Test conversion of single string char set."""
+        assert ["iso8859"] == pydicom.charset.convert_encodings("")
