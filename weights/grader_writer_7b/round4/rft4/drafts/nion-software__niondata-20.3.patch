+import copy
+import logging
+import random
+import unittest
+import numpy
+from nion.data import Calibration
+from nion.data import Core
+from nion.data import DataAndMetadata
+
+
+class TestCore(unittest.TestCase):
+    def setUp(self):
+        pass
+
+    def tearDown(self):
+        pass
+
+    def test_register_template_returns_offset_relative_to_center_pixel(self):
+        # regression test for https://github.com/nion-software/nionsoftware/issues/1026
+        # the center pixel was used rather than the edge pixel when calculating the offset
+        data = numpy.zeros((100, 100), dtype=numpy.float32)
+        data[25:75, 25:75] = 1
+        data[50, 50] = 2
+        data[50, 51] = 2
+        data[50, 52] = 2
+        image_xdata = DataAndMetadata.new_data_and_metadata(data)
+        template_xdata = DataAndMetadata.new_data_and_metadata(data[25:75, 25:75])
+        ccoeff, max_pos = Core.function_register_template(image_xdata, template_xdata)
+        self.assertAlmostEqual(ccoeff, 1.0, places=1)
+        self.assertAlmostEqual(max_pos[0], 50.5, places=1)
+        self.assertAlmostEqual(max_pos[1], 50.5, places=1)
+
+    def test_shift_can_be_used_with_non_floating_point_image(self):
+        # regression test for https://github.com/nion-software/nionsoftware/issues/1026
+        # shifting could fail for images without floating point values
+        data = numpy.ones((100, 100), dtype=numpy.int)
+        data[50, 50] = 2
+        xdata = DataAndMetadata.new_data_and_metadata(data)
+        shifted_xdata = Core.function_shift(xdata, (-0.5, -0.5))
+        self.assertTrue(numpy.array_equal(shifted_xdata.data, data[1:, 1:]))
+
+
+if __name__ == '__main__':
+    logging.getLogger().setLevel(logging.DEBUG)
+    unittest.main()
