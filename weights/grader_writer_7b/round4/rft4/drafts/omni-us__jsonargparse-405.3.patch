+@pytest.mark.parametrize(
+    ("config", "expected"),
+    [
+        ({"mode": "train"}, "{'mode': 'train'}"),
+        ({"mode": "test"}, "{'mode': 'test'}"),
+        ({"mode": "test"}, "{'mode': 'test'}"),
+        ({"mode": "foo"}, "{'mode': 'foo'}"),
+        ({"mode": "test", "other-mode": "a"}, "{'mode': 'test', 'other-mode': 'a'}"),
+        ({"mode": "test", "other-mode": "b"}, "{'mode': 'test', 'other-mode': 'b'}"),
+        ({"mode": "test", "other-mode": "foo"}, "{'mode': 'test', 'other-mode': 'foo'}"),
+    ],
+)
+def test_choice_with_config(config, expected, parser_with_choice_and_choice_validation):
+    args = parser_with_choice_and_choice_validation.parse_args([f"--config={config}"])
+    assert args.mode == config["mode"]
+    assert args.other_mode == config["other-mode"]
+    assert parser_with_choice_and_choice_validation.dump(args) == expected
+
+
+@pytest.mark.parametrize(("config", "expected"), [("mode": "test"), ("mode": "foo"), ("mode": "test", "other-mode": "a"),])
+def test_choice_with_config_invalid_choice(config, expected, parser_with_choice_and_choice_validation):
+    config_str = json.dumps(config)
+    if expected == "mode":
+        err_msg = f"Parser key \"mode\": {expected}"
+    elif expected == "other-mode":
+        err_msg = f"Parser key \"other-mode\": {expected}"
+    elif expected == "mode":
+        err_msg = f"Parser key \"mode\": {expected}"
+    else:
+        err_msg = f"Parser key \"mode\": {expected}"
+    with pytest.raises(ArgumentError, match=err_msg):
+        parser_with_choice_and_choice_validation.parse_args([f"--config={config_str}"])
+
