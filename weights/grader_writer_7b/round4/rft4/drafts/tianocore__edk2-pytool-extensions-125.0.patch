+import os
+import unittest
+import logging
+import shutil
+import stat
+import tempfile
+import copy
+from edk2toolext.environment import environment_descriptor_files as EDF
+from edk2toolext.environment.extdeptypes.git_dependency import GitDependency
+from edk2toolext.environment import shell_environment
+
+
+test_dir = None
+
+
+uptodate_version = "7fd1a60b01f91b314f59955a4e4d4e80d8edf11d"
+
+
+behind_one_version = "762941318ee16e59dabbacb1b4049eec22f0d303"
+
+
+invalid_version = "762941318ee16e59d123456789049eec22f0d303"
+
+
+hw_json_template = '''
+{
+  "scope": "global",
+  "type": "git",
+  "name": "HelloWorld",
+  "source": "https://github.com/octocat/Hello-World.git",
+  "version": "%s",
+  "flags": []
+}
+'''
+
+
+def prep_workspace():
+    global test_dir
+    # if test temp dir doesn't exist
+    if test_dir is None or not os.path.isdir(test_dir):
+        # create temp dir
+        test_dir = tempfile.mkdtemp(prefix="TestGitDependency_")
+
+
+class TestGitDependency(unittest.TestCase):
+    """Unit test cases for the GitDependency class."""
+
+    TEST_DESCRIPTOR = {
+        "type": "git",
+        "name": "HelloWorld",
+        "source": "https://github.com/octocat/Hello-World.git",
+        "version": "7fd1a60b01f91b314f59955a4e4d4e80d8edf11d",
+        "flags": []
+    }
+
+    def setUp(self):
+        prep_workspace()
+        self.temp_dir = tempfile.TemporaryDirectory(dir=test_dir)
+        self.workspace_dir = os.path.join(self.temp_dir.name, "workspace")
+        self.contents_dir = os.path.join(self.workspace_dir, "contents")
+        self.dependency = GitDependency(copy.deepcopy(TestGitDependency.TEST_DESCRIPTOR))
+        self.dependency.contents_dir = self.contents_dir
+
+    def tearDown(self):
+        self.temp_dir.cleanup()
+
+    def test_fetch_with_missing_contents_dir(self):
+        self.dependency.contents_dir = ""
+        self.dependency.fetch()
+
+        # Make sure no files were fetched
+        self.assertFalse(os.path.exists(os.path.join(self.dependency.contents_dir, self.dependency.name)))
+
+    def test_fetch_with_invalid_contents_dir(self):
+        self.dependency.contents_dir = "/path/to/nowhere"
+        self.dependency.fetch()
+
+        # Make sure no files were fetched
+        self.assertFalse(os.path.exists(os.path.join(self.dependency.contents_dir, self.dependency.name)))
+
+    def test_verify_with_missing_contents_dir(self):
+        self.dependency.contents_dir = ""
+        result = self.dependency.verify(False)
+
+        # Verify failed because contents dir was missing
+        self.assertFalse(result)
+
+    def test_verify_with_invalid_contents_dir(self):
+        self.dependency.contents_dir = "/path/to/nowhere"
+        result = self.dependency.verify(False)
+
+        # Verify failed because contents dir was invalid
+        self.assertFalse(result)
+
+
+class TestGitDependencyUrlPatching(unittest.TestCase):
+    """Unit test cases for the GitDependency class."""
+
+    TEST_DESCRIPTOR = {
+        "type": "git",
+        "name": "HelloWorld",
+        "source": "https://github.com/octocat/Hello-World.git",
+        "version": "7fd1a60b01f91b314f59955a4e4d4e80d8edf11d",
+        "flags": []
+    }
+
+    def setUp(self):
+        self.temp_dir = tempfile.TemporaryDirectory()
+        self.workspace_dir = os.path.join(self.temp_dir.name, "workspace")
+        self.contents_dir = os.path.join(self.workspace_dir, "contents")
+        self.dependency = GitDependency(copy.deepcopy(TestGitDependencyUrlPatching.TEST_DESCRIPTOR))
+        self.dependency.contents_dir = self.contents_dir
+
+    @classmethod
+    def setUpClass(cls):
+        env = shell_environment.GetEnvironment()
+        cls.env_checkpoint = env.checkpoint()
+
+    def tearDown(self):
+        env = shell_environment.GetEnvironment()
+        env.restore_checkpoint(TestGitDependencyUrlPatching.env_checkpoint)
+
+    def test_url_should_not_be_modified_without_env(self):
+        my_test_descriptor = copy.copy(TestGitDependencyUrlPatching.TEST_DESCRIPTOR)
+        # Add the indicator for patching.
+        my_test_descriptor['url_creds_var'] = 'test_creds_var'
+
+        # Initialize the GitDependency object.
+        git_dep = GitDependency(my_test_descriptor)
+
+        # Assert that the URL is identical.
+        self.assertEqual(git_dep.source, my_test_descriptor['source'])
+
+
+if __name__ == '__main__':
+    unittest.main()
