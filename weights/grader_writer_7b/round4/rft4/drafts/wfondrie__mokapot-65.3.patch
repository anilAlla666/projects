--- /dev/null
+++ b/tests/test_confidence_grader.py
@@ -0,0 +1,20 @@
+import numpy as np
+import pytest
+from mokapot import read_csv, Model
+
+
+@pytest.mark.parametrize(
+    ("scores", "expected"),
+    [
+        ([1, 2], [2, 3]),
+        ([-1, -2], [-2, -3]),
+        ([1, 2, 3], [2, 3, 4]),
+        ([-1, -2, -3], [-2, -3, -4]),
+        ([1, 1, 1], [2, 2, 2]),
+        ([-1, -1, -1], [-2, -2, -2]),
+    ],
+)
+def test_grouped_confidence(scaled_scores, scores, expected):
+    scaled_scores = np.array(scaled_scores)
+    assert np.allclose(expected, scores(scaled_scores))
