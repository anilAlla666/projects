+import unittest
+import tlv8
+
+
+class TestTLV8Entry(unittest.TestCase):
+    def test_format_string(self):
+        data = [
+            tlv8.Entry(1, 3.141),
+            tlv8.Entry(2, [
+                tlv8.Entry(3, 'hello'),
+                tlv8.Entry(4, 'world'),
+            ]),
+            tlv8.Entry(1, 2)
+        ]
+        print(tlv8.format_string(data, 0))
+
+    def test_format_string_error_1(self):
+        self.assertRaises(ValueError, tlv8.format_string, {}, 0)
+
+    def test_format_string_error_2(self):
+        self.assertRaises(ValueError, tlv8.format_string, [1], 0)
+
+    def test_format_string_error_3(self):
+        self.assertRaises(ValueError, tlv8.format_string, [], 0)
+
+    def test_create_entry_error(self):
+        self.assertRaises(ValueError, tlv8.Entry, 256, b'', tlv8.DataType.BYTES)
+        self.assertRaises(ValueError, tlv8.Entry, 1, '', tlv8.DataType.BYTES)
+        self.assertRaises(ValueError, tlv8.Entry, 1, b'', tlv8.DataType.INT)
+        self.assertRaises(ValueError, tlv8.Entry, 1, b'', tlv8.DataType.FLOAT)
+        self.assertRaises(ValueError, tlv8.Entry, 1, b'', tlv8.DataType.BOOL)
+        self.assertRaises(ValueError, tlv8.Entry, 1, b'', tlv8.DataType.UINT8)
+        self.assertRaises(ValueError, tlv8.Entry, 1, b'', tlv8.DataType.UINT16)
+        self.assertRaises(ValueError, tlv8.Entry, 1, b'', tlv8.DataType.UINT32)
+        self.assertRaises(ValueError, tlv8.Entry, 1, b'', tlv8.DataType.UINT64)
