+"""Tests for the pyflwdir.dem module."""
+
+
+import pytest
+import numpy as np
+from pyflwdir import dem
+from test_core import test_data
+
+
+parsed, flwdir = test_data[0]
+
+
+idxs_ds, idxs_pit, seq, rank, mv = parsed
+
+
+def test_dem_fill():
+    # example from Wang & Lui (2015)
+    a = np.array(
+        [
+            [15, 15, 14, 15, 12, 6, 12],
+            [14, 13, 10, 12, 15, 17, 15],
+            [15, 15, 9, 11, 8, 15, 15],
+            [16, 17, 8, 16, 15, 7, 5],
+            [19, 18, 19, 18, 17, 15, 14],
+        ],
+        dtype=np.float32,
+    )
+    # NOTE: compared to paper same a_filled, but difference
+    # in flowdir because row instead of col first ..
+    d8 = np.array(
+        [
+            [2, 2, 4, 8, 1, 0, 16],
+            [1, 1, 2, 2, 128, 64, 32],
+            [128, 128, 1, 1, 2, 2, 4],
+            [64, 128, 128, 128, 1, 1, 0],
+            [64, 128, 64, 32, 128, 128, 64],
+        ],
+        dtype=np.uint8,
+    )
+    # test default
+    a2 = a.copy()
+    a2[1:4, 2] = 11  # filled depression
+    a_filled, _d8 = dem.fill_depressions(a2)
+    assert np.all(a_filled == d8)
+    # test with no pits
+    a2 = a.copy()
+    a2[1:4, 2] = 11  # filled depression
+    a_filled, _d8 = dem.fill_depressions(a2, idxs_pit=[1])
+    assert np.all(a_filled == a2)
+    # test with max depth
+    a2 = a.copy()
+    a2[1:4, 2] = 11  # filled depression
+    a_filled, _d8 = dem.fill_depressions(a2, max_depth=1.5)
+    assert np.all(a_filled == d8)
+    # test with connectivity 4
+    a2 = a.copy()
+    a2[1:4, 2] = 11  # filled depression
+    a_filled, _d8 = dem.fill_depressions(a2, connectivity=4)
+    assert np.all(a_filled == d8)
+
+
+def test_slope():
+    elv = np.ones((4, 4))
+    nodata = -9999
+    assert np.all(dem.slope(elv, nodata) == 0)
+    elv.flat[0] == -9999
+    assert np.all(dem.slope(elv, nodata).flat[1:] == 0)
