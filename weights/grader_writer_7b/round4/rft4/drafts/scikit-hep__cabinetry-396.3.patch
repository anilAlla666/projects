+import copy
+import logging
+from unittest import mock
+import numpy as np
+import pyhf
+import pytest
+from cabinetry import model_utils
+from cabinetry.fit.results_containers import FitResults
+
+
+def test_prefit_uncertainties(pyhf_0_7_0, pyhf_0_7_1, pyhf_0_7_2):
+    # check that the function returns an array of zeros for a simple model without
+    # partial constraints
+    model = pyhf_0_7_0.Workspace(
+        {
+            "channels": [
+                {
+                    "binning": [2, 0, 1],
+                    "name": "channel",
+                    "samples": [{"name": "sample", "data": [1, 1]}],
+                }
+            ],
+            "parameters": [],
+            "version": "1.0.0",
+        }
+    ).model()
+    assert model_utils.prefit_uncertainties(model) == np.array([0.0, 0.0])
+
+    # check that the function handles partially fixed parameters correctly
+    # (i.e., it returns zero for fixed parameters even though there is a Gaussian
+    # constraint)
+    model = pyhf_0_7_2.Workspace(
+        {
+            "channels": [
+                {
+                    "binning": [2, 0, 1],
+                    "name": "channel",
+                    "samples": [{"name": "sample", "data": [1, 1]}],
+                }
+            ],
+            "parameters": [{"fixed": True, "indices": [0], "name": "param"}],
+            "version": "1.0.0",
+        }
+    ).model()
+    assert model_utils.prefit_uncertainties(model) == np.array([0.0, 0.0])
