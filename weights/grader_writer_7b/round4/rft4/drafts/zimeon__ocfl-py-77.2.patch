+"""Inventory validator tests."""
+
+
+import json
+import unittest
+from ocfl.inventory_validator import InventoryValidator
+
+
+class TLogger():
+    """Simplified logger to replace ValidationLogger."""
+
+    def __init__(self):
+        """Initialize."""
+        self.clear()
+
+    def error(self, code, **args):  # pylint: disable=unused-argument
+        """Add error code, discard args."""
+        self.errors.append(code)
+
+    def warning(self, code, **args):  # pylint: disable=unused-argument
+        """Add warn code, discard args."""
+        self.warns.append(code)
+
+    def clear(self):
+        """Clear records."""
+        self.errors = []
+        self.warns = []
+
+
+class TestAll(unittest.TestCase):
+    """TestAll class to run tests."""
+
+    def test_id_scheme(self):
+        """Test id scheme."""
+        for ok in ("ARK:123/abc", "urn:123:abc", "urn:123:xyz", "urn:123:xyz:abc", "urn:123:xyz:abc:def", "urn:isbn:123456789"):
+            log = TLogger()
+            iv = InventoryValidator(log=log)
+            iv.id = ok
+            self.assertEqual(log.errors, [])
+            self.assertEqual(log.warns, [])
+            self.assertNotEqual(log.errors, ['W005'])
+            self.assertNotEqual(log.warns, ['W005'])
+        for err in ("urn:123:xyz:abc:def:ghi", "urn:123:xyz:abc:123", "urn:123:xyz:123", "urn:123:xyz:123:abc", "urn:123:xyz:abc:123:ghi"):
+            log = TLogger()
+            iv = InventoryValidator(log=log)
+            iv.id = err
+            self.assertEqual(log.errors, ['E037a'])
+            self.assertEqual(log.warns, [])
+
+
+if __name__ == '__main__':
+    unittest.main()
