+import os
+from cement.core.foundation import TestApp
+from cement.ext.ext_configparser import ConfigParserConfigHandler
+
+
+def test_getboolean():
+    with TestApp() as app:
+        app.config.set('testapp', 'metrics_enabled', 'True')
+        assert app.config.getboolean('testapp', 'metrics_enabled') is True
+
+
+def test_getint():
+    with TestApp() as app:
+        app.config.set('testapp', 'max_threads', '4')
+        assert app.config.getint('testapp', 'max_threads') == 4
+
+
+def test_getfloat():
+    with TestApp() as app:
+        app.config.set('testapp', 'timeout', '4.2')
+        assert app.config.getfloat('testapp', 'timeout') == 4.2
