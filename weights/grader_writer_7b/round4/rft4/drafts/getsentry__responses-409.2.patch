+@responses.activate
+def test_streaming_response_is_added_to_calls():
+    """
+    Regression test for https://github.com/getsentry/responses/issues/431.
+
+    Asserts that passthrough responses don't crash when calling `.start()`
+    """
+    responses.add(responses.GET, 'http://www.example.com/stream',
+                  body=FakeStream(),
+                  stream=True)
+
+    r = requests.get('http://www.example.com/stream')
+
+    assert len(responses.calls) == 1
+
+
+def assert_request_body(resp, expected):
+    assert resp.request.body == expected
