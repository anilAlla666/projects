+@responses.activate
+def test_passthrough_does_not_fail():
+    """
+    Regression test for https://github.com/getsentry/responses/issues/431.
+
+    Asserts that passthrough responses don't crash when calling `.start()`
+    """
+    responses.add_passthru('https://*.google.com')
+
+    def handler(req):
+        return 200, {}, 'OK'
+
+    responses.add(responses.GET, 'https://google.com',
+                  body=handler,
+                  passthrough=False)
+
+    assert len(responses._default_mock._matches) == 2
+
+    responses._default_mock.start()
+
+
+class FakeStream(object):
+    def __init__(self, data=b"hello world"):
+        self.data = data
+        self.closed = False
+
+    def read(self, size=-1):
+        if size == -1:
+            return self.data
+        return self.data[:size]
+
+    def close(self):
+        self.closed = True
+
+    def __iter__(self):
+        return iter([self])
+
+
+def fake_stream_generator(stream, chunk_size=1):
+    while True:
+        data = stream.read(chunk_size)
+        if data:
+            yield data
+        else:
+            break
+
+
+if version_info >= (3, 0):
+    from urllib.parse import quote_plus
+else:
+    from urllib import quote_plus
+
+
+def assert_streaming_response(resp, expected_body, chunk_size=1):
+    assert resp.status_code == 200
+    assert resp.reason == "OK"
+    assert resp.headers["Transfer-Encoding"] == "chunked"
+    assert resp.raw.stream is True
+    assert resp.raw.app_iter is not None
+    assert resp.text == ""
+    assert resp.content == expected_body
+    assert resp.iter_content(chunk_size=chunk_size) == list(fake_stream_generator(BytesIO(expected_body), chunk_size=chunk_size))  # noqa: E501
+
+    for c in resp.iter_lines():
+        assert c.decode('utf-8') in expected_body.split('\n')
+
+
+def assert_headers(resp, expected):
+    for key, value in six.iteritems(expected):
+        assert resp.headers[key] == value
+
