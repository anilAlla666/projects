+def _ensure_url_default_path(url):
+    """
+    Ensures the url ends with a path, otherwise append a slash.
+    This makes testing against urls easier because most urls will end
+    with a slash.
+    """
+    if "?" in url:
+        return url
+    elif url.endswith("/"):
+        return url
+    else:
+        return "{}/".format(url)
+
+
+def assert_calls(call_list, calls):
+    for i, c in enumerate(calls):
+        assert call_list[i].request == c.request
+        assert call_list[i].response == c.response
