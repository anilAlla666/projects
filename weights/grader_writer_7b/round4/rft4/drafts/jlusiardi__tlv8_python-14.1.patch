+import unittest
+import tlv8
+
+
+class TestTLV8Entry(unittest.TestCase):
+    def test_create_entry_error(self):
+        self.assertRaises(ValueError, tlv8.Entry, 256, b'', tlv8.DataType.BYTES)
+        self.assertRaises(ValueError, tlv8.Entry, 1, 256, tlv8.DataType.UINT8)
+        self.assertRaises(ValueError, tlv8.Entry, 1, 256, tlv8.DataType.BOOL)
+        self.assertRaises(ValueError, tlv8.Entry, 1, 256, tlv8.DataType.FLOAT)
