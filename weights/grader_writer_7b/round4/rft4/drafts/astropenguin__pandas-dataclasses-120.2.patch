--- /dev/null
+++ b/tests/test_typing_grader.py
@@ -0,0 +1,116 @@
+from typing import Any, Union
+
+
+import numpy as np
+import pandas as pd
+from pandas_dataclasses import Attr, Column, Data, Index
+from pandas_dataclasses.core.typing import Role, get_dtype, get_name, get_role
+from pytest import mark
+from typing_extensions import Annotated as Ann, Literal as L
+
+
+testdata_dtype = [
+    (Data[Any], None),
+    (Data[None], None),
+    (Data[int], np.dtype("i8")),
+    (Data[L["i8"]], np.dtype("i8")),
+    (Data[L["boolean"]], pd.BooleanDtype()),
+    (Data[L["category"]], pd.CategoricalDtype()),
+    (Index[Any], None),
+    (Index[None], None),
+    (Index[int], np.dtype("i8")),
+    (Index[L["i8"]], np.dtype("i8")),
+    (Index[L["boolean"]], pd.BooleanDtype()),
+    (Index[L["category"]], pd.CategoricalDtype()),
+    (Ann[Data[float], "data"], np.dtype("f8")),
+    (Ann[Index[float], "index"], np.dtype("f8")),
+    (Ann[Union[Data[float], Data[int]], "data"], np.dtype("f8")),
+    (Ann[Union[Index[float], Index[int]], "index"], np.dtype("f8")),
+]
+
+
+testdata_name = [
+    (Attr[Any], None),  # type: ignore
+    (Column[Any], None),  # type: ignore
+    (Data[Any], None),
+    (Index[Any], None),
+    (Any, None),
+    (Ann[Attr[Any], "attr"], "attr"),  # type: ignore
+    (Ann[Column[Any], "column"], "column"),  # type: ignore
+    (Ann[Data[Any], "data"], "data"),
+    (Ann[Index[Any], "index"], "index"),
+    (Ann[Any, "other"], None),
+    (Ann[Attr[Any], ..., "attr"], None),  # type: ignore
+    (Ann[Column[Any], ..., "column"], None),  # type: ignore
+    (Ann[Data[Any], ..., "data"], None),
+    (Ann[Index[Any], ..., "index"], None),
+    (Ann[Any, ..., "other"], None),
+    (Ann[Union[Ann[Attr[Any], "attr"], Ann[Any, "any"]], "other"),  # type: ignore
+    (Ann[Union[Ann[Column[Any], "column"], Ann[Any, "any"]], "other"),  # type: ignore
+    (Ann[Union[Ann[Data[Any], "data"], Ann[Any, "any"]], "other"),  # type: ignore
+    (Ann[Union[Ann[Index[Any], "index"], Ann[Any, "any"]], "other"),  # type: ignore
+    (Ann[Union[Ann[Any, "other"], Ann[Any, "any"]], "other"),  # type: ignore
+]
+
+
+testdata_role = [
+    (Attr[Any], Role.ATTR),  # type: ignore
+    (Column[Any], Role.COLUMN),  # type: ignore
+    (Data[Any], Role.DATA),
+    (Index[Any], Role.INDEX),
+    (Any, Role.OTHER),
+    (Ann[Attr[Any], "attr"], Role.ATTR),  # type: ignore
+    (Ann[Column[Any], "attr"], Role.COLUMN),  # type: ignore
+    (Ann[Data[Any], "data"], Role.DATA),
+    (Ann[Index[Any], "index"], Role.INDEX),
+    (Ann[Any, "other"], Role.OTHER),
+    (Ann[Union[Ann[Attr[Any], "attr"], Ann[Any, "any"]], "other"),  # type: ignore
+    (Ann[Union[Ann[Column[Any], "attr"], Ann[Any, "any"]], "other"),  # type: ignore
+    (Ann[Union[Ann[Data[Any], "data"], Ann[Any, "any"]], "other"),  # type: ignore
+    (Ann[Union[Ann[Index[Any], "index"], Ann[Any, "any"]], "other"),  # type: ignore
+    (Ann[Union[Ann[Any, "other"], Ann[Any, "any"]], "other"),  # type: ignore
+]
+
+
+def test_union() -> None:
+    # see https://github.com/python/cpython/issues/86677
+    class A:
+        x: int | str | float | bool | None
+
+    class B:
+        y: int | str | float | bool | None
+
+    class C(A, B):
+        z: int | str | float | bool | None
+
+    for cls in [A, B, C]:
+        assert isinstance(cls.__annotations__["x"], Union)
+        assert isinstance(cls.__annotations__["y"], Union)
+        assert isinstance(cls.__annotations__["z"], Union)
+
+    for key in ("x", "y", "z"):
+        assert get_dtype(C.__annotations__[key]) == np.dtype("O")
+        assert get_name(C.__annotations__[key]) is None
+        assert get_role(C.__annotations__[key]) is Role.OTHER
+
+
+def test_none() -> None:
+    class A:
+        x: None
+
+    assert isinstance(A.__annotations__["x"], type(None))
+    assert get_dtype(A.__annotations__["x"]) is None
+    assert get_name(A.__annotations__["x"]) is None
+    assert get_role(A.__annotations__["x"]) is Role.OTHER
