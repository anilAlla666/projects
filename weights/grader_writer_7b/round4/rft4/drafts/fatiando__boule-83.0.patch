+"""
+Test the base Ellipsoid class.
+"""
+
+
+import warnings
+import pytest
+import numpy as np
+import numpy.testing as npt
+from .. import Ellipsoid, ELLIPSOIDS
+from .utils import normal_gravity_surface
+
+
+ELLIPSOID_NAMES = [e.name for e in ELLIPSOIDS]
+
+
+def test_normal_gravity_negative_height():
+    """
+    Check warning when normal gravity is calculated with negative height
+    """
+    # Check if warning is raised when calculating normal gravity on an internal
+    # point
+    with pytest.warns(UserWarning) as record:
+        Ellipsoid.normal_gravity(
+            Ellipsoid.WGS84, latitude=0, height=-1, si_units=True
+        )
+    assert len(record) == 1
+
+
+def test_normal_gravity_zero_height():
+    """
+    Check warning when normal gravity is calculated with zero height
+    """
+    # Check if warning is raised when calculating normal gravity on an internal
+    # point
+    with pytest.warns(UserWarning) as record:
+        Ellipsoid.normal_gravity(
+            Ellipsoid.WGS84, latitude=0, height=0, si_units=True
+        )
+    assert len(record) == 1
