+"""
+Test the base Sphere class.
+"""
+
+
+import warnings
+import pytest
+import numpy as np
+import numpy.testing as npt
+from .. import Sphere
+
+
+@pytest.fixture
+def sphere():
+    "A spherical ellipsoid"
+    ellipsoid = Sphere(
+        name="unit_sphere",
+        radius=1.0,
+        geocentric_grav_const=2.0,
+        angular_velocity=1.3,
+    )
+    return ellipsoid
+
+
+def test_normal_gravity_negative_height():
+    """
+    Check warning when normal gravity is calculated with negative height
+    """
+    gm_constant = 3
+    radius = 1
+    sphere = Sphere(
+        name="sphere",
+        radius=radius,
+        geocentric_grav_const=gm_constant,
+        angular_velocity=0,
+    )
+    # Check if warning is raised when calculating normal gravity on an internal
+    # point
+    with pytest.warns(UserWarning) as record:
+        sphere.normal_gravity(latitude=0, height=-1)
+    assert len(record) == 1
+
+
+def test_normal_gravity_zero_height():
+    """
+    Check warning when normal gravity is calculated with zero height
+    """
+    gm_constant = 3
+    radius = 1
+    sphere = Sphere(
+        name="sphere",
+        radius=radius,
+        geocentric_grav_const=gm_constant,
+        angular_velocity=0,
+    )
+    # Check if warning is raised when calculating normal gravity on an internal
+    # point
+    with pytest.warns(UserWarning) as record:
+        sphere.normal_gravity(latitude=0, height=0)
+    assert len(record) == 1
