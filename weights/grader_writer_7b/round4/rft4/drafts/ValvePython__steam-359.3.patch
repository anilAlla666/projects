+import json
+import vcr
+import requests
+from steam import WebAPI
+from six import iteritems
+
+
+@vcr.use_cassette('tests/vcr_cassettes/test_webapi_user_profile.yaml')
+def test_webapi_user_profile():
+    client = WebAPI("STEAM_KEY")
+    resp = client.user.GetPlayerSummaries([76561197960287930])
+
+    assert resp['response']['players'][0]['personaname'] == "Rossen"
+    assert resp['response']['players'][0]['profileurl'] == "http://steamcommunity.com/id/Rossen/"
+
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main(['-v', '-s', '--tb=native', __file__])
