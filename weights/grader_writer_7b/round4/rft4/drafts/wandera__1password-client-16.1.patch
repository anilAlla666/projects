+import pytest
+import sys
+from unittest.mock import patch
+
+
+@pytest.mark.skipif(sys.version_info >= (3, 10),
+                    reason="requires python3.9 or lower")
+def test_encode_with_pycryptodome():
+    from onepassword.utils import Encryption
+    enc = Encryption(secret_key="secret_key"*8)
+    assert enc.decode(enc.encode("test")) == "test"
+
+
+@pytest.mark.skipif(sys.version_info < (3, 10),
+                    reason="requires python3.10 or higher")
+def test_encode_with_cryptography():
+    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
+    from cryptography.hazmat.backends import default_backend
+    from onepassword.utils import Encryption
+
+    # Create cipher object with your secret key and initialization vector
+    iv = b"random_iv_16_bytes"  # Replace with your own IV
+    key = b"secret_key"*8
+    backend = default_backend()
+    aes_cipher = Cipher(
+        algorithms.AES(key), modes.ECB(), backend=backend)
+    aes_encryptor = aes_cipher.encryptor()
+    aes_decryptor = aes_cipher.decryptor()
+
+    # Wrap the encryption and decryption methods in the Encryption class
+    class EncryptionWrapper(Encryption):
+        def __init__(self, secret_key):
+            super().__init__(secret_key)
+            self.backend = backend
+
+        def encrypt(self, data):
+            return aes_encryptor.update(data) + aes_encryptor.finalize()
+
+        def decrypt(self, data):
+            return aes_decryptor.update(data) + aes_decryptor.finalize()
+
+    enc = EncryptionWrapper(secret_key="secret_key"*8)
+    assert enc.decode(enc.encode("test")) == "test"
