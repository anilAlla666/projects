+import json
+import pytest
+from sceptre.exceptions import (
+    TemplateBucketNotFoundError,
+    TemplatePathNotFoundError,
+    TemplateSchemaMismatchError,
+    TemplateUserdataError
+)
+from sceptre.template_handlers.http import Http
+from unittest.mock import patch
+
+
+class TestHttp(object):
+    @patch('sceptre.template_handlers.http.Http._get_template')
+    def test_handle_with_bad_bucket(self, mock_get_template):
+        handler = Http("http_handler", {'bucket': 'invalid-bucket', 'key': 'some-key'})
+        with pytest.raises(TemplateBucketNotFoundError):
+            handler.handle()
+
+    @patch('sceptre.template_handlers.http.Http._get_template')
+    def test_handle_with_bad_path(self, mock_get_template):
+        handler = Http("http_handler", {'bucket': 'valid-bucket', 'key': 'some/key/that/is/not/found'})
+        with pytest.raises(TemplatePathNotFoundError):
+            handler.handle()
+
+    @patch('sceptre.template_handlers.http.Http._get_template')
+    def test_handle_with_invalid_json(self, mock_get_template):
+        handler = Http("http_handler", {'bucket': 'valid-bucket', 'key': 'some/key/with/invalid/json'})
+        with pytest.raises(TemplateUserdataError):
+            handler.handle()
+
+    @patch('sceptre.template_handlers.http.Http._get_template')
+    def test_handle_with_invalid_yaml(self, mock_get_template):
+        handler = Http("http_handler", {'bucket': 'valid-bucket', 'key': 'some/key/with/invalid/yaml'})
+        with pytest.raises(TemplateUserdataError):
+            handler.handle()
