--- /dev/null
+++ b/tests/test_document_grader.py
@@ -0,0 +1,13 @@
+import pytest
+from svgpathtools import Document, Path
+
+
+def test_empty_group():
+    doc = Document()
+    empty = doc.add_group(group_attribs={'id': 'empty'})
+    doc.add_path(Path('M 0,0 L 1,1'), group=empty)
+    assert doc.tostring() == (
+        '<svg xmlns:svg="http://www.w3.org/2000/svg">'
+        '<g id="empty"><path d="M 0,0 L 1,1"/></g>'
+        '</svg>'
+    )
