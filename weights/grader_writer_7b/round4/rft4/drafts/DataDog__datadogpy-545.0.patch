+"""
+Tests for the ThreadStats class, using HTTP mode
+"""
+
+
+import logging
+import os
+import random
+import time
+import unittest
+from mock import patch
+from datadog import ThreadStats, lambda_metric, datadog_lambda_wrapper
+from datadog.threadstats.aws_lambda import _lambda_stats
+from tests.util.contextmanagers import preserve_environment_variable
+
+
+logger = logging.getLogger('dd.datadogpy')
+
+
+logger.setLevel(logging.ERROR)
+
+
+def assert_equal(a, b):
+    assert a == b
+
+
+class MemoryReporter(object):
+    """
+    A reporting class that reports to memory for testing.
+    """
+
+    def __init__(self):
+        self.distributions = []
+        self.metrics = []
+        self.events = []
+        self.sets = []
+
+    def flush_distributions(self, distributions):
+        self.distributions += distributions
+
+    def flush_metrics(self, metrics):
+        self.metrics += metrics
+
+    def flush_sets(self, sets):
+        self.sets += sets
+
+    def flush_events(self, events):
+        self.events += events
+
+
+class TestThreadStats(unittest.TestCase):
+    def setUp(self):
+        self.reporter = MemoryReporter()
+
+    def sort_metrics(self, metrics):
+        metrics = sorted(metrics, key=lambda m: m["name"])
+        first = metrics[0]
+        second = metrics[1]
+        p75 = metrics[2]
+        p85 = metrics[3]
+        p95 = metrics[4]
+        p99 = metrics[5]
+        avg = metrics[6]
+        cnt = metrics[7]
+        max_ = metrics[8]
+        min_ = metrics[9]
+        return (first, second, p75, p85, p95, p99, avg, cnt, max_, min_)
+
+    def test_set(self):
+        """
+        Tests sending a set metric.
+        """
+        dog = ThreadStats()
+        dog.start(roll_up_interval=1, flush_in_thread=False)
+        reporter = dog.reporter = self.reporter
+
+        # Send a few metrics
+        dog.set("unique", "value", timestamp=100.0)
+        dog.flush(200.0)
+
+        assert_equal(len(reporter.sets), 1)
+
+    def test_set_with_tags(self):
+        """
+        Tests sending a set metric with tags.
+        """
+        dog = ThreadStats()
+        dog.start(roll_up_interval=1, flush_in_thread=False)
+        reporter = dog.reporter = self.reporter
+
+        # Send a few metrics
+        dog.set("unique", "value", ["tag1"], timestamp=100.0)
+        dog.flush(200.0)
+
+        assert_equal(len(reporter.sets), 1)
+
+    def test_set_no_namespace(self):
+        """
+        Tests sending a set metric with no namespace.
+        """
+        dog = ThreadStats(namespace="foo")
+        dog.start(roll_up_interval=1, flush_in_thread=False)
+        reporter = dog.reporter = self.reporter
+
+        # Send a few metrics
+        dog.set("unique", "value", timestamp=100.0)
+        dog.flush(200.0)
+
+        assert_equal(len(reporter.sets), 1)
+
+    def test_set_with_namespace(self):
+        """
+        Tests sending a set metric with namespace.
+        """
+        dog = ThreadStats(namespace="foo")
+        dog.start(roll_up_interval=1, flush_in_thread=False)
+        reporter = dog.reporter = self.reporter
+
+        # Send a few metrics
+        dog.set("bar.unique", "value", timestamp=100.0)
+        dog.flush(200.0)
+
+        assert_equal(len(reporter.sets), 1)
