+import m3u8
+import playlists
+import pytest
+from m3u8.parser import cast_date_time, ParseError
+
+
+def test_closed_caption_as_cc():
+    data = m3u8.parse(playlists.CLOSED_CAPTION_AS_CC)
+    assert data['playlists'][0]['stream_info']['closed_captions'] == 'CC'
+
+
+def test_closed_caption_as_none():
+    data = m3u8.parse(playlists.CLOSED_CAPTION_AS_NONE)
+    assert data['playlists'][0]['stream_info']['closed_captions'] is None
+
+
+def test_closed_caption_as_other_value():
+    data = m3u8.parse(playlists.CLOSED_CAPTION_AS_OTHER_VALUE)
+    assert data['playlists'][0]['stream_info']['closed_captions'] == 'other_value'
+
+
+def test_closed_caption_as_no_value():
+    data = m3u8.parse(playlists.CLOSED_CAPTION_AS_NO_VALUE)
+    assert data['playlists'][0]['stream_info']['closed_captions'] is None
