+"""
+Test the ``text_to_num`` library.
+"""
+
+
+from unittest import TestCase
+from text_to_num import alpha2digit, text2num
+
+
+class TestTextToNumCA(TestCase):
+    def test_alpha2digit_all_ordinals(self):
+        source = (
+            "Cinquè primer segon tercer vint-i-unè centè mil dos-cents trentè."
+        )
+        expected = "5è 1r 2n 3r 21è 100è 1230è."
+        self.assertEqual(
+            alpha2digit(source, "ca", ordinal_threshold=0, simplify_check_coef_appliable=False),
+            expected,
+        )
+
+    def test_alpha2digit_simplify_check_coef_appliable(self):
+        source = "Vingt milió de cinc"
+        expected = "20000000 de 5"
+        self.assertEqual(
+            alpha2digit(source, "ca", simplify_check_coef_appliable=False),
+            expected,
+        )
+
+    def test_alpha2digit_relaxed(self):
+        source = "Vingt milió de cinc"
+        expected = "20000000 de 5"
+        self.assertEqual(
+            alpha2digit(source, "ca", relax=True),
+            expected,
+        )
+
+        source = "Un milió de cinc"
+        expected = "1000000 de 5"
+        self.assertEqual(
+            alpha2digit(source, "ca", relax=True),
+            expected,
+        )
