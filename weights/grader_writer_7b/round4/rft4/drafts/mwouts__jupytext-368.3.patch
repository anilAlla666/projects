+import io
+import os
+import sys
+import pytest
+from nbformat import read
+from nbformat.v4.rwmodel import NotebookNode
+import jupytext
+from jupytext.compare import compare
+from jupytext.header import header_to_dict
+
+
+@pytest.mark.parametrize("jupytext_format", [
+    'ipynb',
+    'py:light',
+    'py:percent',
+    'py:hydrogen',
+    'py:sphinx',
+    'py:executable',
+    'md:myst',
+    'rst:directive',
+    'rst:ipyrest2txt',
+    'toml',
+    'json',
+    'jl:hydrogen',
+    'jl:simple-light',
+    'pct:tangle',
+])
+def test_roundtrip_empty_notebook(jupytext_format, tmpdir):
+    nb = NotebookNode(cells=[], metadata={}, nbformat=4, nbformat_minor=4)
+    ext = jupytext_format.split(':')[0]
+    path = str(tmpdir.join(f'notebook.{ext}'))
+    jupytext.write(nb, path, fmt=jupytext_format)
+    nb_read = jupytext.read(path)
+    compare(nb, nb_read)
+
+    assert 'encoding' in os.stat(path).st_flags
+
+    with io.StringIO() as stream:
+        jupytext.writes(nb, stream, fmt=jupytext_format)
+        txt = stream.getvalue().strip()
+        assert txt.count('# -*- coding: utf-8 -*-') == 1
