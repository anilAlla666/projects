+import pytest
+import jupytext
+from jupytext.compare import compare_notebooks
+
+
+def test_read_file_with_explicit_fmt(tmpdir):
+    tmp_py = str(tmpdir.join('notebook.py'))
+
+    with open(tmp_py, 'w') as fp:
+        fp.write("""# %%
+1 + 1
+""")
+
+    nb1 = jupytext.read(tmp_py)
+    nb2 = jupytext.read(tmp_py, fmt='py:percent')
+
+    compare_notebooks(nb2, nb1)
+
+
+def test_read_markdown_cells(tmpdir):
+    tmp_md = str(tmpdir.join('notebook.md'))
+
+    with open(tmp_md, 'w') as fp:
+        fp.write("""
+---
+jupytext:
+  formats: ipynb,py:percent
+  text_representation:
+    extension: .py
+    format_name: percent
+    format_version: '1.3'
+    jupytext_version: 1.3.4
+---
+""") 
