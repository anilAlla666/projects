+import unittest
+from typing import Union, Optional
+from overrides import overrides, final, EnforceOverrides
+from overrides.enforce import ensure_signature_is_compatible
+
+
+class Enforcing(EnforceOverrides):
+    classVariableIsOk = "OK?"
+
+    @final
+    def finality(self):
+        return "final"
+
+    def nonfinal1(self, param: int) -> str:
+        return "super1"
+
+    def nonfinal2(self):
+        return "super2"
+
+    @property
+    def nonfinal_property(self):
+        return "super_property"
+
+    @staticmethod
+    def nonfinal_staticmethod():
+        return "super_staticmethod"
+
+    @classmethod
+    def nonfinal_classmethod(cls):
+        return "super_classmethod"
+
+
+class EnforceTests(unittest.TestCase):
+    def test_annotations_are_strings_with_future_import(self):
+        from __future__ import annotations
+
+        def foo(bar: str):
+            pass
+
+        def foo1(bar: "int"):
+            pass
+
+        # These should be ok even though bar has an annotation
+        # of type str, because `from __future__ import annotations` means
+        # that annotations are string literals.
+        ensure_signature_is_compatible(foo, foo1)
+
+
+if __name__ == '__main__':
+    unittest.main()
