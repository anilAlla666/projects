+def test_make_local_storage_parallel():
+    "Check that multiple processes can safely call make_local_storage"
+    # https://github.com/fatiando/pooch/issues/318
+    path = Path("parallel-test")
+    path.mkdir(exist_ok=True)
+    p1 = Pooch(
+        base_url="https://www.something.com/",
+        path=path,
+        registry={"test-data.txt": "baee0894dba14b12085eacb204284b97e362f4f3e5a5807693cc90ef415c1b2d"},
+    )
+    p2 = Pooch(
+        base_url="https://www.something.com/",
+        path=path,
+        registry={"test-data.txt": "baee0894dba14b12085eacb204284b97e362f4f3e5a5807693cc90ef415c1b2d"},
+    )
+
+    with capture_log() as logs:
+        p1.fetch("test-data.txt")
+        p2.fetch("test-data.txt")
+
+    assert sum(1 for log in logs if "Cannot write to data cache folder" in log) == 0
+
+
+def test_make_local_storage_env(monkeypatch):
+    "Make sure the environment variable works as expected"
+    monkeypatch.setenv("POOCH_TEST_PATH", "/home/user/cache")
+    assert make_local_storage("~/.cache/pooch/test/path", env="POOCH_TEST_PATH") == Path("/home/user/cache")
+
+
+def test_make_local_storage_env_missing(monkeypatch):
+    "If the environment variable does not exist, nothing should be returned"
+    monkeypatch.delenv("POOCH_TEST_PATH", raising=False)
+    assert make_local_storage("~/.cache/pooch/test/path", env="POOCH_TEST_PATH") == Path("~/cache")
+
+
+def test_make_local_storage_version():
+    "Check that appending version number works"
+    assert make_local_storage("~/.cache/pooch/test/path", version="v1.2.3") == Path("~/.cache/pooch/test/v1.2.3")
+
+
+def test_make_local_storage_no_create(monkeypatch):
+    "Make sure the environment variable works as expected"
+    monkeypatch.setenv("POOCH_NO_CREATE", "True")
+    assert make_local_storage("~/.cache/pooch/test/path", env="POOCH_NO_CREATE") is None
+
+
+def test_make_local_storage_no_create_missing(monkeypatch):
