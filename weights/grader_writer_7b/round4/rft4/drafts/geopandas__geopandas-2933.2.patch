+def test_merge_keep_geom_columns(dfs):
+    df1, df2 = dfs
+    res = df1.merge(df2, how="outer")
+    expected = GeoDataFrame(
+        {
+            "col1": [1, 2, 1, 2],
+            "col2": [np.nan, np.nan, 1, 2],
+            "geometry": [
+                Polygon([(0, 0), (2, 0), (2, 2), (0, 2)]),
+                Polygon([(2, 2), (4, 2), (4, 4), (2, 4)]),
+                Polygon([(1, 1), (3, 1), (3, 3), (1, 3)]),
+                Polygon([(3, 3), (5, 3), (5, 5), (3, 5)]),
+            ],
+        },
+        crs=df1.crs,
+    )
+    assert_geoseries_equal(res.geometry, expected.geometry)
+
+
+def test_concat_keep_geom_columns(dfs):
+    df1, df2 = dfs
+    res = pd.concat([df1, df2], keys=[0, 1])
+    expected = GeoDataFrame(
+        {
+            "col1": [1, 2, 1, 2],
+            "col2": [np.nan, np.nan, 1, 2],
+            "geometry": [
+                Polygon([(0, 0), (2, 0), (2, 2), (0, 2)]),
+                Polygon([(2, 2), (4, 2), (4, 4), (2, 4)]),
+                Polygon([(1, 1), (3, 1), (3, 3), (1, 3)]),
+                Polygon([(3, 3), (5, 3), (5, 5), (3, 5)]),
+            ],
+        },
+        crs=df1.crs,
+    )
+    assert_geoseries_equal(res.geometry, expected.geometry)
+
+
+def test_loc_drop_keep_geom_columns(dfs):
+    df1, _ = dfs
+    res = df1.loc[:, ["col1"]]
+    expected = GeoDataFrame({"col1": [1, 2]}, crs=df1.crs)
+    assert_geoseries_equal(res.geometry, expected.geometry)
+    res = df1.drop(columns=["col1"])
+    expected = GeoDataFrame(geometry=[Point(0, 0), Point(2, 2)], crs=df1.crs)
+    assert_geoseries_equal(res.geometry, expected.geometry)
+
+
+def test_set_geometry_keep_geom_columns(dfs):
+    df1, _ = dfs
+    res = df1.set_geometry("col1").reset_geometry(name="geom", drop=True)
+    expected = GeoDataFrame({"col1": [1, 2]}, crs=df1.crs)
+    assert_geoseries_equal(res.geometry, expected.geometry)
+
+
+def test_set_geometry_drop_geom_columns(dfs):
+    df1, _ = dfs
+    res = df1.set_geometry(None)
+    expected = GeoDataFrame(
+        {"col1": [1, 2]},
+        crs=df1.crs,
+    )
+    assert_geoseries_equal(res.geometry, expected.geometry)
+
+
+def test_apply_keep_geom_columns(dfs):
+    df1, _ = dfs
+    res = df1.apply(lambda x: x, axis=1)
+    expected = GeoDataFrame({"col1": [1, 2]}, crs=df1.crs)
+    assert_geoseries_equal(res.geometry, expected.geometry)
+
+
+def test_explode_keep_geom_columns(dfs):
+    df1, _ = dfs
+    res = df1.explode(ignore_index=True)
+    expected = GeoDataFrame(
+        {
+            "col1": [1, 1, 2, 2],
