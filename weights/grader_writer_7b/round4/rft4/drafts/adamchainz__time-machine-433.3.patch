+class TestTravelContextManager(TestCase):
+    def setUp(self) -> None:
+        time_machine.uninstall()
+
+    def tearDown(self) -> None:
+        time_machine.uninstall()
+
+    def test_time_time_infinite_loop_with_zero_timedelta(self):
+        """Ensure that time_machine doesn't enter an infinite loop with zero timedelta"""
+
+        with time_machine.travel(dt.timedelta()):
+            time.sleep(0.1)
+
