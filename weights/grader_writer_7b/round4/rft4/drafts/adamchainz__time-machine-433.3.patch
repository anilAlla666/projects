+@contextmanager
+def patch_mocked_modules(*mocked_module_names: str):
+    mocked_modules = {}
+    for name in mocked_module_names:
+        spec = spec_from_file_location(name, "<string>")
+        assert spec is not None
+        mocked_modules[name] = module_from_spec(spec)
+        spec.loader.exec_module(mocked_modules[name])
+    with mock.patch.dict(sys.modules, mocked_modules):
+        yield mocked_modules
+
