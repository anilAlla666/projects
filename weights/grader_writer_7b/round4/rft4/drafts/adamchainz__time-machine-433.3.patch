+        # we use a fixture so that time_machine is patched only for the tests using it
+        time_machine.install(patched_time_escape_hatch=request.param)
+
+    @pytest.fixture(params=["time", "datetime"])
+    def patched_time_type(self, request: pytest.FixtureRequest) -> None:
+        # we use a fixture so that time_machine is patched only for the tests using it
+        time_machine.install(patched_time_type=request.param)
+
+    @staticmethod
+    def check_escaped(func: Callable[[int], None]) -> None:
+        start = time.time()
+        func(start)
+        elapsed = time.time() - start
+        assert elapsed > 0.1
+
+    def test_time_sleep(self, patched_time_escape_hatch: None) -> None:
+        with time_machine.travel(LIBRARY_EPOCH):
+            self.check_escaped(time.sleep)
