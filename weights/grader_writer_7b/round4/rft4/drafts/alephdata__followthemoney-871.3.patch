+import unittest
+from followthemoney.types import registry
+
+
+mimetypes = registry.mimetype
+
+
+class MimetypesTest(unittest.TestCase):
+    def test_rdf(self):
+        self.assertEqual(str(mimetypes.rdf("text/PLAIN")), "urn:mimetype:text/plain")
+        self.assertEqual(str(mimetypes.rdf("application/json")), "urn:mimetype:application/json")
+        self.assertEqual(str(mimetypes.rdf(None)), None)
