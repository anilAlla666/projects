@@ -0,0 +1,21 @@
+import unittest
+from followthemoney.types import registry
+
+
+emails = registry.email
+
+
+class EmailsTest(unittest.TestCase):
+    def test_invalid_domains(self):
+        # Issue #339
+        # Some domains can't be encoded using IDNA encoding.
+        self.assertEqual(emails.clean("foo@xn--\u0131\u0131\u0131.com"), None)
+        self.assertEqual(emails.clean("foo@xn--\u0131\u0131\u0131.co.uk"), None)
+        self.assertEqual(emails.clean("foo@xn--\u0131\u0131\u0131.cn"), None)
+
+    def test_clean_with_non_ascii_chars(self):
+        self.assertEqual(emails.clean("foo@pudo.\u0131\u0131\u0131"), None)
+        self.assertEqual(emails.clean("foo@pudo.\u0131\u0131\u0131."), None)
+        self.assertEqual(emails.clean("foo@pudo.\u0131\u0131\u0131..com"), None)
+        self.assertEqual(emails.clean("foo@pudo.\u0131\u0131\u0131..co.uk"), None)
+        self.assertEqual(emails.clean("foo@pudo.\u0131\u0131\u0131..cn"), None)
