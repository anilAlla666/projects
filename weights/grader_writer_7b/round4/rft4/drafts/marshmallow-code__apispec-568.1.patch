+class TestCustomFields:
+    class CustomField(Field):
+        def _serialize(self, value, attr, data, **kwargs):
+            return "custom-" + str(value)
+
+        def _deserialize(self, value, attr, data, **kwargs):
+            return int(value.replace("custom-", ""))
+
+    class SchemaWithCustomField(Schema):
+        custom_field = CustomField()
+
+    @pytest.mark.parametrize(
+        "schema,expected_result",
+        [
+            (CustomField(), {"type": "string"}),
+            (
+                SchemaWithCustomField(),
+                {"type": "string", "pattern": r"^custom-\d+$"},
+            ),
+        ],
+    )
+    def test_custom_fields_get_registered(
+        self, spec, schema, expected_result
+    ):
+        spec.components.schema("CustomFieldSchema", schema=schema)
+        result = get_schemas(spec)["CustomFieldSchema"]["properties"][
+            "custom_field"
+        ]
+        assert result == expected_result
+
+    def test_custom_fields_dont_break_with_none_as_name(self, spec):
+        class SchemaWithCustomFieldNoName(Schema):
+            custom_field = CustomField(data_key="my_field")
+
+        spec.components.schema("CustomFieldSchema", schema=SchemaWithCustomFieldNoName)
+        result = get_schemas(spec)["CustomFieldSchema"]["properties"][
+            "my_field"
+        ]
+        assert result == {"type": "string", "pattern": r"^custom-\d+$"}
+
+    def test_custom_fields_with_load_and_dump_methods(self, spec):
+        class CustomField(Field):
+            def _serialize(self, value, attr, data, **kwargs):
+                return "custom-" + str(value)
+
+            def _deserialize(self, value, attr, data, **kwargs):
+                return int(value.replace("custom-", ""))
+
+            def _get_value(self, key, data, attr=None, default=None):
+                return super()._get_value(key, data, attr=attr, default=default)
+
+            def _serialize_for_validation(self, value, attr, data, **kwargs):
+                return self._serialize(value, attr, data, **kwargs)
+
+        class SchemaWithCustomField(Schema):
+            custom_field = CustomField()
+
+        spec.components.schema("CustomFieldSchema", schema=SchemaWithCustomField)
+        result = get_schemas(spec)["CustomFieldSchema"]["properties"][
+            "custom_field"
+        ]
+        assert result == {"type": "string", "pattern": r"^custom-\d+$"}
+
