+import pytest
+from marshmallow import fields, Schema, validate
+from apispec.ext.marshmallow import MarshmallowPlugin
+from apispec.ext.marshmallow.openapi import MARSHMALLOW_VERSION_INFO
+from apispec import exceptions, utils, APISpec
+from .schemas import CustomList, CustomStringField
+from .utils import get_schemas, build_ref
+
+
+class TestFieldValidation:
+    class ValidationSchema(Schema):
+        id = fields.Int(dump_only=True)
+        range = fields.Int(validate=validate.Range(min=1, max=10))
+        multiple_ranges = fields.Int(
+            validate=[
+                validate.Range(min=1),
+                validate.Range(min=3),
+                validate.Range(max=10),
+                validate.Range(max=7),
+            ]
+        )
+        list_length = fields.List(fields.Str, validate=validate.Length(min=1, max=10))
+        custom_list_length = CustomList(
+            fields.Str, validate=validate.Length(min=1, max=10)
+        )
+        string_length = fields.Str(validate=validate.Length(min=1, max=10))
+        custom_field_length = CustomStringField(validate=validate.Length(min=1, max=10))
+        multiple_lengths = fields.Str(
+            validate=[
+                validate.Length(min=1),
+                validate.Length(min=3),
+                validate.Length(max=10),
+                validate.Length(max=7),
+            ]
+        )
+        equal_length = fields.Str(
+            validate=[validate.Length(equal=5), validate.Length(min=1, max=10)]
+        )
+
+    @pytest.mark.parametrize(
+        ("field", "properties"),
+        [
+            ("range", {"minimum": 1, "maximum": 10}),
+            ("multiple_ranges", {"minimum": 3, "maximum": 7}),
+            ("list_length", {"minItems": 1, "maxItems": 10}),
+            ("custom_list_length", {"minItems": 1, "maxItems": 10}),
+            ("string_length", {"minLength": 1, "maxLength": 10}),
+            ("custom_field_length", {"minLength": 1, "maxLength": 10}),
+            ("multiple_lengths", {"minLength": 3, "maxLength": 7}),
+            ("equal_length", {"minLength": 5, "maxLength": 5}),
+        ],
+    )
+    def test_properties(self, field, properties, spec):
+        spec.components.schema("Validation", schema=self.ValidationSchema)
+        result = get_schemas(spec)["Validation"]["properties"][field]
+
+    @pytest.mark.parametrize(
+        ("field", "properties"),
+        [
+            ("range", {"exclusiveMinimum": True, "exclusiveMaximum": True}),
+            ("multiple_ranges", {"exclusiveMinimum": True, "exclusiveMaximum": True}),
+            ("list_length", {"exclusiveMinItems": True, "exclusiveMaxItems": True}),
+            ("custom_list_length", {"exclusiveMinItems": True, "exclusiveMaxItems": True}),
+            ("string_length", {"exclusiveMinLength": True, "exclusiveMaxLength": True}),
+            ("custom_field_length", {"exclusiveMinLength": True, "exclusiveMaxLength": True}),
+            ("multiple_lengths", {"exclusiveMinLength": True, "exclusiveMaxLength": True}),
+            ("equal_length", {}),
+        ],
+    )
+    def test_properties_exclude(self, field, properties, spec):
+        spec.components.schema("Validation", schema=self.ValidationSchema)
+        result = get_schemas(spec)["Validation"]["properties"][field]
+        for k, v in properties.items():
+            assert result[k] != v
+
+
+class TestSchemaRef:
+    def test_schema_with_string_reference_resolves_correctly(
+        self, spec, schema_name_resolver
+    ):
+        class SchemaWithReference(Schema):
+            nested = fields.Nested("NestedSchema")
+
+        spec.components.schema("SchemaWithReference", schema=SchemaWithReference)
+        spec.components.schema("NestedSchema", schema=AnalysisSchema)
+
+        plugin = MarshmallowPlugin(schema_name_resolver=schema_name_resolver)
+        plugin.register(spec)
+
+        assert len(get_schemas(spec)) == 2
+        assert "NestedSchema" in get_schemas(spec)
+
+        response = spec.components.response("Response with schema ref", schema="string")
+        expected_response = {
+            "description": "Response with schema ref",
+            "content": {
+                "application/json": {
+                    "schema": {"$ref": "#/components/schemas/NestedSchema"}
+                }
+            },
+        }
+        assert response == expected_response
+
+
+class TestCircularReferences:
+    def test_circular_references_are_handled(self, spec):
+        class SelfReferencingSchema(Schema):
+            self_link = fields.Url(dump_only=True)
+            self = fields.Nested(lambda: self, many=True)
+
+        spec.components.schema("SelfReferencing", schema=SelfReferencingSchema)
+        result = get_schemas(spec)["SelfReferencing"]
+        assert "$ref" not in result
+        assert "allOf" in result
+        assert len(result["allOf"]) == 2
+
+        first_ref = result["allOf"][0]
+        second_ref = result["allOf"][1]
+        assert "$ref" in first_ref
+        assert "$ref" in second_ref
+
