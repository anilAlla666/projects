+from __future__ import print_function
+import sys
+import os.path
+import subprocess
+import unittest
+
+
+pycparser_dir = os.path.dirname(os.path.abspath(__file__))
+
+
+class TestPyCParser(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.pycparser_script = os.path.join(
+            pycparser_dir,
+            '..',
+            'scripts',
+            'parse_file.py'
+        )
+
+    def run_parse_file(self, filename, options=None):
+        cmd = [self.pycparser_script]
+        if options is not None:
+            cmd.extend(options)
+        cmd.append(filename)
+
+        try:
+            result = subprocess.check_output(cmd)
+            return result.decode('utf-8')
+        except subprocess.CalledProcessError as e:
+            print(e.output.decode('utf-8'))
+            raise
+
+    def check_parse_file(self, filename, expected):
+        actual = self.run_parse_file(filename)
+        self.assertEqual(actual, expected)
+
+    def test_empty_switch(self):
+        filename = os.path.join(pycparser_dir, 'testfiles', 'empty_switch.c')
+        expected = ('File: %s\n' +
+                    '  Function: main()\n' +
+                    '    Declaration: int main()\n' +
+                    '      Declarator: ()\n' +
+                    '    Compound:\n' +
+                    '      Declaration: int type;\n' +
+                    '        TypeDecl: int\n' +
+                    '          Identifier: type\n' +
+                    '      ExpressionStatement: int type = 2;\n' +
+                    '        Assignment: type\n' +
+                    '          ID: type\n' +
+                    '          Constant: 2\n' +
+                    '      ExpressionStatement: ;\n' +
+                    '        EmptyExpression: \n' +
+                    '      ExpressionStatement: ;\n' +
+                    '        EmptyExpression: \n') % filename
+        self.check_parse_file(filename, expected)
