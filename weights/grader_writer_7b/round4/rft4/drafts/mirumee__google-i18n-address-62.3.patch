+from __future__ import unicode_literals
+import pytest
+from i18naddress import (
+    get_field_order, get_validation_rules, load_validation_data)
+
+
+def test_load_validation_data_percent_path():
+    """Regression test for https://github.com/mirumee/google-i18n-address/issues/5"""
+    with pytest.raises(ValueError):
+        load_validation_data('%s' % 42)
+
+    with pytest.raises(ValueError):
+        load_validation_data('xx/../../etc/passwd')
+
+    with pytest.raises(ValueError):
+        load_validation_data('xx/../../../../etc/passwd')
