--- /dev/null
+++ b/test_zahlwort2num_grader.py
@@ -0,0 +1,23 @@
+import unittest
+from zahlwort2num import convert
+
+
+class TestConvert(unittest.TestCase):
+    def test_zwo(self):
+        """
+        Tests if the conversion of the German word "zwo" works.
+        """
+        expected_result = 2
+        actual_result = convert("zwo")
+        self.assertEqual(actual_result, expected_result)
+
+    def test_drei(self):
+        """
+        Tests if the conversion of the German word "drei" works.
+        """
+        expected_result = 3
+        actual_result = convert("drei")
+        self.assertEqual(actual_result, expected_result)
+
+
+if __name__ == '__main__':
+    unittest.main()
