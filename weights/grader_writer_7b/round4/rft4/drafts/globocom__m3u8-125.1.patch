+import m3u8
+import playlists
+import pytest
+from m3u8.parser import cast_date_time, ParseError
+
+
+def test_should_parse_closed_caption_without_quotation_marks():
+    data = m3u8.parse(playlists.VARIANT_WITH_CLOSED_CAPTION)
+    assert 'cc' == data['playlists'][0]['stream_info']['closed_captions']
+
+
+def test_should_parse_closed_caption_without_quotation_marks_strict():
+    with pytest.raises(ParseError) as catch:
+        m3u8.parse(playlists.VARIANT_WITH_CLOSED_CAPTION, strict=True)
+    assert str(catch.value) == ('Invalid value "cc" '
+                                'for attribute closed-captions '
+                                'on line 3.')
