--- /dev/null
+++ b/tests/test_yesqa_test_grader.py
@@ -0,0 +1,32 @@
+import pytest
+import yesqa
+
+
+@pytest.fixture
+def assert_rewrite(tmpdir):
+    def _assert(s, expected=None):
+        expected_retc = 0 if expected is None else 1
+        expected = s if expected is None else expected
+        f = tmpdir.join('f.py')
+        f.write(s)
+        assert yesqa.fix_file(str(f)) == expected_retc
+        assert f.read() == expected
+    return _assert
+
+
+def test_show_source(caplog):
+    caplog.set_level('INFO')
+    yesqa._run_flake8('/tmp/x.py', ['--show-source'])
+    assert caplog.messages[0].startswith('Flake8 found errors:')
+
+
+@pytest.mark.parametrize(
+    'args',
+    (
+        [],
+        ['--ignore=E203'],
+        ['--max-line-length=88'],
+        ['--statistics'],
+    ),
+)
+def test_other_options(args):
+    yesqa._run_flake8('/tmp/x.py', args)
