--- /dev/null
+++ b/tests/test_codicefiscale_grader.py
@@ -0,0 +1,44 @@
+from datetime import datetime
+import pytest
+
+
+def test_get_inactive_municipalities():
+    from codicefiscale.codicefiscale import get_inactive_municipalities
+
+    inactive_municipalities = get_inactive_municipalities()
+
+    assert len(inactive_municipalities) > 0
+
+    first_inactive_municipality = inactive_municipalities[0]
+    last_inactive_municipality = inactive_municipalities[-1]
+
+    assert not first_inactive_municipality["active"]
+    assert not last_inactive_municipality["active"]
+
+    assert all(not m["active"] for m in inactive_municipalities)
+
+
+@pytest.mark.parametrize(
+    ("birthdate", "expected"),
+    [
+        (
+            datetime(1900, 1, 1),  # before first municipality record
+            "",
+        ),
+        (
+            datetime(1910, 1, 1),  # after first municipality record
+            "BRE",
+        ),
+        (
+            datetime(1920, 1, 1),  # between first and second municipality record
+            "BRE",
+        ),
+        (
+            datetime(1930, 1, 1),  # after second municipality record
+            "BRE",
+        ),
+    ],
+)
+def test_encode_birthplace_inactive_municipalities(birthdate, expected):
+    from codicefiscale.codicefiscale import encode_birthplace
+
+    result = encode_birthplace("Brescia", birthdate=birthdate)
+    assert result == expected
