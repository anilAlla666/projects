--- /dev/null
+++ b/clldutils/tests/test_badge_grader.py
@@ -0,0 +1,24 @@
+from __future__ import unicode_literals
+from functools import partial
+
+
+def test_badge():
+    from clldutils.badge import badge, Colors
+
+    _badge = partial(badge, 'cov', '20%', Colors.orange)
+
+    assert _badge() == \
+        '![cov: 20%](https://img.shields.io/badge/cov-20%25-orange.svg "cov: 20%")'
+    assert _badge(markdown=False, style='plastic') == \
+        'https://img.shields.io/badge/cov-20%25-orange.svg?style=plastic'
+
+    _badge = partial(badge, subject='cov',
+                     status='20%', color='orange', fmt='svg')
+
+    assert _badge() == \
+        '![cov: 20%](https://img.shields.io/badge/cov-20%25-orange.svg "cov: 20%")'
+    assert _badge(style='plastic') == \
+        '![cov: 20%](https://img.shields.io/badge/cov-20%25-orange.svg?style=plastic)'
+    assert _badge(query={'foo': 'bar'}) == \
+        '![cov: 20%](https://img.shields.io/badge/cov-20%25-orange.svg?foo=bar "cov: 20%")'
