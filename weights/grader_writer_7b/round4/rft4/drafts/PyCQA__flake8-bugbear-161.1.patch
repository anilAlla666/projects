+class TestBugBear(unittest.TestCase):
+    def setUp(self):
+        self.filename = "<string>"
+        self.lines = []
+
+    def errors(self, *args):
+        return args
+
+    def test_b901(self):
+        filename = Path(__file__).absolute().parent / "b901.py"
+        bbc = BugBearChecker(filename=str(filename))
+        errors = list(bbc.run())
+        self.assertEqual(errors, self.errors(B901(11, 0)))
+
+    def test_selfclean_bugbear(self):
+        filename = Path(__file__).absolute().parent.parent / "bugbear.py"
+        proc = subprocess.run(
+            ["flake8", str(filename)],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=60,
+        )
+        self.assertEqual(proc.returncode, 0, proc.stdout.decode("utf8"))
+        self.assertEqual(proc.stdout, b"")
+        self.assertEqual(proc.stderr, b"")
