+try:
+    import mock
+except ImportError:
+    from unittest import mock
+
+
+import globus_sdk
+from tests.framework import (CapturedIOTestCase,
+                             get_client_data, get_user_data,
+                             SDKTESTER1A_NATIVE1_AUTH_RT)
+from globus_sdk.exc import GlobusAPIError
+
+
+class AuthClientTests(CapturedIOTestCase):
+    def setUp(self):
+        """
+        Instantiates an AuthClient with an access_token authorizer
+        """
+        super(AuthClientTests, self).setUp()
+
+        # get access token
+        client_id = get_client_data()["native_app_client1"]["id"]
+        form_data = {'refresh_token': SDKTESTER1A_NATIVE1_AUTH_RT,
+                     'grant_type': 'refresh_token',
+                     'client_id': client_id}
+        token_res = globus_sdk.AuthClient().oauth2_token(form_data)
+        self.access_token = token_res["access_token"]
+
+        # make auth client
+        self.ac = globus_sdk.AuthClient(
+            authorizer=globus_sdk.AccessTokenAuthorizer(self.access_token),
+            client_id=client_id)
+
+    def test_oauth2_prefill_named_grant(self):
+        """
+        Tests setting the prefill_named_grant parameter
+        """
+        # valid
+        self.ac.oauth2_prefill_named_grant('test_label')
+        self.assertEqual(self.ac._params['prefill_named_grant'], 'test_label')
+
+        # empty
+        self.ac.oauth2_prefill_named_grant('')
+        self.assertNotIn('prefill_named_grant', self.ac._params)
+
+        # None
+        self.ac.oauth2_prefill_named_grant(None)
+        self.assertNotIn('prefill_named_grant', self.ac._params)
+
+        # int
+        with self.assertRaises(ValueError):
+            self.ac.oauth2_prefill_named_grant(1)
+
+        # bool
+        with self.assertRaises(ValueError):
+            self.ac.oauth2_prefill_named_grant(True)
+
+        # list
+        with self.assertRaises(ValueError):
+            self.ac.oauth2_prefill_named_grant(['test'])
