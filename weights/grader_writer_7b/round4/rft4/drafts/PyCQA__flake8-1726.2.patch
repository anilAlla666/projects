+"""Unit tests for the FileChecker class."""
+
+
+from __future__ import annotations
+import argparse
+from unittest import mock
+import pytest
+import flake8
+from flake8 import checker
+from flake8._compat import importlib_metadata
+from flake8.plugins import finder
+
+
+def test_sorts_alphabetically_by_filename(tmp_path, default_options):
+    """Test that results are returned in a filename-sorted order."""
+    first_fname = tmp_path.joinpath("a.py")
+    second_fname = tmp_path.joinpath("z.py")
+    first_fname.write_text("")
+    second_fname.write_text("")
+    fchecker = checker.FileChecker(
+        filename=str(first_fname),
+        plugins=finder.Checkers([], [], []),
+        options=default_options,
+    )
+    fchecker.run_checks()
+    fchecker = checker.FileChecker(
+        filename=str(second_fname),
+        plugins=finder.Checkers([], [], []),
+        options=default_options,
+    )
+    fchecker.run_checks()
+    assert fchecker.filename == str(first_fname)
+    fchecker = checker.FileChecker(
+        filename=str(second_fname),
+        plugins=finder.Checkers([], [], []),
+        options=default_options,
+    )
+    fchecker.run_checks()
+    assert fchecker.filename == str(second_fname)
