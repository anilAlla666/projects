+import pytest
+import io
+from compress_pickle.utils import _stringyfy_path, _infer_compression_from_path
+
+
+def test_infer_compression_from_path_io_type():
+    with pytest.raises(
+        TypeError,
+        match=(
+            r"Cannot infer the compression from a path that is not an instance of "
+            r"\('str', 'bytes'\)"
+        ),
+    ):
+        with io.BytesIO() as path:
+            _infer_compression_from_path(path)
+
+
+@pytest.fixture(scope="function")
+def valid_extensions(request):
+    request.cls.valid_extensions = [("gz", "gzip"), ("bz2", "bzip2"), ("xz", "xz")]
+
+
+@pytest.fixture(scope="function")
+def invalid_extensions(request):
+    request.cls.invalid_extensions = "txt"
+
+
+@pytest.fixture(scope="function")
+def wrong_compressions(request):
+    request.cls.wrong_compressions = "abc"
