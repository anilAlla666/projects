+class TestBinaryQuadraticModel(unittest.TestCase):
+    def test_fix_variables(self):
+        bqm = dimod.BinaryQuadraticModel({}, {}, 0.0, dimod.BINARY)
+
+        bqm.fix_variables({'a': 0})
+        self.assertEqual(bqm.linear, {})
+
+        bqm.fix_variables({'a': 1})
+        self.assertEqual(bqm.linear, {})
+
+        bqm.fix_variables({'a': 0, 'b': 1})
+        self.assertEqual(bqm.linear, {})
+
+        bqm = dimod.BinaryQuadraticModel({1: 1, 2: 2}, {(1, 2): 0.5}, 0.5, dimod.SPIN)
+
+        bqm.fix_variables({1: -1, 2: -1})
+        self.assertEqual(bqm.linear, {})
+        self.assertEqual(bqm.quadratic, {})
+        self.assertAlmostEqual(bqm.offset, 2.0)
+
+        bqm = dimod.BinaryQuadraticModel({1: 1, 2: 2}, {(1, 2): 0.5}, 0.5, dimod.SPIN)
+
+        bqm.fix_variables({1: -1, 2: 1})
+        self.assertEqual(bqm.linear, {})
+        self.assertEqual(bqm.quadratic, {})
+        self.assertAlmostEqual(bqm.offset, 2.0)
