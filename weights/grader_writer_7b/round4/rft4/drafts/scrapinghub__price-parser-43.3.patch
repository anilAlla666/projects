--- /dev/null
+++ b/tests/test_parser_grader.py
@@ -0,0 +1,15 @@
+import pytest
+from price_parser import PriceParser
+
+
+def test_parse_euro_with_nbsp():
+    assert PriceParser.parse(u"99\u00a0€") == Price(99, "EUR")
+    assert PriceParser.parse(u"1,\u00a0235\u00a0€") == Price(1235, "EUR")
+    assert PriceParser.parse(u"1,\u00a0235\u00a0€\u00a099") == Price(1235, "EUR")
+
+
+def test_extract_euro_with_nbsp():
+    assert PriceParser.extract(u"99\u00a0€") == u"99"
+    assert PriceParser.extract(u"1,\u00a0235\u00a0€") == u"1,235"
+    assert PriceParser.extract(u"1,\u00a0235\u00a0€\u00a099") == u"1,235"
+    assert PriceParser.extract(u"Foo\u00a01,\u00a0235\u00a0€") == u"1,235"
