+"""
+Test the ``text_to_num`` library.
+"""
+
+
+from unittest import TestCase
+from text_to_num import alpha2digit, text2num
+
+
+class TestTextToNumZH(TestCase):
+    def test_alpha2digit_all_ordinals(self):
+        source = (
+            "第五个第一个第二个第三个二十一个第一百个一百二十三个。"
+        )
+        expected = "第5个 第1个 第2个 第3个 21个 100个 1230个。"
+        self.assertEqual(alpha2digit(source, "zh", ordinal_threshold=0), expected)
+
+    def test_alpha2digit_large_numbers(self):
+        source = "一百亿"
+        expected = "10000000000"
+        self.assertEqual(alpha2digit(source, "zh"), expected)
