+from collections import OrderedDict
+from graphql_relay import to_global_id
+from ...types import ObjectType, Schema, String
+from ..node import Node, is_node
+
+
+class SharedNodeFields(object):
+
+    shared = String()
+    something_else = String()
+
+    def resolve_something_else(*_):
+        return '----'
+
+
+class MyNode(ObjectType):
+
+    class Meta:
+        interfaces = (Node, )
+    name = String()
+
+    @staticmethod
+    def get_node(info, id):
+        return MyNode(name=str(id))
+
+
+class MyOtherNode(SharedNodeFields, ObjectType):
+    extra_field = String()
+
+    class Meta:
+        interfaces = (Node, )
+
+    def resolve_extra_field(self, *_):
+        return 'extra field info.'
+
+    @staticmethod
+    def get_node(info, id):
+        return MyOtherNode(shared=str(id))
+
+schema = Schema(query=ObjectType('RootQuery', {
+    'first': String,
+    'node': Node.Field(),
+    'onlyNode': Node.Field(MyNode),
+    'onlyNodeLazy': Node.Field(lambda: MyNode)
+}))
