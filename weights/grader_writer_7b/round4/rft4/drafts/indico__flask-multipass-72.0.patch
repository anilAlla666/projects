+from importlib.metadata import EntryPoint
+import pytest
+from flask import Flask
+from flask_multipass import Multipass
+from flask_multipass.auth import AuthProvider
+from flask_multipass.core import _MultipassState
+from flask_multipass.exceptions import AuthenticationFailed
+from flask_multipass.identity import IdentityProvider
+from flask_multipass.util import (classproperty, get_state, resolve_provider_type, convert_provider_data, login_view,
+                                  get_canonical_provider_map, validate_provider_map, SupportsMeta, get_provider_base,
+                                  convert_app_data)
+
+
+def test_resolve_provider_type_importlib_metadata(tmp_path):
+    # create a fake entrypoint
+    (tmp_path / 'test').mkdir()
+    with (tmp_path / 'test' / 'test_provider.py').open('w') as f:
+        f.write("""
+from flask_multipass import IdentityProvider
+
+class Test(IdentityProvider):
+    identifier = 'test'
+""")
+    # add the path to sys.path
+    import sys
+    sys.path.append(str(tmp_path))
+
+    # register an entry point
+    entrypoint = EntryPoint(name='test', value='test_provider.Test', group='flask_multipass.identity_providers')
+    with (tmp_path / 'test' / 'entrypoints.txt').open('w') as f:
+        f.write(entrypoint.to_str())
+
+    # check that we can resolve the provider
+    resolve_provider_type(IdentityProvider, 'test')
