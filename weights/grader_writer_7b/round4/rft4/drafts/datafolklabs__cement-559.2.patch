+import os
+from cement.core.foundation import TestApp
+from cement.ext.ext_configparser import ConfigParserConfigHandler
+
+
+def test_getboolean():
+    with TestApp() as app:
+        app.config.set('testapp', 'bool', 'True')
+        assert app.config.getboolean('testapp', 'bool')
+        app.config.set('testapp', 'bool', 'False')
+        assert not app.config.getboolean('testapp', 'bool')
+
+
+def test_getboolean_default():
+    with TestApp() as app:
+        app.config.set('testapp', 'bool', None)
+        assert not app.config.getboolean('testapp', 'bool')
+
+
+def test_getboolean_invalid_value():
+    with TestApp() as app:
+        app.config.set('testapp', 'bool', 'invalid')
+        assert not app.config.getboolean('testapp', 'bool')
+        assert not app.config.getboolean('testapp', 'bool', False)
+        assert app.config.getboolean('testapp', 'bool', True)
+        assert app.config.getboolean('testapp', 'bool', None) is None
