@@ -0,0 +1,22 @@
+import numpy as np
+import pytest
+import pyvista as pv
+
+
+@pytest.fixture
+def tiny_rectilinear():
+    xrng = np.linspace(0, 3, 4)
+    yrng = np.linspace(0, 3, 5)
+    zrng = np.linspace(0, 3, 6)
+    return pv.RectilinearGrid(xrng, yrng, zrng)
+
+
+def test_to_tetrahedral_pass_cell_data(tiny_rectilinear):
+    data = np.random.rand(tiny_rectilinear.n_cells)
+    tiny_rectilinear["data"] = data
+    tet_grid = tiny_rectilinear.to_tetrahedra(pass_cell_data=True)
+    assert "data" in tet_grid.cell_data
+    assert "data" in tiny_rectilinear.cell_data
+    assert np.allclose(data, tet_grid["data"])
+    assert len(tet_grid["data"]) == tiny_rectilinear.n_cells * 12
+    assert len(tet_grid["data"]) == tet_grid.n_cells
