+""""""
+
+
+import dill
+import json
+import nbformat
+import numpy as np
+import os
+import pkg_resources
+import pytest
+import tempfile
+from copy import deepcopy
+from textwrap import dedent
+from pybryt import generate_report, MemoryFootprint, ReferenceImplementation, Value
+from pybryt.execution import execute_notebook
+
+
+def generate_footprint(nb) -> MemoryFootprint:
+    return execute_notebook(nb, "")
+
+
+def generate_reference_notebook():
+    """
+    """
+    nb = nbformat.v4.new_notebook()
+    nb.cells.append(nbformat.v4.new_code_cell(dedent("""\
+        import pybryt
+    """)))
+    nb.cells.append(nbformat.v4.new_code_cell(dedent("""\
+        def median(S):
+            sorted_S = sorted(S) 
+            pybryt.Value(sorted_S, name="sorted", group="median", limit=5, success_message="SUCCESS: Sorted the sample correctly", 
+                        failure_message="ERROR: The sample was not sorted")
+            
+            size_of_set = len(S) 
+            pybryt.Value(size_of_set, name="size", group="median", success_message = "SUCCESS: Computed the size of the sample", 
+                        failure_message="ERROR: Did not capture the size of the set to determine if it is odd or even")
+            
+            middle = size_of_set // 2
+            if size_of_set % 2 == 0:
+                pybryt.Value((sorted_S[middle] + sorted_S[middle - 1]) / 2, name="med_val", group="median", success_message = "SUCCESS: computed the correct median", 
+                            failure_message="ERROR: did not compute the median correctly")
+            else:
+                pybryt.Value(sorted_S[middle], name="med_val", group="median", success_message = "SUCCESS: computed the correct median", 
+                            failure_message="ERROR: did not compute the median correctly")
+                
+            return med_val
+    """)))
+    return nb
+
+
+@pytest.fixture(scope="module")
+def reference_notebook() -> nbformat.NotebookNode:
+    return generate_reference_notebook()
+
+
+@pytest.fixture(scope="module")
+def compiled_notebook(reference_notebook: nbformat.NotebookNode) -> nbformat.NotebookNode:
+    return execute_notebook(reference_notebook, "", compile=True)
+
+
+@pytest.fixture(scope="function")
+def reference_result(compiled_notebook: nbformat.NotebookNode) -> ReferenceImplementation:
+    return ReferenceImplementation(
+        "test-ref",
+        [
+            Value(1, name="val1"),
+            Value(2, name="val2"),
+            Value(3, name="val3"),
+            Value(4, name="val4"),
+            Value(5, name="val5"),
+        ],
+    ).run(generate_footprint(compiled_notebook))
+
+
+def test_limit():
+    foot = MemoryFootprint.from_values(np.array([[1, 2, 3]]))
+    ref = ReferenceImplementation(
+        "foo",
+        [
+            Value(foot.get_value(0), limit=5),
+            Value(foot.get_value(0)),
+            Value(foot.get_value(0)),
+            Value(foot.get_value(0)),
+            Value(foot.get_value(0)),
+            Value(foot.get_value(0)),
+        ],
+    )
+    assert len(ref.annotations) == 5
+    ref.annotations[0].limit = 3
+    assert len(ref.annotations) == 3
