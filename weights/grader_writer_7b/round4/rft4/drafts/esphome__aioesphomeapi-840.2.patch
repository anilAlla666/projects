+@pytest.mark.asyncio
+async def test_api_version_after_connection_closed(
+    api_client: tuple[
+        APIClient, APIConnection, asyncio.Transport, APIPlaintextFrameHelper
+    ],
+) -> None:
+    """Test api version is None after connection close."""
