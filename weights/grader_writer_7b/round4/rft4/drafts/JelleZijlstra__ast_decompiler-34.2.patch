--- /dev/null
+++ b/ast_decompiler/tests/test_ast_decompiler_grader.py
@@ -0,0 +1,21 @@
+import ast
+import unittest
+from ast_decompiler import decompile_to_str
+
+
+class TestDocstrings(unittest.TestCase):
+    maxDiff = None
+
+    def assert_decompiles(self, src, dst, *, indentation=0):
+        tree = ast.parse(src)
+        dec = decompile_to_str(tree, indentation=indentation)
+        self.assertEqual(dec, dst.strip())
+
+    def test_preserve_docstring(self):
+        src = """
+        def a():
+            \"\"\"Docstring.\"\"\"
+            return 1
+        """
+        self.assert_decompiles(src, src)
