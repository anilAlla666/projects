+"""Test runway.module.staticsite.options.components."""
+
+
+from __future__ import annotations
+from pathlib import Path
+from typing import Any, Dict
+import pytest
+from mock import patch
+from runway.module.staticsite.options.components import StaticSiteOptions
+from runway.module.staticsite.options.models import (
+    RunwayStaticSiteModuleOptionsDataModel,
+    RunwayStaticSitePreBuildStepDataModel,
+)
+
+
+MODULE = "runway.module.staticsite.options.components"
+
+
+class TestStaticSiteOptions:
+    """Test StaticSiteOptions."""
+
+    @patch(MODULE + ".StaticSiteOptions.validate_source_hashing", return_value=None)
+    def test_validate_data_model(
+        self, patched_validate_source_hashing: MagicMock, tmp_path: Path
+    ) -> None:
+        """Test validate_data_model."""
+        data = RunwayStaticSiteModuleOptionsDataModel(
+            build_output="./dist",
+            build_steps=[tmp_path.joinpath("build.sh")],
+            extra_files={tmp_path.joinpath(".env"): "."},
+            pre_build_steps=[RunwayStaticSitePreBuildStepDataModel(command="echo hello world")],
+            source_hashing={"method": "sha256", "include": [tmp_path]},
+        )
+        obj = StaticSiteOptions(data=data)
+        obj.validate_data_model()  # don't care about the actual implementation
+        patched_validate_source_hashing.assert_called_once_with(
+            data.source_hashing, data.include_files
+        )
+
+    @staticmethod
+    def _get_test_options(**kwargs: Any) -> Dict[str, Any]:
+        """Return test options."""
+        return {
+            "build_output": kwargs.get("build_output", Path(".")),
+            "build_steps": kwargs.get("build_steps", []),
+            "extra_files": kwargs.get("extra_files", {}),
+            "pre_build_steps": kwargs.get("pre_build_steps", []),
+            "source_hashing": kwargs.get("source_hashing", {}),
+        }
