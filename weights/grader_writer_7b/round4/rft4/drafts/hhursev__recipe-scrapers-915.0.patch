+import unittest
+from recipe_scrapers._utils import get_minutes
+
+
+class TestUtils(unittest.TestCase):
+    def test_get_minutes_handles_pau_pum(self):
+        text = "Pá-Pum"
+        self.assertEqual(None, get_minutes(text))
+
+    def test_get_minutes_handles_unknown_formats(self):
+        text = "unknown format"
+        self.assertEqual(None, get_minutes(text))
+
+    iso8601_fixtures = {
+        "PT1H": 60,
+        "PT20M": 20,
+        "PT2H10M": 130,
+        "PT0H9M30S": 10,
+        "PT1H15M": 75,
+    }
+
+    def test_get_minutes_returns_none_if_no_match(self):
+        self.assertIsNone(get_minutes(""))
