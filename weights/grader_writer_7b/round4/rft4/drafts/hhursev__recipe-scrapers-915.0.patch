+
+    def test_canonical_url(self):
+        self.assertEqual(
+            "https://www.tastykitchen.com/recipes/photos/chicken-salad-bowl-with-tahini-dressing",
+            self.harvester_class.canonical_url(),
+        )
+
+    def test_total_time(self):
+        self.assertEqual(None, self.harvester_class.total_time())
+
+    def test_preparation_time(self):
+        self.assertEqual(20, self.harvester_class.prep_time())
+
+    def test_cooking_time(self):
+        self.assertEqual(25, self.harvester_class.cook_time())
+
+    def test_total_time(self):
+        self.assertEqual(45, self.harvester_class.total_time())
