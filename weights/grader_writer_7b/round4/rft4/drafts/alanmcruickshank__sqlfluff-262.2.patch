+"""The Test file for The New Parser (MatchResult Classes)."""
+
+
+import pytest
+from sqlfluff.parser.match import MatchResult
+from sqlfluff.parser import RawSegment, FilePositionMarker
+
+
+@pytest.fixture(scope="module")
+def raw_seg():
+    """Construct a raw segment as a fixture."""
+    fp = FilePositionMarker.from_fresh().advance_by('abc')
+    return RawSegment('foobar', fp)
+
+
+input_funcs = [
+    lambda x: (x,),               # tuple
+    lambda x: [x],                      # list
+    lambda x: x,                        # segment
+    lambda x: (elem for elem in [x])    # generator
+]
+
+
+def test__parser__match_add_from_empty(raw_seg):
+    """Test construction of MatchResults."""
+    m1 = MatchResult.from_empty()
+    # Test adding
+    m2 = m1 + raw_seg
+    # Check it's a match result
+    assert isinstance(m2, MatchResult)
+    # In all cases, it should also be of length 1
+    assert len(m2) == 1
+
+
+def test__parser__match_add_raises(raw_seg):
