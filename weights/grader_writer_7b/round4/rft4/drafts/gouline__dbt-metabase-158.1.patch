+import logging
+import unittest
+from dbtmetabase.models.interface import DbtInterface
+from dbtmetabase.models.metabase import ModelType, NullValue
+from dbtmetabase.parsers.dbt_folder import (
+    MetabaseModel,
+    MetabaseColumn,
+)
+
+
+class TestDbtFolderReader(unittest.TestCase):
+    def setUp(self):
+        """Must specify dbt root dir"""
+        self.interface = DbtInterface(
+            database="test",
+            schema="public",
+            path="tests/fixtures/sample_project/",
+        )
+        logging.getLogger(__name__)
+        logging.basicConfig(level=logging.DEBUG)
+
+    def test_relationship_outgoing_only(self):
+        """
+        Verifies that when there is an outgoing relationship test, but no incoming relationship test,
+        that the relationship is correctly detected.
+        """
+        models = self.interface.parser.read_models()[0]
+        expectation = [
+            MetabaseModel(
+                name="customers",
+                display_name="clients",
+                schema="PUBLIC",
+                description="This table has basic information about a customer, as well as some derived facts based on a customer's orders",
+                model_type=ModelType.nodes,
+                dbt_name=None,
+                source=None,
+                unique_id=None,
+                columns=[
+                    MetabaseColumn(
+                        name="CUSTOMER_ID",
+                        description="This is a unique identifier for a customer",
+                        meta_fields={},
+                        semantic_type=None,
+                        visibility_type=None,
+                        fk_target_table=None,
+                        fk_target_field=None,
+                    ),
+                    MetabaseColumn(
+                        name="FIRST_NAME",
+                        description="The first name of the customer",
+                        meta_fields={},
+                        semantic_type=None,
+                        visibility_type=None,
+                        fk_target_table=None,
+                        fk_target_field=None,
+                    ),
+                    MetabaseColumn(
+                        name="LAST_NAME",
+                        description="The last name of the customer",
+                        meta_fields={},
+                        semantic_type=None,
+                        visibility_type=None,
+                        fk_target_table=None,
+                        fk_target_field=None,
+                    ),
+                ],
+            ),
+            MetabaseModel(
+                name="orders",
+                display_name="sales",
+                schema="PUBLIC",
+                description="",
+                model_type=ModelType.nodes,
+                dbt_name="orders",
+                source=None,
+                unique_id="model.jaffle_shop.orders",
+                columns=[],
+            ),
+        ]
+        self.assertEqual(models, expectation)
+        logging.info("Done")
